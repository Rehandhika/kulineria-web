---
import { getAllFoods } from '../../../lib/data/loaders';

const foods = getAllFoods();
const regionCount = [...new Set(foods.map(f => f.region))].length;
---

<section class="hero" id="hero-section">
  <div class="hero-bg" aria-hidden="true"></div>

  <svg class="hero-noise-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="hero-noise-fx">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </defs>
    <rect width="100" height="100" filter="url(#hero-noise-fx)" opacity="0.04" style="mix-blend-mode: overlay"/>
  </svg>

  <div class="hero-inner">
    <span class="hero-label">Atlas Kuliner Nusantara</span>

    <h1 class="hero-title">
      <span class="hero-line hero-line-1">
        <span class="hero-word">Cita</span>
        <span class="hero-word">Rasa</span>
      </span>
      <span class="hero-line hero-line-2">
        <span class="hero-word">Nusantara</span>
      </span>
    </h1>

    <p class="hero-subtitle">
      Temukan <strong class="hero-strong">{foods.length}+</strong> hidangan tradisional dari
      <strong class="hero-strong">{regionCount}</strong> wilayah Indonesia
    </p>

    <a href="/jelajahi" class="hero-cta">
      <span>Mulai Jelajahi</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

</section>

<script>
import { gsap } from 'gsap';

function initHero() {
  const hero = document.getElementById('hero-section');
  if (!hero) return;

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.from(hero.querySelector('.hero-label'), { y: -12, opacity: 0, duration: 0.8 })
    .from(hero.querySelectorAll('.hero-word'), {
      y: 64,
      opacity: 0,
      filter: 'blur(10px)',
      stagger: 0.08,
      duration: 1.2,
    }, '-=0.4')
    .from(hero.querySelector('.hero-subtitle'), { y: 20, opacity: 0, duration: 0.8 }, '-=0.6')
    .from(hero.querySelector('.hero-cta'), { y: 20, opacity: 0, scale: 0.95, duration: 0.6 }, '-=0.3')
    .from(hero.querySelector('.hero-bg'), { opacity: 0, duration: 0.6 }, '-=1.2');
}

document.addEventListener('astro:page-load', () => requestAnimationFrame(initHero));
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-8)) var(--page-px) var(--sp-8);
  }
  @media (min-width: 768px) {
    .hero { padding: calc(var(--nav-h) + var(--sp-12)) var(--page-px) var(--sp-12); }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--c-brand-mocha-dark) 0%,
      var(--c-brand-mocha) 40%,
      #6B4A2E 70%,
      var(--c-brand-caramel-dark) 100%
    );
  }

  .hero-noise-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0.8;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 780px;
  }

  .hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-brand-caramel);
    margin-bottom: var(--sp-6);
    opacity: 0.85;
  }

  .hero-title {
    font-family: var(--ff-display);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--sp-5);
  }
  .hero-line { display: block; }
  .hero-line-1 {
    font-size: clamp(2.8rem, 10vw, 6rem);
    margin-bottom: -0.08em;
  }
  .hero-line-2 {
    font-size: clamp(3.2rem, 12vw, 7rem);
  }
  .hero-line-2 .hero-word {
    background: var(--grad-warm);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .hero-word {
    display: inline-block;
    will-change: transform, opacity, filter;
  }

  .hero-subtitle {
    font-family: var(--ff-body);
    font-size: clamp(var(--fs-base), 2vw, var(--fs-lg));
    color: rgba(255, 248, 240, 0.75);
    font-weight: 400;
    line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-8);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-strong {
    font-weight: 700;
    color: var(--c-brand-caramel);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 14px 36px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--c-brand-caramel);
    color: var(--c-brand-cream);
    font-family: var(--ff-body);
    font-size: var(--fs-base);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.35s var(--ease-smooth);
    cursor: pointer;
    will-change: transform;
  }
  .hero-cta svg {
    transition: transform 0.3s var(--ease-smooth);
  }
  .hero-cta:hover {
    background: var(--c-brand-caramel);
    color: var(--c-brand-mocha-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(196, 154, 110, 0.25);
  }
  .hero-cta:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .hero-label { font-size: var(--fs-xs); }
  }
</style>
