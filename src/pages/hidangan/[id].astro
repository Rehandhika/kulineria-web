---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/astro/shared/Footer.astro';
import { getFoodByIdFull, getAllFoods, getRegions, isRealContent } from '../../lib/data/loaders';

import HeroCinematic from '../../components/react/food-detail/HeroCinematic';
import StorySection from '../../components/react/food-detail/StorySection';
import IngredientsGrid from '../../components/react/food-detail/IngredientsGrid';
import RecipeStepper from '../../components/react/food-detail/RecipeStepper';
import NutritionBars from '../../components/react/food-detail/NutritionBars';

export async function getStaticPaths() {
  const foods = getAllFoods();
  return foods.map(food => ({
    params: { id: food.id },
    props: { food },
  }));
}

const { food } = Astro.props;
const fullFood = getFoodByIdFull(food.id);
const regions = getRegions();
const region = regions.find(r => r.id === food.region);
const regionName = region?.name || food.region;
const showStory = fullFood ? isRealContent(fullFood) : false;

// Compute the background of the final rendered section for seamless footer waves
const lastSectionBg = fullFood?.nutrition ? 'surface' : (fullFood?.recipe || fullFood?.ingredients ? 'bg' : (showStory ? 'surface' : 'bg'));
---

<BaseLayout title={food.name} description={food.description}
  seoProps={{
    type: 'recipe',
    keywords: fullFood?.tags || [food.region, ...food.taste],
    recipe: fullFood?.recipe ? {
      name: food.name,
      description: food.description,
      prepTime: fullFood.recipe.prepTime,
      cookTime: fullFood.recipe.cookTime,
      servings: fullFood.recipe.servings,
      category: 'Makanan Utama',
      cuisine: 'Indonesian',
      ingredients: (fullFood.ingredients || []).map(i => `${i.qty || ''} ${i.name}`.trim()),
      image: fullFood.hero?.image,
    } : undefined,
  }}
>

  <!-- SECTION 1: HERO -->
  <HeroCinematic client:visible food={fullFood || food} regionName={regionName} />

  <!-- SECTION 2: CERITA (hanya jika data real) -->
  {showStory && fullFood?.story && (
    <section class="section cerita-section">
      <!-- Batik latar — repeat HD texture -->
      <div class="cerita-batik" aria-hidden="true"></div>

      <!-- Decorative floral watermark -->
      <div class="cerita-motif" aria-hidden="true">
        <img src="/img/motif/png bunga.png" alt="" />
      </div>
      <div class="container">
        <StorySection
          client:visible
          headline={fullFood.story.headline}
          body={fullFood.story.body}
          pullQuote={fullFood.story.pullQuote}
          image={fullFood.imageUrl || fullFood.story.image}
          regionName={regionName}
        />
      </div>
    </section>
  )}

  <!-- SECTION 3: BAHAN & CARA MEMBUAT -->
  {(fullFood?.ingredients && fullFood.ingredients.length > 0) || (fullFood?.recipe && fullFood.recipe.steps.length > 0) ? (
    <section class="section bahan-section">
      <!-- Decorative Cirebon Mega Mendung watermarks -->
      <div class="bahan-motif bahan-motif-tl" aria-hidden="true">
        <img src="/img/motif/png batik mega mendung.png" alt="" />
      </div>
      <div class="bahan-motif bahan-motif-br" aria-hidden="true">
        <img src="/img/motif/png batik mega mendung.png" alt="" />
      </div>

      <div class="container">
        <h2 class="section-title">Bahan &amp; Cara Membuat</h2>
        <div class="bahan-grid">
          {fullFood?.ingredients && fullFood.ingredients.length > 0 && (
            <div class="bahan-subsection">
              <h3 class="subsection-title">Bahan-Bahan</h3>
              <IngredientsGrid client:visible ingredients={fullFood.ingredients} />
            </div>
          )}
          {fullFood?.recipe && fullFood.recipe.steps.length > 0 && (
            <div class="bahan-subsection">
              <h3 class="subsection-title">Langkah-Langkah</h3>
              <RecipeStepper
                client:visible
                steps={fullFood.recipe.steps}
                servings={fullFood.recipe.servings}
              />
            </div>
          )}
        </div>
      </div>
    </section>
  ) : null}

  <!-- SECTION 4: INFORMASI GIZI -->
  {fullFood?.nutrition && (
    <section class="section gizi-section">
      <!-- Batik latar — repeat HD texture -->
      <div class="gizi-batik" aria-hidden="true"></div>

      <div class="container">
        <div class="gizi-card">
          <h2 class="section-title">Informasi Gizi</h2>
          <NutritionBars client:visible nutrition={fullFood.nutrition} />
        </div>
      </div>
    </section>
  )}

  <Footer bg={lastSectionBg} />
</BaseLayout>

<style is:global>
  .section {
    padding: var(--sp-12) 0;
    border-bottom: 1px solid var(--c-border-soft);
  }
  @media (min-width: 768px) {
    .section { padding: var(--sp-16) 0; }
  }
  @media (min-width: 1024px) {
    .section { padding: var(--sp-20) 0; }
  }
  .section:last-of-type {
    border-bottom: none;
  }

  .section-title {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-1);
    margin-bottom: var(--sp-6);
  }
  .subsection-title {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    margin-bottom: var(--sp-4);
    color: var(--c-text-1);
  }
  .bahan-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  @media (min-width: 1024px) {
    .bahan-grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--sp-12);
      align-items: start;
    }
  }
  .bahan-subsection { margin-bottom: 0; }

  /* ── Hero: keyframe-driven, zero delay ──────────────────────────────── */
  @keyframes heroImgReveal {
    from { transform: scale(1.08); opacity: 0; }
    to   { transform: scale(1.02); opacity: 1; }
  }
  @keyframes heroOverlayIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes heroBreadcrumbIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroBadgeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroTitleIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroSubtitleIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroActionsIn {
    from { opacity: 0; transform: scale(0.88); }
    to   { opacity: 1; transform: scale(1); }
  }

  .hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero { min-height: 55vh; }
  }
  @media (min-width: 1024px) {
    .hero { min-height: 60vh; align-items: center; }
  }

  .hero-image {
    position: absolute; inset: 0;
    animation: heroImgReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-img {
    width: 100%; height: 100%; object-fit: cover;
    display: block;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(135deg, rgba(0,0,0,0.55) 0%, transparent 60%),
      linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.4) 45%, rgba(0,0,0,0.1) 100%);
    animation: heroOverlayIn 0.7s ease both;
  }

  .hero-content {
    position: relative; z-index: 1;
    width: 100%; max-width: var(--container-max); margin: 0 auto;
    padding: var(--sp-4) var(--sp-6) var(--sp-6);
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  @media (min-width: 768px) {
    .hero-content { padding: var(--sp-8) var(--sp-10) var(--sp-10); }
  }

  .hero-breadcrumb {
    font-size: var(--fs-xs); font-weight: 600;
    display: flex; align-items: center; gap: var(--sp-2);
    flex-wrap: wrap;
    animation: heroBreadcrumbIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }
  .hero-breadcrumb a { color: rgba(255,248,241,0.7); text-decoration: none; }
  .hero-breadcrumb a:hover { color: var(--c-white); }
  .hero-breadcrumb-sep { color: rgba(255,248,241,0.4); }
  .hero-breadcrumb-current { color: rgba(255,248,241,0.9); font-weight: 700; }
  
  .hero-back-link {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: rgba(255, 248, 241, 0.85);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    background: rgba(255, 248, 241, 0.12);
    border: 1px solid rgba(255, 248, 241, 0.25);
    padding: 6px 14px;
    border-radius: var(--r-full);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all var(--dur-fast) var(--ease-ui);
    width: fit-content;
    animation: heroBreadcrumbIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }
  .hero-back-link:hover {
    color: var(--c-white);
    background: rgba(255, 248, 241, 0.22);
    border-color: rgba(255, 248, 241, 0.45);
    transform: translateX(-3px);
  }
  .hero-back-link svg {
    transition: transform var(--dur-fast) var(--ease-ui);
  }
  .hero-back-link:hover svg {
    transform: translateX(-2px);
  }

  .hero-content-inner { max-width: 700px; }
  .hero-badge {
    display: inline-block; padding: 4px 12px;
    border-radius: var(--r-full); font-size: var(--fs-xs); font-weight: 700;
    color: var(--c-white); text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: var(--sp-2);
    animation: heroBadgeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }
  .hero-title {
    font-family: var(--ff-display);
    font-size: var(--fs-hero); font-weight: 700;
    line-height: var(--lh-tight); color: var(--c-white);
    margin-bottom: var(--sp-2);
    animation: heroTitleIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }
  .hero-subtitle {
    font-size: var(--fs-base); color: rgba(255,248,241,0.8);
    max-width: 550px; line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-3);
    animation: heroSubtitleIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
  }
  .hero-actions {
    display: flex; gap: var(--sp-2);
    animation: heroActionsIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s both;
  }
  .btn-icon {
    width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
    border-radius: 50%; background: rgba(255,248,241,0.2); color: var(--c-white);
    backdrop-filter: blur(8px); transition: all var(--dur-fast) var(--ease-ui);
    border: 1px solid rgba(255,248,241,0.3);
  }
  .btn-icon:hover { background: rgba(255,248,241,0.3); transform: scale(1.1); }

  .gizi-section {
    position: relative;
    overflow: hidden;
    background: var(--c-surface);
    padding-bottom: var(--sp-20);
  }
  @media (min-width: 768px) { .gizi-section { padding-bottom: var(--sp-32); } }
  .gizi-card {
    position: relative;
    z-index: 1;
    padding: var(--sp-6);
    background: var(--c-surface);
    border-radius: var(--r-xl);
    border: 1px solid var(--c-border);
    box-shadow: var(--sh-card);
  }

  .cerita-batik, .gizi-batik {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.22;
    filter: sepia(0.35) saturate(0.5) brightness(0.85);
    background-image: url('/img/motif/png batik.png');
    background-repeat: repeat;
    background-size: 220px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 80px, black calc(100% - 100px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 80px, black calc(100% - 100px), transparent 100%);
  }

  .cerita-section .container, .gizi-section .container, .bahan-section .container {
    position: relative;
    z-index: 1;
  }

  .bahan-section {
    position: relative;
    overflow: hidden;
    background: var(--c-bg);
  }

  /* Cirebon Mega Mendung cloud motifs */
  .bahan-motif {
    position: absolute;
    pointer-events: none;
    z-index: 0;
    opacity: 0.08;
    filter: sepia(1) saturate(0.35) brightness(0.85);
    user-select: none;
  }
  .bahan-motif img {
    display: block;
    width: 100%;
    height: auto;
  }
  .bahan-motif-tl {
    top: -40px;
    left: -60px;
    width: clamp(180px, 25vw, 360px);
    transform: rotate(-10deg);
  }
  .bahan-motif-br {
    bottom: -50px;
    right: -80px;
    width: clamp(220px, 30vw, 420px);
    transform: rotate(15deg) scaleX(-1);
  }

  .cerita-section {
    position: relative;
    background: var(--c-surface);
    overflow: hidden;
  }
  .cerita-motif {
    position: absolute;
    bottom: -30px;
    right: -40px;
    width: clamp(120px, 15vw, 180px);
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
    filter: sepia(1) saturate(0.5) hue-rotate(330deg);
    transform: rotate(-15deg);
    user-select: none;
  }
  .ingredients-list {
    display: flex; flex-direction: column; gap: var(--sp-2);
  }
  .ingredient-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-3);
    border-bottom: 1px solid var(--c-border-soft);
    border-left: 3px solid transparent;
    border-radius: 0 var(--r-md) var(--r-md) 0;
    transition: background-color var(--dur-fast) var(--ease-smooth), transform var(--dur-fast) var(--ease-smooth), border-left-color var(--dur-fast) var(--ease-smooth);
    will-change: transform;
  }
  @media (hover: hover) and (pointer: fine) {
    .ingredient-row:hover {
      background-color: rgba(212, 107, 56, 0.04);
      border-left-color: var(--c-accent);
      transform: translateX(6px);
    }
  }
  .ingredient-row:last-child { border-bottom: none; }
  .ingredient-icon {
    color: var(--c-accent);
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    opacity: 0.85;
    transition: transform var(--dur-fast) var(--ease-smooth);
  }
  .ingredient-row:hover .ingredient-icon {
    transform: rotate(15deg) scale(1.1);
  }
  .ingredient-name {
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--c-text-1);
  }
  .ingredient-qty {
    margin-left: auto;
    font-size: var(--fs-xs);
    color: var(--c-brand-mocha);
    font-weight: 800;
    background: var(--c-surface-2);
    padding: 3px 10px;
    border-radius: var(--r-full);
    border: 1px solid var(--c-border-soft);
  }
  .ingredient-badge {
    padding: 2px 8px; border-radius: var(--r-full);
    background: var(--c-accent-light); color: var(--c-accent);
    font-size: var(--fs-xs); font-weight: 700;
    border: 1px solid var(--c-accent-soft);
  }

  /* ── Recipe Timeline ────────────────────────────────────────────────── */
  .recipe-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .recipe-meta-row {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-brand-mocha);
    background: var(--c-surface-2);
    border: 1px solid var(--c-border-soft);
    border-radius: var(--r-full);
    padding: 5px 12px;
    margin-bottom: var(--sp-5);
    width: fit-content;
  }
  .recipe-steps-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Each row: track + content */
  .recipe-step-item {
    display: flex;
    gap: var(--sp-4);
    align-items: stretch;
    min-height: 64px;
  }

  /* Left column: badge + connector */
  .recipe-step-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 36px;
  }
  .recipe-step-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-surface);
    border: 2px solid var(--c-border-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
    position: relative;
    z-index: 1;
  }
  .recipe-step-badge-num {
    font-size: 13px;
    font-weight: 800;
    color: var(--c-text-2);
    line-height: 1;
    transition: color 0.25s ease;
  }
  .recipe-step-item--open .recipe-step-badge {
    background: var(--c-accent);
    border-color: var(--c-accent);
    box-shadow: 0 0 0 5px rgba(212, 107, 56, 0.15);
    transform: scale(1.08);
  }
  .recipe-step-item--open .recipe-step-badge-num {
    color: var(--c-white);
  }
  @media (hover: hover) and (pointer: fine) {
    .recipe-step-badge:hover {
      border-color: var(--c-accent);
      transform: scale(1.05);
    }
    .recipe-step-badge:hover .recipe-step-badge-num {
      color: var(--c-accent);
    }
    .recipe-step-item--open .recipe-step-badge:hover {
      transform: scale(1.12);
    }
  }

  /* Connector line */
  .recipe-step-connector {
    flex: 1;
    width: 2px;
    background: var(--c-border-soft);
    margin-top: 4px;
    margin-bottom: 0;
    border-radius: 2px;
    min-height: 24px;
    transition: background 0.3s ease;
  }
  .recipe-step-item--open .recipe-step-connector {
    background: linear-gradient(to bottom, var(--c-accent), var(--c-border-soft));
  }

  /* Right column: trigger + body */
  .recipe-step-content {
    flex: 1;
    min-width: 0;
    padding-bottom: var(--sp-4);
  }
  .recipe-step-item--last .recipe-step-content {
    padding-bottom: 0;
  }
  .recipe-step-trigger {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--sp-2) 0;
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    text-align: left;
    border-radius: var(--r-md);
    margin-top: -2px;
  }
  .recipe-step-header-inner {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .recipe-step-label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-3);
    transition: color 0.2s ease;
  }
  .recipe-step-item--open .recipe-step-label {
    color: var(--c-accent);
  }
  .recipe-step-title {
    font-family: var(--ff-display);
    font-size: var(--fs-base);
    font-weight: 800;
    color: var(--c-text-1);
    line-height: 1.3;
    margin: 0;
    transition: color 0.2s ease;
  }
  .recipe-step-item--open .recipe-step-title {
    color: var(--c-accent-dark);
  }
  .recipe-step-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .recipe-step-duration {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 800;
    color: var(--c-brand-mocha);
    background: rgba(139, 94, 60, 0.08);
    border: 1px solid rgba(139, 94, 60, 0.15);
    border-radius: var(--r-full);
    padding: 3px 8px;
    white-space: nowrap;
  }
  .recipe-step-chevron {
    color: var(--c-text-3);
    transition: color 0.25s ease;
  }
  .recipe-step-item--open .recipe-step-chevron {
    color: var(--c-accent);
  }

  /* Expanded body */
  .recipe-step-body {
    margin-top: var(--sp-3);
    border-radius: var(--r-xl);
    background: #FFFBF7;
    border: 1.5px solid rgba(212, 107, 56, 0.18);
    overflow: hidden;
    animation: stepReveal 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    box-shadow: 0 4px 20px -8px rgba(212, 107, 56, 0.12);
  }
  @keyframes stepReveal {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)   scale(1);    }
  }
  .recipe-step-text {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: var(--lh-relaxed);
    padding: var(--sp-4) var(--sp-5);
    margin: 0;
  }

  /* Tip box */
  .recipe-step-tip {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    background: rgba(212, 107, 56, 0.06);
    border-top: 1.5px dashed rgba(212, 107, 56, 0.25);
    padding: var(--sp-3) var(--sp-5);
  }
  .recipe-step-tip-icon {
    display: flex;
    align-items: center;
    color: var(--c-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .recipe-step-tip-text {
    font-size: var(--fs-xs);
    color: var(--c-accent-dark);
    font-weight: 600;
    margin: 0;
    line-height: 1.5;
    font-style: italic;
  }

  .nutrition-bars { padding: var(--sp-2) 0; }
  .nutrition-serving {
    font-size: var(--fs-xs); color: var(--c-text-3);
    margin-bottom: var(--sp-6); font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    display: inline-block;
    padding: 6px 14px;
