---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';

const statusCode = 404;
---

<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan">
  <section class="not-found-page">
    <div class="not-found-content">
      <div class="not-found-nara">
        <svg viewBox="0 0 100 100" class="nara-svg">
          <circle cx="50" cy="50" r="45" fill="var(--c-accent)" opacity="0.1" />
          <circle cx="50" cy="50" r="25" fill="var(--c-surface-1)" stroke="var(--c-accent)" stroke-width="2" />
          <path d="M 30 30 Q 35 25 40 30 M 60 30 Q 65 25 70 30" fill="none" stroke="var(--c-text-1)" stroke-width="2" stroke-linecap="round" />
          <path d="M 35 44 Q 50 38 65 44" fill="none" stroke="var(--c-text-1)" stroke-width="2" stroke-linecap="round" />
          <circle cx="30" cy="40" r="3" fill="var(--c-accent)" opacity="0.3" />
          <circle cx="70" cy="40" r="3" fill="var(--c-accent)" opacity="0.3" />
        </svg>
      </div>

      <span class="status-code">{statusCode}</span>
      <h1>Halaman Tidak Ditemukan</h1>
      <p>Halaman yang Anda cari tidak ditemukan atau telah dipindahkan.</p>

      <form class="search-redirect" action="/jelajahi" method="GET">
        <input type="text" name="q" placeholder="Cari hidangan..." aria-label="Cari hidangan" />
        <button type="submit">Cari</button>
      </form>

      <div class="quick-links">
        <a href="/" class="quick-link">Beranda</a>
        <a href="/jelajahi" class="quick-link">Jelajahi</a>
        <a href="/kuis" class="quick-link">Kuis</a>
        <a href="/tentang" class="quick-link">Tentang</a>
      </div>
    </div>
    <div class="confetti">
      <span class="confetti-piece" style="--delay: 0s; --x: 10%; --color: var(--c-accent);"></span>
      <span class="confetti-piece" style="--delay: 0.8s; --x: 25%; --color: var(--c-warning);"></span>
      <span class="confetti-piece" style="--delay: 1.6s; --x: 40%; --color: var(--c-success);"></span>
      <span class="confetti-piece" style="--delay: 2.4s; --x: 55%; --color: var(--c-accent);"></span>
      <span class="confetti-piece" style="--delay: 3.2s; --x: 70%; --color: var(--c-warning);"></span>
      <span class="confetti-piece" style="--delay: 4s; --x: 85%; --color: var(--c-success);"></span>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .not-found-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-20) var(--sp-4);
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--c-cream) 0%, var(--c-bg) 100%);
  }

  .not-found-content {
    text-align: center;
    max-width: 500px;
    position: relative;
    z-index: 1;
  }

  .not-found-nara {
    margin-bottom: var(--sp-6);
  }

  .nara-svg {
    width: 120px;
    height: 120px;
    margin: 0 auto;
  }

  .status-code {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    font-weight: 700;
    color: var(--c-accent);
    margin-bottom: var(--sp-2);
  }

  .not-found-content h1 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  .not-found-content p {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    margin-bottom: var(--sp-8);
  }

  .search-redirect {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-8);
  }

  .search-redirect input {
    flex: 1;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--c-border);
    border-radius: var(--r-full);
    font-size: var(--fs-base);
    font-family: var(--font-body);
    background: var(--c-surface-1);
    color: var(--c-text-1);
  }

  .search-redirect input:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-alpha);
  }

  .search-redirect button {
    padding: var(--sp-3) var(--sp-6);
    background: var(--c-accent);
    color: var(--c-surface-1);
    border: none;
    border-radius: var(--r-full);
    font-size: var(--fs-base);
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .search-redirect button:hover {
    background: var(--c-accent-hover);
    transform: translateY(-1px);
  }

  .quick-links {
    display: flex;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .quick-link {
    padding: var(--sp-2) var(--sp-4);
    background: var(--c-surface-1);
    border: 1px solid var(--c-border);
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    color: var(--c-text-1);
    font-weight: 500;
    font-family: var(--font-body);
    transition: all 0.2s ease;
  }

  .quick-link:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .confetti-piece {
    position: absolute;
    left: var(--x);
    top: -20px;
    width: 8px;
    height: 8px;
    background: var(--color);
    border-radius: 2px;
    animation: confetti-fall 6s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes confetti-fall {
    0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
    100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
  }

  @media (max-width: 640px) {
    .search-redirect {
      flex-direction: column;
    }
    .search-redirect button {
      width: 100%;
    }
  }
</style>