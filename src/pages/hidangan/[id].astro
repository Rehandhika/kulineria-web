<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initStaggers() {
    // 1. Ingredients rows reveal
    const rows = document.querySelectorAll('.ingredient-row');
    if (rows.length > 0) {
      gsap.fromTo(rows, 
        { opacity: 0, y: 15 },
        { 
          opacity: 1, y: 0, duration: 0.5, stagger: 0.04, ease: 'power2.out',
          scrollTrigger: {
            trigger: '.ingredients-list',
            start: 'top 85%',
            once: true
          }
        }
      );
    }

    // 2. Recipe steps reveal
    const steps = document.querySelectorAll('.recipe-step-item');
    if (steps.length > 0) {
      gsap.fromTo(steps,
        { opacity: 0, x: -10 },
        {
          opacity: 1, x: 0, duration: 0.5, stagger: 0.07, ease: 'power2.out',
          scrollTrigger: {
            trigger: '.recipe-timeline',
            start: 'top 85%',
            once: true
          }
        }
      );
    }
  }

  import { runOnPageReady } from '../../lib/animations/gsap-presets';
  runOnPageReady(initStaggers);
</script>
