0,19],"/img/foods/soto-medan.jpg",{"image":552,"alt":553,"dominantColor":554},"/img/foods/soto-medan-hero.jpg","Soto Medan dengan kuah santan kuning yang kaya","#D4A017",{"headline":556,"body":557,"pullQuote":558,"image":559},"Kuah Kuning Legendaris Medan","Soto Medan adalah kebanggaan kuliner kota Medan. Dengan kuah santan kuning yang kaya rempah, soto ini berbeda dari soto-soto lainnya di Indonesia. Perpaduan antara pengaruh Melayu, Tionghoa, dan India menciptakan cita rasa yang unik.","Setiap mangkuk Soto Medan adalah perjalanan rasa ke jantung Sumatera","/img/foods/soto-medan-story.jpg",[561,562,564,565,566,570],{"name":144,"qty":145,"image":146,"essential":37},{"name":325,"qty":563,"image":327,"essential":37},"200ml",{"name":244,"qty":245,"image":246,"essential":37},{"name":152,"qty":153,"image":154,"essential":37},{"name":567,"qty":568,"image":569,"essential":163},"Kentang","2 buah","/img/ingredients/potato.svg",{"name":571,"qty":572,"image":337,"essential":163},"Telur Rebus","2 butir",{"servings":59,"prepTime":165,"cookTime":512,"difficulty":167,"steps":574},[575,576,578,580,582],{"order":65,"title":170,"text":171,"duration":172},{"order":70,"title":71,"text":577,"duration":82},"Haluskan kunyit, jahe, bawang merah, bawang putih.",{"order":76,"title":497,"text":579,"duration":82},"Tumis bumbu halus hingga harum.",{"order":59,"title":176,"text":581,"duration":73},"Masukkan kaldu dan santan, masak hingga mendidih.",{"order":84,"title":180,"text":583,"duration":166},"Tuang kuah ke mangkuk, tambahkan daging, kentang, telur, dan bawang goreng.",{"manis":90,"pedas":585,"gurih":184,"asam":189,"asin":183},40,{"calories":587,"protein":190,"carbs":188,"fat":588,"fiber":70,"servingSize":589},280,16,"1 mangkuk (350ml)",[591],{"name":592,"city":593,"lat":594,"lng":595,"description":596,"priceRange":597},"Soto Medan Asli","Medan",3.5952,98.6722,"Soto Medan legendaris sejak 1960","Rp 20.000 - 30.000",[599,600],"mie-aceh-033","nasi-padang-004",[602],"Soto Medan menggunakan ku