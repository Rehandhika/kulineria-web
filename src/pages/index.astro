---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';
import HeroSection from '../components/astro/home/HeroSection.astro';
import InteractiveMap from '../components/react/home/InteractiveMap';
import RegionBanner from '../components/react/home/RegionBanner';
import FeaturedFoodsGrid from '../components/react/home/FeaturedFoodsGrid';
import SectionHeader from '../components/astro/shared/SectionHeader.astro';
---

<BaseLayout title="Home" description="Discover the rich flavors of Indonesian cuisine through an interactive exploration of regional specialties">
  <HeroSection />

  <!-- INTERACTIVE MAP -->
  <section class="section-py map-section" id="map-section">
    <div class="container">
      <SectionHeader overline="🗺️ Interaktif" title="Jelajahi Nusantara" />
      <InteractiveMap client:visible />
      <RegionBanner client:idle />
    </div>
  </section>

  <FeaturedFoodsGrid client:visible />
  <Footer />
</BaseLayout>

<style is:global>
  .map-section {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-12);
  }

  @media (min-width: 768px) {
    .map-section {
      padding-top: var(--sp-16);
      padding-bottom: var(--sp-16);
    }
  }

  @media (min-width: 1024px) {
    .map-section {
      padding-top: var(--sp-20);
      padding-bottom: var(--sp-20);
    }
  }

  .interactive-map {
    width: 100%;
  }

  .map-container {
    position: relative;
    background: linear-gradient(155deg, #DBEAFE 0%, #E0F2FE 40%, #F0F9FF 100%);
    border-radius: var(--r-2xl);
    border: var(--duo-stroke) solid var(--duo-stroke-color);
    overflow: hidden;
    width: 100%;
    cursor: pointer;
    box-shadow: 0 5px 0 var(--c-duo-shadow);
    aspect-ratio: 21 / 10;
  }

  @media (min-width: 640px) {
    .map-container {
      aspect-ratio: 21 / 10;
    }
  }

  @media (min-width: 1024px) {
    .map-container {
      aspect-ratio: 24 / 10;
    }
  }

  .map-content-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .map-ocean-bg {
    position: absolute;
    inset: 0;
    background-color: #EDE4D8;
    background-image:
      radial-gradient(ellipse at 20% 30%, rgba(196, 154, 110, 0.25) 0%, transparent 50%),
      radial-gradient(ellipse at 65% 40%, rgba(184, 115, 74, 0.15) 0%, transparent 45%),
      radial-gradient(ellipse at 40% 70%, rgba(212, 167, 106, 0.2) 0%, transparent 40%);
    z-index: 0;
  }

  @media (prefers-color-scheme: dark) {
    .map-ocean-bg {
      background-color: #2E2218;
      background-image:
        radial-gradient(ellipse at 20% 30%, rgba(142, 110, 78, 0.3) 0%, transparent 50%),
        radial-gradient(ellipse at 65% 40%, rgba(160, 100, 62, 0.2) 0%, transparent 45%),
        radial-gradient(ellipse at 40% 70%, rgba(184, 134, 74, 0.2) 0%, transparent 40%);
    }
  }

  .map-region-path {
    position: absolute;
    pointer-events: auto;
    padding: 0;
    border: none;
    background: none;
    outline: none;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                filter 0.4s ease, opacity 0.4s ease;
  }

  .map-region-path:disabled {
    cursor: default;
  }

  .map-region-path:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .map-region-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .map-tooltip {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--c-text-1);
    color: #fff;
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 3px 0 rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 50;
    animation: fadeIn 0.15s ease;
  }

  .map-tooltip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .map-tooltip-count {
    font-weight: 600;
    opacity: 0.7;
    font-size: 0.85em;
  }
</style>
