---
import { getRegions, getAllFoods } from '../../../lib/data/loaders';
const regions = getRegions();
const foods = getAllFoods();
const REGION_EMOJI: Record<string, string> = {
  sumatera: '🌶️', jawa: '🍚', kalimantan: '🌴', sulawesi: '🐟', 'bali-ntt': '🌺', 'maluku-papua': '🐚',
};
const regionImages: Record<string, string> = {
  sumatera: 'https://images.unsplash.com/photo-1590947132387-155cc02f3212?w=400&q=80',
  jawa: 'https://images.unsplash.com/photo-1563379926898-05f4575a45d8?w=400&q=80',
  kalimantan: 'https://images.unsplash.com/photo-1556388158-32c3b2c5b1c8?w=400&q=80',
  sulawesi: 'https://images.unsplash.com/photo-1559847844-5315695dadae?w=400&q=80',
  'bali-ntt': 'https://images.unsplash.com/photo-1539367628448-4bc5c9d171c8?w=400&q=80',
  'maluku-papua': 'https://images.unsplash.com/photo-1559301760-7b1c9f655c15?w=400&q=80',
};
---

<section class="section-py regions" id="regions">
  <div class="container">
    <div class="regions-header">
      <span class="duo-badge duo-badge-gold">🗺️ Wilayah</span>
      <h2 class="regions-title">Jelajahi per Wilayah</h2>
      <p class="regions-subtitle">Pilih wilayah dan mulai petualangan kulinermu</p>
    </div>
    <div class="regions-grid">
      {regions.map((region) => {
        const count = foods.filter(f => f.region === region.id).length;
        return (
          <a
            href={`/search?region=${region.id}`}
            class="region-card"
            style={{ '--card-color': region.color } as any}
          >
            <div class="region-card-bg">
              <img src={regionImages[region.id] || ''} alt="" loading="lazy" />
              <div class="region-card-overlay"></div>
            </div>
            <div class="region-card-content">
              <span class="region-card-emoji">{REGION_EMOJI[region.id] || '🍽️'}</span>
              <h3 class="region-card-name">{region.name}</h3>
              <span class="region-card-count">{count} hidangan</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

function initRegionReveal() {
  const cards = document.querySelectorAll('.region-card');
  if (cards.length === 0) return;

  ScrollTrigger.getAll().forEach(st => {
    if (st.trigger === document.querySelector('.regions-grid')) st.kill();
  });

  gsap.set(cards, { y: 40, opacity: 0, scale: 0.95 });

  ScrollTrigger.create({
    trigger: '.regions-grid',
    start: 'top 85%',
    once: true,
    onEnter: () => {
      gsap.to(cards, {
        y: 0, opacity: 1, scale: 1, duration: 0.6,
        stagger: 0.08, ease: 'back.out(1.6)',
      });
    },
  });

  setTimeout(() => {
    cards.forEach(card => {
      if (window.getComputedStyle(card).opacity === '0') {
        gsap.to(card, { y: 0, opacity: 1, scale: 1, duration: 0.4 });
      }
    });
  }, 4000);
}

document.addEventListener('DOMContentLoaded', () => setTimeout(initRegionReveal, 200));
document.addEventListener('astro:after-swap', () => setTimeout(initRegionReveal, 300));
</script>

<style>
  .regions-header {
    text-align: center;
    margin-bottom: var(--sp-10);
  }
  .regions-title {
    font-family: var(--ff-display);
    font-size: var(--fs-3xl);
    font-weight: 900;
    color: var(--c-text-1);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: var(--sp-3);
  }
  .regions-subtitle {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    margin-top: var(--sp-2);
    font-weight: 600;
  }

  .regions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }
  @media (min-width: 640px) {
    .regions-grid { grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); }
  }
  @media (min-width: 1024px) {
    .regions-grid { grid-template-columns: repeat(6, 1fr); gap: var(--sp-4); }
  }

  .region-card {
    position: relative;
    border-radius: var(--r-2xl);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s var(--ease-bounce);
    border: var(--duo-stroke) solid var(--duo-stroke-color);
    box-shadow: 0 4px 0 var(--c-brand-caramel-bg);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 640px) {
    .region-card { aspect-ratio: auto; min-height: 200px; }
  }
  .region-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 9px 0 var(--c-brand-caramel-bg);
    border-color: var(--card-color);
  }

  .region-card-bg {
    position: absolute;
    inset: 0;
  }
  .region-card-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-bounce);
  }
  .region-card:hover .region-card-bg img {
    transform: scale(1.08);
  }
  .region-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(60, 42, 30, 0.55), rgba(60, 42, 30, 0.30));
    transition: opacity 0.2s ease;
  }
  .region-card:hover .region-card-overlay {
    background: linear-gradient(135deg, rgba(60, 42, 30, 0.45), rgba(60, 42, 30, 0.20));
  }

  .region-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--sp-4);
    text-align: center;
  }

  .region-card-emoji {
    font-size: 40px;
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }
  .region-card-name {
    font-family: var(--ff-display);
    font-size: var(--fs-sm);
    font-weight: 900;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  }
  .region-card-count {
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.85);
    font-weight: 800;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
</style>
