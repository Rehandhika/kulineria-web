<section class="story-scroll" id="cerita">
  <div class="story-scroll-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="story-scroll-inner">

      <div class="story-scene">
        <p class="story-line">Indonesia punya ribuan hidangan</p>
        <p class="story-line">yang tersebar dari Aceh sampai Papua.</p>
        <p class="story-line">Setiap daerah punya <i class="highlight">cerita</i> di balik setiap suapan.</p>
      </div>

      <div class="story-scene">
        <p class="story-line">Tapi banyak resep warisan</p>
        <p class="story-line">yang mulai <i class="highlight">jarang terdengar</i></p>
        <p class="story-line">dan perlahan menghilang.</p>
      </div>

      <div class="story-scene">
        <p class="story-line">Kulineria ada untuk</p>
        <p class="story-line"><i class="highlight">mengumpulkan</i> dan <i class="highlight">merawat</i></p>
        <p class="story-line">semua rasa yang ada.</p>
      </div>

      <div class="story-scene">
        <p class="story-line">Supaya kamu dan generasi setelahnya</p>
        <p class="story-line">bisa terus <i class="highlight">menikmati</i></p>
        <p class="story-line">kekayaan kuliner Nusantara.</p>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initStoryScroll() {
    const container = document.querySelector('.story-scroll');
    const scenes = document.querySelectorAll('.story-scene');
    const bg = document.querySelector('.story-scroll-bg');
    if (!scenes.length || !container) return;

    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.set(scenes, { opacity: 0, y: 30 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: '+=400%', // 4 scenes
          pin: true,
          scrub: 1,
        },
      });

      // Background fade in darker
      tl.to(bg, { opacity: 0.8, duration: 0.5 }, 0);

      scenes.forEach((scene, i) => {
        const startTime = i * 2.5;
        // Fade in
        tl.to(scene, { opacity: 1, y: 0, duration: 1, ease: 'power2.out' }, startTime);
        // Hold
        tl.to(scene, { opacity: 1, duration: 0.5 }, startTime + 1);
        // Fade out
        tl.to(scene, { opacity: 0, y: -30, duration: 1, ease: 'power2.in' }, startTime + 1.5);
      });
    });

    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set(scenes, { opacity: 1, y: 0, position: 'relative', marginBottom: '4rem' });
      gsap.set(bg, { opacity: 0.1 });
    });
  }

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initStoryScroll);
</script>

<style>
  .story-scroll {
    position: relative;
    background: var(--c-bg);
    overflow: hidden;
  }
  
  .story-scroll-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--brown-800, #5A3420) 0%, #17110C 100%);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .story-scroll .container {
    position: relative;
    z-index: 1;
  }

  .story-scroll-inner {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-scene {
    position: absolute;
    width: 100%;
    text-align: center;
    padding: 0 var(--sp-4);
    will-change: transform, opacity;
  }

  .story-line {
    font-family: var(--ff-display);
    font-size: clamp(1.6rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.4;
    color: rgba(255, 248, 240, 0.7);
    margin-bottom: var(--sp-2);
    letter-spacing: -0.01em;
  }

  .story-line .highlight {
    color: var(--c-accent-soft, #F5C4A8);
    font-style: italic;
    font-weight: inherit;
  }

  .story-line:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .story-line {
      font-size: clamp(1.2rem, 5vw, 1.6rem);
      line-height: 1.5;
    }
  }
</style>
