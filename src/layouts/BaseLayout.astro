---
import { ViewTransitions } from 'astro:transitions';
import TopNav from '../components/astro/nav/TopNav.astro';
import SeoMeta from '../components/astro/shared/SeoMeta.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  seoProps?: {
    type?: 'website' | 'article' | 'recipe';
    keywords?: string[];
    recipe?: {
      name: string;
      description: string;
      prepTime: number;
      cookTime: number;
      servings: number;
      category: string;
      cuisine: string;
      ingredients: string[];
      image?: string;
    };
  };
}

const { title, description = 'Kulineria - Atlas Kuliner Indonesia', seoProps = {} } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet" />
    </noscript>

    <SeoMeta title={title} description={description} type={seoProps.type} keywords={seoProps.keywords} recipe={seoProps.recipe} />
    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <TopNav />

    <main id="main-content" transition:animate="none">
      <slot />
    </main>

    <script>
      import { initSmoothScroll, refreshSmoothScroll, destroySmoothScroll } from '../lib/animations/scroll-smoother';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initGlobalSmoothScroll() {
        initSmoothScroll({
          duration: 1.5,
          wheelMultiplier: 1,
          touchMultiplier: 1.5,
        });

        // Refresh ScrollTrigger after Lenis is ready to recalculate positions
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
        });
      }

      document.addEventListener('DOMContentLoaded', initGlobalSmoothScroll);

      document.addEventListener('astro:after-swap', () => {
        destroySmoothScroll();
        setTimeout(() => {
          initGlobalSmoothScroll();
          refreshSmoothScroll();
        }, 150);
      });
    </script>

    <script>
      import { gsap } from 'gsap';

      let magneticCleanups: (() => void)[] = [];

      function initMagneticButtons() {
        magneticCleanups.forEach(fn => fn());
        magneticCleanups = [];

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        const buttons = document.querySelectorAll('[data-magnetic], .duo-btn, .duo-card');
        buttons.forEach((btn) => {
          const el = btn as HTMLElement;
          const onMove = (e: MouseEvent) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            gsap.to(el, {
              x: x * 0.2, y: y * 0.2,
              duration: 0.3, ease: 'power2.out', overwrite: 'auto',
            });
          };
          const onLeave = () => {
            gsap.to(el, {
              x: 0, y: 0,
              duration: 0.5, ease: 'elastic.out(1, 0.4)', overwrite: 'auto',
            });
          };
          el.addEventListener('mousemove', onMove);
          el.addEventListener('mouseleave', onLeave);
          magneticCleanups.push(() => {
            el.removeEventListener('mousemove', onMove);
            el.removeEventListener('mouseleave', onLeave);
          });
        });
      }

      document.addEventListener('click', (e) => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        const target = (e.target as HTMLElement).closest('[data-ripple]');
        if (!target) return;
        const rect = target.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const ripple = document.createElement('span');
        (target as HTMLElement).style.position = 'relative';
        (target as HTMLElement).style.overflow = 'hidden';
        ripple.style.cssText = `position:absolute;left:${x}px;top:${y}px;width:0;height:0;border-radius:50%;background:rgba(255,255,255,0.4);transform:translate(-50%,-50%);pointer-events:none;`;
        target.appendChild(ripple);
        gsap.to(ripple, { width: 200, height: 200, opacity: 0, duration: 0.6, ease: 'power2.out', onComplete: () => ripple.remove() });
      });

      function initMagneticAndTransition() {
        initMagneticButtons();
      }

      document.addEventListener('DOMContentLoaded', initMagneticAndTransition);
      document.addEventListener('astro:after-swap', () => setTimeout(initMagneticAndTransition, 100));
      document.addEventListener('astro:before-swap', () => {
        magneticCleanups.forEach(fn => fn());
        magneticCleanups = [];
      });
    </script>

    <script>
      import { gsap } from 'gsap';

      const TRANSITION_DURATION = 0.35;
      const TRANSITION_EASE = 'power2.inOut';

      function prefersReducedMotion(): boolean {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      let transitionOverlay: HTMLDivElement | null = null;

      function ensureOverlay() {
        if (!transitionOverlay || !document.body.contains(transitionOverlay)) {
          transitionOverlay = document.createElement('div');
          transitionOverlay.id = 'page-transition-overlay';
          transitionOverlay.style.cssText = [
            'position: fixed; inset: 0; z-index: 9999;',
            'pointer-events: none;',
            'background: var(--c-bg, #F8F2EA);',
            'opacity: 0;',
            'will-change: opacity, transform;',
          ].join('');
          document.body.appendChild(transitionOverlay);
        }
      }

      function animatePageOut(): Promise<void> {
        if (prefersReducedMotion()) return Promise.resolve();
        ensureOverlay();
        const main = document.querySelector('#main-content') as HTMLElement;
        return new Promise((resolve) => {
          const tl = gsap.timeline({
            onComplete: resolve,
          });
          if (main) {
            tl.to(main, {
              opacity: 0,
              y: -24,
              duration: TRANSITION_DURATION * 0.7,
              ease: 'power2.in',
            }, 0);
          }
          tl.to(transitionOverlay!, {
            opacity: 1,
            duration: TRANSITION_DURATION * 0.5,
            ease: 'power1.in',
          }, TRANSITION_DURATION * 0.3);
        });
      }

      function animatePageIn(): Promise<void> {
        if (prefersReducedMotion()) {
          if (transitionOverlay) transitionOverlay.style.opacity = '0';
          return Promise.resolve();
        }
        ensureOverlay();
        const main = document.querySelector('#main-content') as HTMLElement;
        return new Promise((resolve) => {
          if (main) {
            gsap.set(main, { opacity: 0, y: 32 });
          }
          const tl = gsap.timeline({ onComplete: resolve });
          tl.to(transitionOverlay!, {
            opacity: 0,
            duration: TRANSITION_DURATION * 0.5,
            ease: 'power1.out',
          }, 0);
          if (main) {
            tl.to(main, {
              opacity: 1,
              y: 0,
              duration: TRANSITION_DURATION * 0.8,
              ease: 'power3.out',
            }, TRANSITION_DURATION * 0.15);
          }
        });
      }

      document.addEventListener('astro:before-swap', () => {
        animatePageOut();
      });

      document.addEventListener('astro:after-swap', () => {
        animatePageIn();
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .skip-link:focus {
    position: absolute;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    top: 1rem;
    left: 1rem;
    z-index: 500;
    background: #fff;
    color: #000;
    border-radius: 0.375rem;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  #page-transition-overlay {
    pointer-events: none;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
    mix-blend-mode: normal;
  }

  html.lenis, html.lenis body { height: auto; }
  html.lenis { overflow: hidden; }
  html.lenis body { overflow: visible; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
  .lenis.lenis-stopped { overflow: hidden; }
  .lenis.lenis-scrolling iframe { pointer-events: none; }
</style>
