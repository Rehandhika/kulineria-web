---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/astro/shared/Divider.astro';
import Footer from '../components/astro/shared/Footer.astro';
import HeroSection from '../components/astro/home/HeroSection.astro';
import FeaturedFoodsSection from '../components/astro/home/FeaturedFoodsSection.astro';
import InteractiveMap from '../components/react/home/InteractiveMap';
import SectionHeader from '../components/astro/shared/SectionHeader.astro';
---

<BaseLayout title="Home" description="Discover the rich flavors of Indonesian cuisine through an interactive exploration of regional specialties">
  <HeroSection />

  <Divider />

  <!-- INTERACTIVE MAP -->
  <section class="section-py map-section" id="map-section">
    <div class="container">
      <SectionHeader overline="🗺️ Interaktif" title="Jelajahi Nusantara" />
      <InteractiveMap client:visible />
    </div>
  </section>

  <Divider />

  <FeaturedFoodsSection />

  <Footer />
</BaseLayout>

<style is:global>
  .map-section {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-12);
  }

  @media (min-width: 768px) {
    .map-section {
      padding-top: var(--sp-16);
      padding-bottom: var(--sp-16);
    }
  }

  @media (min-width: 1024px) {
    .map-section {
      padding-top: var(--sp-20);
      padding-bottom: var(--sp-20);
    }
  }

  .interactive-map {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  @media (min-width: 1024px) {
    .interactive-map {
      flex-direction: row;
      gap: var(--sp-6);
      align-items: flex-start;
    }
  }

  .map-container {
    position: relative;
    background: var(--c-surface);
    border-radius: var(--r-2xl);
    border: var(--duo-stroke) solid var(--duo-stroke-color);
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    cursor: pointer;
    box-shadow: 0 5px 0 var(--c-duo-shadow);
  }

  @media (min-width: 640px) {
    .map-container {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 768px) {
    .map-container {
      aspect-ratio: 2 / 1;
    }
  }

  .map-ocean-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #E0F2FE 0%, #DBEAFE 100%);
    background-image:
      linear-gradient(rgba(148, 196, 232, 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 196, 232, 0.3) 1px, transparent 1px);
    background-size: 8% 8%;
    z-index: 0;
  }

  .map-region-path {
    position: absolute;
    transition: transform 0.4s var(--ease-bounce),
                filter 0.4s ease, opacity 0.4s ease;
    pointer-events: auto;
  }

  .map-region-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .map-tooltip {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--c-text-1);
    color: #fff;
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 3px 0 rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 50;
    animation: fadeIn 0.15s ease;
  }

  .map-tooltip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .map-tooltip-count {
    font-weight: 600;
    opacity: 0.7;
    font-size: 0.85em;
  }

  .map-info-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    width: 100%;
  }

  @media (max-width: 1023px) {
    .map-info-panel {
      max-height: 400px;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  @media (min-width: 1024px) {
    .map-info-panel {
      width: 320px;
      flex-shrink: 0;
    }
  }

  @media (min-width: 1280px) {
    .map-info-panel {
      width: 340px;
    }
  }

  .map-region-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  @media (max-width: 480px) {
    .map-region-buttons {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) {
    .map-region-buttons {
      grid-template-columns: 1fr;
    }
  }

  .map-region-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--r-lg);
    border: 3px solid var(--duo-stroke-color);
    background: var(--c-surface);
    color: var(--c-text-2);
    font-size: var(--fs-sm);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s var(--ease-bounce);
    text-align: left;
    box-shadow: 0 3px 0 var(--c-duo-shadow);
  }

  .map-region-btn:hover {
    border-color: var(--region-color);
    background: color-mix(in srgb, var(--region-color) 8%, transparent);
    color: var(--c-text-1);
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--c-duo-shadow);
  }

  .map-region-btn.active {
    border-color: var(--region-color);
    background: var(--region-color);
    color: var(--c-white);
    box-shadow: 0 4px 0 color-mix(in srgb, var(--region-color) 70%, #000);
  }

  .map-region-btn-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--region-color);
    border: 2px solid var(--duo-stroke-color);
    flex-shrink: 0;
  }

  .map-region-btn.active .map-region-btn-dot {
    background: var(--c-white);
    border-color: var(--c-white);
  }

  .map-region-btn-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .map-region-btn-count {
    font-size: var(--fs-xs);
    color: var(--c-text-3);
    background: var(--c-surface-2);
    padding: 2px 8px;
    border-radius: var(--r-full);
    font-weight: 800;
  }

  .map-region-btn.active .map-region-btn-count {
    background: rgba(255, 255, 255, 0.25);
    color: var(--c-white);
  }

  .map-detail-card {
    background: var(--c-surface);
    border: 3px solid var(--duo-stroke-color);
    border-radius: var(--r-2xl);
    padding: var(--sp-5);
    box-shadow: 0 5px 0 var(--c-duo-shadow);
  }

  .map-detail-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--sp-3);
  }

  .map-detail-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid var(--duo-stroke-color);
    flex-shrink: 0;
  }

  .map-detail-title {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    color: var(--c-text-1);
    line-height: 1.2;
  }

  .map-detail-desc {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    font-weight: 600;
    line-height: 1.65;
    margin-bottom: var(--sp-4);
  }

  .map-detail-stats {
    display: flex;
    gap: var(--sp-5);
    padding: var(--sp-3) 0;
    border-top: 3px solid var(--c-border);
    border-bottom: 3px solid var(--c-border);
    margin-bottom: var(--sp-4);
  }

  .map-detail-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .map-detail-stat-val {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    color: var(--c-text-1);
    line-height: 1;
  }

  .map-detail-stat-label {
    font-size: var(--fs-xs);
    color: var(--c-text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
  }

  .map-explore-btn {
    display: block;
    width: 100%;
    padding: 12px 18px;
    border-radius: var(--r-full);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-align: center;
    cursor: pointer;
    border: 3px solid var(--duo-stroke-color);
    transition: all 0.25s var(--ease-bounce);
    box-shadow: 0 5px 0 var(--c-duo-shadow);
  }

  .map-explore-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  .map-explore-btn:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--c-duo-shadow);
  }

  .map-empty-card {
    padding: var(--sp-8) var(--sp-5);
    border: 3px dashed var(--c-border-strong);
    border-radius: var(--r-2xl);
    text-align: center;
    background: var(--c-surface-2);
  }

  .map-empty-icon {
    font-size: 32px;
    margin-bottom: var(--sp-3);
  }

  .map-empty-card p {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-text-3);
    line-height: 1.6;
    max-width: 240px;
    margin: 0 auto;
  }
</style>
