---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Beranda', key: 'home', emoji: '🏠' },
  { href: '/search', label: 'Jelajahi', key: 'search', emoji: '🔍' },
  { href: '/quiz', label: 'Kuis', key: 'quiz', emoji: '🧠' },
  { href: '/about', label: 'Tentang', key: 'about', emoji: '📖' },
];
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<!-- Mobile top app-bar (visible below 1024px) -->
<header class="duo-mobile-header" role="banner">
  <a href="/" class="duo-mobile-header-logo" aria-label="Kulineria Home">
    Kulineria<span class="logo-dot">.</span>
  </a>
  <button class="duo-mobile-header-search" aria-label="Open search" data-cmd-k>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
  </button>
</header>

<!-- Desktop top nav (visible at 1024px+) -->
<nav class="duo-topnav" role="navigation" aria-label="Main navigation">
  <div class="duo-topnav-inner">
    <a href="/" class="duo-topnav-logo" aria-label="Kulineria Home">
      Kulineria<span class="logo-dot">.</span>
    </a>
    <ul class="duo-topnav-links">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class:list={['duo-topnav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="duo-topnav-emoji">{item.emoji}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <button class="duo-topnav-search" aria-label="Open search" data-cmd-k>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </button>
  </div>
</nav>

<style>
  /* Mobile header */
  .duo-mobile-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: env(safe-area-inset-top, 0);
    height: calc(var(--nav-mobile-h, 56px) + env(safe-area-inset-top, 0));
    padding-left: var(--sp-4);
    padding-right: var(--sp-4);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    border-bottom: 3px solid var(--duo-stroke-color);
  }
  @media (min-width: 1024px) { .duo-mobile-header { display: none; } }

  .duo-mobile-header-logo {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
  }
  .duo-mobile-header-logo .logo-dot { color: var(--c-duo-green); }

  .duo-mobile-header-search {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-lg);
    border: 3px solid var(--duo-stroke-color);
    color: var(--c-text-2);
    box-shadow: 0 3px 0 var(--c-duo-shadow);
  }

  /* Desktop nav */
  .duo-topnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: none;
  }
  @media (min-width: 1024px) { .duo-topnav { display: block; } }

  .duo-topnav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding: 0 var(--sp-8);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 3px solid var(--duo-stroke-color);
  }

  .duo-topnav-logo {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    color: var(--c-text-1);
    letter-spacing: -0.02em;
    transition: transform 0.15s var(--ease-bounce);
  }
  .duo-topnav-logo:hover { transform: scale(1.05); }
  .logo-dot { color: var(--c-duo-green); }

  .duo-topnav-links {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    list-style: none;
  }

  .duo-topnav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    font-weight: 800;
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    border-radius: var(--r-lg);
    border: 3px solid transparent;
    transition: all 0.12s var(--ease-bounce);
  }
  .duo-topnav-emoji { font-size: 16px; }
  .duo-topnav-link:hover {
    background: var(--c-surface-2);
    color: var(--c-text-1);
    transform: translateY(-2px);
  }
  .duo-topnav-link.active {
    background: var(--c-duo-green);
    color: #fff;
    border-color: var(--c-duo-green-dark);
    box-shadow: 0 3px 0 var(--c-duo-green-dark);
  }

  .duo-topnav-search {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-lg);
    border: 3px solid var(--duo-stroke-color);
    color: var(--c-text-2);
    transition: all 0.12s var(--ease-bounce);
    box-shadow: 0 3px 0 var(--c-duo-shadow);
  }
  .duo-topnav-search:hover {
    background: var(--c-surface-2);
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--c-duo-shadow);
  }
</style>
