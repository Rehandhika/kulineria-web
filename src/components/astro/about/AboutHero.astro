---
// Hero section untuk halaman Tentang
---

<section class="about-hero" id="about-hero">
  <div class="about-hero-bg" aria-hidden="true"></div>

  <svg class="about-hero-noise" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="about-noise-fx">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </defs>
    <rect width="100" height="100" filter="url(#about-noise-fx)" opacity="0.04" style="mix-blend-mode: overlay"/>
  </svg>

  <div class="about-hero-inner">
    <span class="about-hero-label">Kisah Kami</span>
    <h1 class="about-hero-title">
      <span class="about-hero-line">Sebuah <span class="about-hero-word italic">perjalanan</span> menelusuri</span>
      <span class="about-hero-line"><span class="about-hero-word italic">jejak rasa</span> Nusantara</span>
    </h1>
    <p class="about-hero-subtitle">
      Kami berlayar melintasi gugusan pulau demi menemukan resep rahasia yang diwariskan dari dapur ke dapur mencatat setiap bumbu dan setiap cerita yang tersembunyi di baliknya.
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initAboutHero() {
    const hero = document.getElementById('about-hero');
    if (!hero || hero.dataset.animated) return;
    hero.dataset.animated = 'true';

    const label = hero.querySelector('.about-hero-label');
    const lines = hero.querySelectorAll('.about-hero-line');
    const subtitle = hero.querySelector('.about-hero-subtitle');
    const bg = hero.querySelector('.about-hero-bg');
    const noise = hero.querySelector('.about-hero-noise');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      gsap.set([label, lines, subtitle, bg, noise], { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' });
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'power2.out', overwrite: 'auto' } });

    tl.fromTo(bg, { scale: 1.05, opacity: 0 }, { scale: 1, opacity: 1, duration: 2.5 }, 0)
      .fromTo(noise, { opacity: 0 }, { opacity: 0.8, duration: 3 }, 0)
      .fromTo(label, { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 1.5 }, 0.5)
      .fromTo(lines, { y: 25, opacity: 0, filter: 'blur(8px)' }, {
        y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', stagger: 0.4, duration: 2
      }, 0.8)
      .fromTo(subtitle, { y: 20, opacity: 0, filter: 'blur(6px)' }, {
        y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', duration: 2
      }, 1.4);
  }

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initAboutHero);
</script>

<style>
  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-8)) var(--page-px) var(--sp-8);
  }
  @media (min-width: 768px) {
    .about-hero { padding: calc(var(--nav-h) + var(--sp-12)) var(--page-px) var(--sp-12); }
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--c-brand-mocha-dark) 0%,
      var(--c-brand-mocha) 35%,
      #6B4A2E 65%,
      var(--c-brand-caramel-dark) 100%
    );
    will-change: transform, opacity;
    opacity: 0;
  }

  .about-hero-noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .about-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
  }

  .about-hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 248, 240, 0.6);
    margin-bottom: var(--sp-6);
    opacity: 0;
    will-change: transform, opacity;
  }

  .about-hero-title {
    font-family: var(--ff-display);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-8);
    color: var(--c-brand-cream);
  }

  .about-hero-line { 
    display: block; 
    font-size: clamp(2.2rem, 5.5vw, 4.5rem);
    will-change: transform, opacity, filter;
    opacity: 0;
  }

  .about-hero-word.italic {
    font-style: italic;
    font-weight: 500;
    color: var(--c-brand-gold);
    padding-right: 0.05em;
  }

  .about-hero-subtitle {
    font-family: var(--ff-body);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--c-brand-caramel);
    font-weight: 400;
    line-height: 1.8;
    margin-bottom: var(--sp-12);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  @media (max-width: 767px) {
    .about-hero-label { font-size: var(--fs-xs); }
    .about-hero-line {
      font-size: clamp(1.6rem, 7vw, 2.2rem);
    }
  }
</style>
