---
/**
 * BottomNav - Mobile navigation (visible < 1024px)
 * Cartoon theme with smooth animations
 * Fixed bottom, safe area padding for notched devices
 */
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home', key: 'home', icon: 'home' },
  { href: '/search', label: 'Explore', key: 'search', icon: 'compass' },
  { href: '/quiz', label: 'Quiz', key: 'quiz', icon: 'help' },
  { href: '/about', label: 'About', key: 'about', icon: 'info' },
];

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}

const icons = {
  home: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/>',
  compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.54 14 12 14.54 14.54 16.24 16.24 7.76"/>',
  help: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
};
---

<nav class="bottom-nav" role="navigation" aria-label="Mobile navigation">
  <div class="nav-inner">
    <ul class="nav-items">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="nav-item-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon as keyof typeof icons]}></svg>
            </span>
            <span class="nav-item-label">{item.label}</span>
            <span class="nav-item-indicator"></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: block;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  @media (min-width: 1024px) {
    .bottom-nav { display: none; }
  }

  .nav-inner {
    background: rgba(255, 248, 240, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--c-border-soft);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
  }

  .nav-items {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    list-style: none;
    height: var(--nav-mobile-h);
  }

  .nav-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    flex: 1;
    color: var(--c-text-3);
    font-size: 10px;
    font-weight: 600;
    transition: all var(--dur-fast) var(--ease-smooth);
    text-decoration: none;
    overflow: hidden;
  }

  .nav-item-icon {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-fast) var(--ease-bounce);
  }

  .nav-item-icon svg {
    transition: all var(--dur-fast) var(--ease-bounce);
  }

  .nav-item-label {
    position: relative;
    z-index: 2;
    transition: color var(--dur-fast) var(--ease-smooth);
  }

  .nav-item-indicator {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 24px;
    height: 3px;
    background: var(--c-accent);
    border-radius: 0 0 var(--r-full) var(--r-full);
    transition: transform var(--dur-base) var(--ease-bounce);
  }

  .nav-item:hover {
    color: var(--c-accent);
  }

  .nav-item:hover .nav-item-icon {
    transform: translateY(-2px);
  }

  .nav-item:hover .nav-item-icon svg {
    transform: scale(1.1);
  }

  .nav-item.active {
    color: var(--c-accent);
  }

  .nav-item.active .nav-item-icon {
    transform: translateY(-2px);
  }

  .nav-item.active .nav-item-icon svg {
    transform: scale(1.15);
    stroke-width: 2.5;
  }

  .nav-item.active .nav-item-indicator {
    transform: translateX(-50%) scaleX(1);
  }
</style>
