---

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: 'website' | 'article' | 'recipe';
  keywords?: string[];
  publishedTime?: string;
  recipe?: {
    name: string;
    description: string;
    prepTime: number;
    cookTime: number;
    servings: number;
    category: string;
    cuisine: string;
    ingredients: string[];
    image?: string;
  };
}

const {
  title,
  description = 'Kulineria - Atlas Kuliner Indonesia.',
  image = 'https://kulineria.id/og-image.jpg',
  url = Astro.url.toString(),
  type = 'website',
  keywords = [],
  publishedTime,
  recipe,
} = Astro.props;

const siteName = 'Kulineria';
const fullTitle = `${title} - ${siteName}`;
const twitterHandle = '@kulineria';

function formatDuration(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return `PT${h > 0 ? h + 'H' : ''}${m > 0 ? m + 'M' : ''}`;
}

const jsonLd = recipe ? {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.name,
  description: recipe.description,
  image: recipe.image || image,
  prepTime: formatDuration(recipe.prepTime),
  cookTime: formatDuration(recipe.cookTime),
  totalTime: formatDuration(recipe.prepTime + recipe.cookTime),
  recipeYield: `${recipe.servings} porsi`,
  recipeCategory: recipe.category,
  recipeCuisine: recipe.cuisine,
  recipeIngredient: recipe.ingredients,
  publisher: { '@type': 'Organization', name: siteName, url: 'https://kulineria.id' },
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
} : {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebPage',
  name: title,
  description,
  url,
  image,
  publisher: { '@type': 'Organization', name: siteName },
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};
---


<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}


<link rel="canonical" href={url} />


<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="id_ID" />


<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={url} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:site" content={twitterHandle} />


<meta name="theme-color" content="#A0522D" />
<meta name="color-scheme" content="light dark" />


<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />