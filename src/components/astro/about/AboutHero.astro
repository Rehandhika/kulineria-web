---
// Hero halaman Tentang — editorial, tipografi sebagai fokus, tanpa motif dekoratif
---

<section class="about-hero" id="about-hero">
  <div class="about-hero-bg" aria-hidden="true"></div>

  <svg class="about-hero-noise" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="about-noise-fx">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </defs>
    <rect width="100" height="100" filter="url(#about-noise-fx)" opacity="0.04" style="mix-blend-mode: overlay"/>
  </svg>

  <div class="about-hero-inner">
    <span class="about-hero-label">Tentang Kulineria</span>
    <h1 class="about-hero-title">
      <span class="about-hero-line">Dari Sabang ke Merauke,</span>
      <span class="about-hero-line">setiap hidangan</span>
      <span class="about-hero-line">menyimpan sebuah cerita.</span>
    </h1>
    <p class="about-hero-subtitle">
      Indonesia dikenal sebagai rumah bagi ribuan hidangan yang lahir dari keberagaman budaya, tradisi, dan kekayaan alam yang tersebar dari Sabang hingga Merauke.
    </p>
  </div>

</section>

<script>
  import { gsap } from 'gsap';

  function initAboutHero() {
    const hero = document.getElementById('about-hero');
    if (!hero || hero.dataset.animated) return;
    hero.dataset.animated = 'true';

    const label = hero.querySelector('.about-hero-label');
    const lines = hero.querySelectorAll('.about-hero-line');
    const subtitle = hero.querySelector('.about-hero-subtitle');
    const bg = hero.querySelector('.about-hero-bg');
    const noise = hero.querySelector('.about-hero-noise');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      gsap.set([label, lines, subtitle, bg, noise], { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' });
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'power2.out', overwrite: 'auto' } });

    tl.fromTo(bg, { scale: 1.05, opacity: 0 }, { scale: 1, opacity: 1, duration: 2.2 }, 0)
      .fromTo(noise, { opacity: 0 }, { opacity: 0.8, duration: 2.8 }, 0)
      .fromTo(label, { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 1.2 }, 0.4)
      .fromTo(lines, { y: 25, opacity: 0, filter: 'blur(8px)' }, {
        y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', stagger: 0.35, duration: 1.6
      }, 0.7)
      .fromTo(subtitle, { y: 20, opacity: 0, filter: 'blur(6px)' }, {
        y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', duration: 1.6
      }, 1.2);
  }

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initAboutHero);
</script>

<style>
  .about-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-6)) var(--page-px) var(--sp-6);
  }
  @media (min-width: 768px) {
    .about-hero { padding: var(--nav-h) var(--page-px) var(--sp-6); }
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      148deg,
      #2A1508 0%,
      #3D2415 32%,
      #5A3420 66%,
      #7A4A2E 100%
    );
    will-change: transform, opacity;
    opacity: 0;
  }

  .about-hero-noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    will-change: opacity;
  }

  .about-hero-inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .about-hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: rgba(255, 248, 240, 0.55);
    margin-bottom: var(--sp-6);
    opacity: 0;
    will-change: transform, opacity;
  }

  .about-hero-title {
    font-family: var(--ff-display);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: var(--sp-6);
    color: #FFF8F1;
  }

  .about-hero-line {
    display: block;
    font-size: clamp(1.8rem, 4.5vw, 3.5rem);
    will-change: transform, opacity, filter;
    opacity: 0;
  }

  .about-hero-subtitle {
    font-family: var(--ff-body);
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    color: rgba(255, 248, 240, 0.7);
    font-weight: 400;
    line-height: 1.75;
    margin-bottom: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  @media (max-width: 767px) {
    .about-hero-label { font-size: var(--fs-xs); }
    .about-hero-line {
      font-size: clamp(1.3rem, 6vw, 1.8rem);
    }
  }
</style>
