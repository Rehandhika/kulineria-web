---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Beranda', key: 'home', emoji: '🏠' },
  { href: '/search', label: 'Jelajahi', key: 'search', emoji: '🔍' },
  { href: '/quiz', label: 'Kuis', key: 'quiz', emoji: '🧠' },
  { href: '/about', label: 'Tentang', key: 'about', emoji: '📖' },
];
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<nav class="duo-bottomnav" role="navigation" aria-label="Mobile navigation">
  <div class="duo-bottomnav-inner">
    <ul class="duo-bottomnav-items">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class:list={['duo-bottomnav-item', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="duo-bottomnav-emoji">{item.emoji}</span>
            <span class="duo-bottomnav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .duo-bottomnav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: block;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  @media (min-width: 1024px) { .duo-bottomnav { display: none; } }

  .duo-bottomnav-inner {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    border-top: 3px solid var(--duo-stroke-color);
    box-shadow: 0 -4px 0 rgba(60, 60, 60, 0.08);
  }

  .duo-bottomnav-items {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    list-style: none;
    height: var(--nav-mobile-h);
    min-height: 56px;
  }

  .duo-bottomnav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex: 1;
    min-width: 64px;
    min-height: 48px;
    color: var(--c-text-3);
    font-size: 11px;
    font-weight: 800;
    transition: all 0.12s var(--ease-bounce);
    position: relative;
    padding-top: 4px;
  }

  .duo-bottomnav-emoji { font-size: 22px; transition: transform 0.12s var(--ease-bounce); }
  .duo-bottomnav-label { letter-spacing: 0.03em; }

  .duo-bottomnav-item.active {
    color: var(--c-duo-green);
  }
  .duo-bottomnav-item.active .duo-bottomnav-emoji {
    transform: scale(1.15);
  }
  .duo-bottomnav-item.active::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 32px;
    height: 3px;
    background: var(--c-duo-green);
    border-radius: 0 0 var(--r-full) var(--r-full);
  }
</style>
