---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/astro/shared/Footer.astro';
import { getFoodByIdFull, getAllFoods, getRegions, isRealContent } from '../../lib/data/loaders';

import HeroCinematic from '../../components/react/food-detail/HeroCinematic';
import StorySection from '../../components/react/food-detail/StorySection';
import IngredientsGrid from '../../components/react/food-detail/IngredientsGrid';
import RecipeStepper from '../../components/react/food-detail/RecipeStepper';
import NutritionBars from '../../components/react/food-detail/NutritionBars';

export async function getStaticPaths() {
  const foods = getAllFoods();
  return foods.map(food => ({
    params: { id: food.id },
    props: { food },
  }));
}

const { food } = Astro.props;
const fullFood = getFoodByIdFull(food.id);
const regions = getRegions();
const region = regions.find(r => r.id === food.region);
const regionName = region?.name || food.region;
const showStory = fullFood ? isRealContent(fullFood) : false;

// Compute the background of the final rendered section for seamless footer waves
const lastSectionBg = fullFood?.nutrition ? 'surface' : (fullFood?.recipe || fullFood?.ingredients ? 'bg' : (showStory ? 'surface' : 'bg'));
---

<BaseLayout title={food.name} description={food.description}
  seoProps={{
    type: 'recipe',
    keywords: fullFood?.tags || [food.region, ...food.taste],
    recipe: fullFood?.recipe ? {
      name: food.name,
      description: food.description,
      prepTime: fullFood.recipe.prepTime,
      cookTime: fullFood.recipe.cookTime,
      servings: fullFood.recipe.servings,
      cuisine: 'Indonesian',
      ingredients: (fullFood.ingredients || []).map(i => `${i.qty || ''} ${i.name}`.trim()),
      image: fullFood.hero?.image,
    } : undefined,
  }}
>

  <!-- SECTION 1: HERO -->
  <HeroCinematic client:visible food={fullFood || food} regionName={regionName} />

  <!-- SECTION 2: CERITA (hanya jika data real) -->
  {showStory && fullFood?.story && (
    <section class="section cerita-section">
      <!-- Decorative floral watermark -->
      <div class="cerita-motif" aria-hidden="true">
        <img src="/img/motif/png bunga.png" alt="" />
      </div>
      <div class="container">
        <StorySection
          client:visible
          headline={fullFood.story.headline}
          body={fullFood.story.body}
          pullQuote={fullFood.story.pullQuote}
          image={fullFood.story.image}
        />
      </div>
    </section>
  )}

  <!-- SECTION 3: BAHAN & CARA MEMBUAT -->
  {(fullFood?.ingredients && fullFood.ingredients.length > 0) || (fullFood?.recipe && fullFood.recipe.steps.length > 0) ? (
    <section class="section bahan-section">
      <div class="container">
        <h2 class="section-title">Bahan &amp; Cara Membuat</h2>
        <div class="bahan-grid">
          {fullFood?.ingredients && fullFood.ingredients.length > 0 && (
            <div class="bahan-subsection">
              <h3 class="subsection-title">Bahan-Bahan</h3>
              <IngredientsGrid client:visible ingredients={fullFood.ingredients} />
            </div>
          )}
          {fullFood?.recipe && fullFood.recipe.steps.length > 0 && (
            <div class="bahan-subsection">
              <h3 class="subsection-title">Langkah-Langkah</h3>
              <RecipeStepper
                client:visible
                steps={fullFood.recipe.steps}
                servings={fullFood.recipe.servings}
              />
            </div>
          )}
        </div>
      </div>
    </section>
  ) : null}

  <!-- SECTION 4: INFORMASI GIZI -->
  {fullFood?.nutrition && (
    <section class="section gizi-section">
      <div class="container">
        <div class="gizi-card">
          <h2 class="section-title">Informasi Gizi</h2>
          <NutritionBars client:visible nutrition={fullFood.nutrition} />
        </div>
      </div>
    </section>
  )}

  <Footer bg={lastSectionBg} />
</BaseLayout>

<style is:global>
  .section {
    padding: var(--sp-12) 0;
    border-bottom: 1px solid var(--c-border-soft);
  }
  @media (min-width: 768px) {
    .section { padding: var(--sp-16) 0; }
  }
  @media (min-width: 1024px) {
    .section { padding: var(--sp-20) 0; }
  }
  .section:last-of-type {
    border-bottom: none;
  }

  .section-title {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-1);
    margin-bottom: var(--sp-6);
  }
  .subsection-title {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    margin-bottom: var(--sp-4);
    color: var(--c-text-1);
  }
  .bahan-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  @media (min-width: 1024px) {
    .bahan-grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--sp-12);
      align-items: start;
    }
  }
  .bahan-subsection { margin-bottom: 0; }

  .hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero { min-height: 55vh; }
  }
  @media (min-width: 1024px) {
    .hero { min-height: 60vh; align-items: center; }
  }
  .hero-image { position: absolute; inset: 0; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.15) 100%);
  }
  .hero-content {
    position: relative; z-index: 1;
    width: 100%; max-width: var(--container-max); margin: 0 auto;
    padding: var(--sp-4) var(--sp-6) var(--sp-6);
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  @media (min-width: 768px) {
    .hero-content { padding: var(--sp-8) var(--sp-10) var(--sp-10); }
  }

  .hero-breadcrumb {
    font-size: var(--fs-xs); font-weight: 600;
    display: flex; align-items: center; gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .hero-breadcrumb a { color: rgba(255,248,241,0.7); text-decoration: none; }
  .hero-breadcrumb a:hover { color: var(--c-white); }
  .hero-breadcrumb-sep { color: rgba(255,248,241,0.4); }
  .hero-breadcrumb-current { color: rgba(255,248,241,0.9); font-weight: 700; }

  .hero-content-inner { max-width: 700px; }
  .hero-badge {
    display: inline-block; padding: 4px 12px;
    border-radius: var(--r-full); font-size: var(--fs-xs); font-weight: 700;
    color: var(--c-white); text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: var(--sp-2);
  }
  .hero-title {
    font-family: var(--ff-display);
    font-size: var(--fs-hero); font-weight: 700;
    line-height: var(--lh-tight); color: var(--c-white);
    margin-bottom: var(--sp-2);
  }
  .hero-subtitle {
    font-size: var(--fs-base); color: rgba(255,248,241,0.8);
    max-width: 550px; line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-3);
  }
  .hero-actions { display: flex; gap: var(--sp-2); }
  .btn-icon {
    width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
    border-radius: 50%; background: rgba(255,248,241,0.2); color: var(--c-white);
    backdrop-filter: blur(8px); transition: all var(--dur-fast) var(--ease-ui);
    border: 1px solid rgba(255,248,241,0.3);
  }
  .btn-icon:hover { background: rgba(255,248,241,0.3); transform: scale(1.1); }
  .hero-skeleton { position: absolute; inset: 0; background: var(--c-surface-2); z-index: 0; }
  .hero-img-skeleton {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent 25%, rgba(255,248,241,0.15) 50%, transparent 75%);
    background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; z-index: 0;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .gizi-section { background: var(--c-surface); }
  .gizi-card {
    padding: var(--sp-6);
    background: var(--c-surface);
    border-radius: var(--r-xl);
    border: 1px solid var(--c-border);
    box-shadow: var(--sh-card);
  }

  .bahan-section { background: var(--c-bg); }
  .cerita-section {
    position: relative;
    background: var(--c-surface);
    overflow: hidden;
  }
  .cerita-motif {
    position: absolute;
    bottom: -30px;
    right: -40px;
    width: clamp(120px, 15vw, 180px);
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
    filter: sepia(1) saturate(0.5) hue-rotate(330deg);
    transform: rotate(-15deg);
    user-select: none;
  }
  .ingredients-list {
    display: flex; flex-direction: column; gap: var(--sp-2);
  }
  .ingredient-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2.5) var(--sp-2);
    border-bottom: 1px solid var(--c-border-soft);
    border-radius: var(--r-sm);
    transition: background-color var(--dur-fast) var(--ease-smooth);
  }
  @media (hover: hover) and (pointer: fine) {
    .ingredient-row:hover {
      background-color: var(--c-surface-2);
    }
  }
  .ingredient-row:last-child { border-bottom: none; }
  .ingredient-bullet {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--c-accent); flex-shrink: 0;
  }
  .ingredient-name { font-weight: 600; font-size: var(--fs-sm); }
  .ingredient-qty {
    margin-left: auto; font-size: var(--fs-xs);
    color: var(--c-text-3); font-weight: 600;
  }
  .ingredient-badge {
    padding: 2px 8px; border-radius: var(--r-full);
    background: var(--c-accent-light); color: var(--c-accent);
    font-size: var(--fs-xs); font-weight: 700;
    border: 1px solid var(--c-accent-soft);
  }

  .recipe-accordion { display: flex; flex-direction: column; gap: var(--sp-2); }
  .recipe-servings { font-size: var(--fs-sm); color: var(--c-text-2); margin-bottom: var(--sp-3); font-weight: 600; }
  .recipe-step {
    border-radius: var(--r-lg);
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    overflow: hidden;
  }
  .recipe-step--open { border-color: var(--c-accent); }
  .recipe-step-header {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    width: 100%; cursor: pointer;
    background: none; border: none;
    font-size: inherit; text-align: left;
    transition: background var(--dur-fast) var(--ease-ui), transform var(--dur-fast) var(--ease-smooth);
    will-change: transform;
  }
  @media (hover: hover) and (pointer: fine) {
    .recipe-step-header:hover { background: var(--c-surface-2); }
  }
  .recipe-step-header:active {
    transform: scale(0.99) !important;
  }
  .recipe-step-number {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--c-text-1); color: var(--c-white);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--fs-xs); font-weight: 700; flex-shrink: 0;
  }
  .recipe-step--open .recipe-step-number { background: var(--c-accent); }
  .recipe-step-title { font-weight: 700; font-size: var(--fs-sm); flex: 1; }
  .recipe-step-duration {
    font-size: var(--fs-xs); color: var(--c-text-3); font-weight: 600;
  }
  .recipe-step-arrow { font-size: 10px; color: var(--c-text-3); }
  .recipe-step-body {
    padding: 0 var(--sp-4) var(--sp-4);
    animation: stepContentSlideDown 0.3s var(--ease-out-expo) both;
  }
  @keyframes stepContentSlideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .recipe-step-text { font-size: var(--fs-sm); color: var(--c-text-2); line-height: var(--lh-relaxed); }
  .recipe-step-tip {
    margin-top: var(--sp-2); font-size: var(--fs-sm); color: var(--c-accent-dark);
    font-weight: 600;
  }

  .nutrition-bars { padding: var(--sp-2) 0; }
  .nutrition-serving {
    font-size: var(--fs-xs); color: var(--c-text-3);
    margin-bottom: var(--sp-6); font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    display: inline-block;
    padding: 6px 14px;
    background: var(--c-surface-2);
    border-radius: var(--r-full);
    border: 1.2px solid var(--c-border);
  }
  .nutrition-bars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }
  @media (min-width: 600px) {
    .nutrition-bars-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }
  @media (min-width: 1024px) {
    .nutrition-bars-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-6);
    }
  }
  .nutrition-item {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    box-shadow: var(--sh-1);
    transition: transform var(--dur-fast) var(--ease-smooth), box-shadow var(--dur-fast) var(--ease-smooth), border-color var(--dur-fast) var(--ease-smooth);
    will-change: transform;
  }
  @media (hover: hover) and (pointer: fine) {
    .nutrition-item:hover {
      transform: translateY(-3px);
      box-shadow: var(--sh-3);
      border-color: var(--c-accent);
    }
  }
  .nutrition-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .nutrition-label {
    font-size: var(--fs-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--c-text-3);
  }
  .nutrition-value {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    color: var(--c-text-1);
  }
  .nutrition-bar-track {
    height: 8px; background: var(--c-surface-2);
    border-radius: var(--r-full); overflow: hidden; border: 1.2px solid var(--c-border-soft);
  }
  .nutrition-bar-fill {
    height: 100%; border-radius: var(--r-full);
    transition: width 1.2s var(--ease-out-expo);
  }

  .story-grid {
    display: grid; grid-template-columns: 1fr; gap: var(--sp-6);
  }
  @media (min-width: 1024px) {
    .story-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-10); }
  }
  .story-image-wrapper {
    overflow: hidden; border-radius: var(--r-xl);
    border: 1px solid var(--c-border);
    box-shadow: var(--sh-card);
  }
  .story-img { width: 100%; height: auto; display: block; }
  .story-headline {
    font-family: var(--ff-display); font-size: var(--fs-xl);
    font-weight: 700; margin-bottom: var(--sp-4);
  }
  .story-text p {
    margin-bottom: var(--sp-3); line-height: var(--lh-relaxed);
    color: var(--c-text-2); font-size: var(--fs-sm);
  }
  .story-quote {
    margin: var(--sp-5) 0; padding: var(--sp-4);
    border-left: 4px solid var(--c-accent);
    background: var(--c-surface-2); border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: var(--fs-base); font-style: italic; color: var(--c-text-1);
  }


</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initStaggers() {
    // 1. Ingredients rows reveal
    const rows = document.querySelectorAll('.ingredient-row');
    if (rows.length > 0) {
      gsap.fromTo(rows, 
        { opacity: 0, y: 15 },
        { 
          opacity: 1, y: 0, duration: 0.5, stagger: 0.04, ease: 'power2.out',
          scrollTrigger: {
            trigger: '.ingredients-list',
            start: 'top 85%',
            once: true
          }
        }
      );
    }

    // 2. Recipe steps reveal
    const steps = document.querySelectorAll('.recipe-step');
    if (steps.length > 0) {
      gsap.fromTo(steps,
        { opacity: 0, y: 20 },
        {
          opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'power2.out',
          scrollTrigger: {
            trigger: '.recipe-accordion',
            start: 'top 85%',
            once: true
          }
        }
      );
    }
  }

  import { runOnPageReady } from '../../lib/animations/gsap-presets';
  runOnPageReady(initStaggers);
</script>
