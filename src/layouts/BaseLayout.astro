---
import TopNav from '../components/astro/nav/TopNav.astro';
import SeoMeta from '../components/astro/shared/SeoMeta.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  seoProps?: {
    type?: 'website' | 'article' | 'recipe';
    keywords?: string[];
    recipe?: {
      name: string;
      description: string;
      prepTime: number;
      cookTime: number;
      servings: number;
      category: string;
      cuisine: string;
      ingredients: string[];
      image?: string;
    };
  };
}

const { title, description = 'Kulineria - Atlas Kuliner Indonesia', seoProps = {} } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800;9..144,900&family=Google+Sans+Flex:opsz,wght@6..144,300..900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800;9..144,900&family=Google+Sans+Flex:opsz,wght@6..144,300..900&display=swap" rel="stylesheet" />
    </noscript>

    <SeoMeta title={title} description={description} type={seoProps.type} keywords={seoProps.keywords} recipe={seoProps.recipe} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <TopNav />

    <main id="main-content">
      <slot />
    </main>

    <!--
      3-layer arc + wave — kontinu tanpa freeze, smooth & slow.

      OUT:  caramel → cinnamon → mocha naik langsung ke gone (sine.inOut).
      IN:   main content fade-up, lalu layer direset ke hidden.
    -->

    <!-- Layer 1: caramel (belakang) -->
    <div class="pt-layer pt-l1" aria-hidden="true">
      <svg class="pt-arc" viewBox="0 0 1200 180" preserveAspectRatio="none">
        <path d="M0,180 C400,100 800,100 1200,180 Z" fill="#E7C49A"/>
      </svg>
      <div class="pt-body"></div>
      <svg class="pt-arc-bottom" viewBox="0 0 1200 80" preserveAspectRatio="none">
        <path d="M0,0 L0,80 C400,0 800,0 1200,80 L1200,0 Z" fill="#E7C49A"/>
      </svg>
    </div>

    <!-- Layer 2: cinnamon (tengah) -->
    <div class="pt-layer pt-l2" aria-hidden="true">
      <svg class="pt-arc" viewBox="0 0 1200 180" preserveAspectRatio="none">
        <path d="M0,180 C400,100 800,100 1200,180 Z" fill="#B36935"/>
      </svg>
      <div class="pt-body"></div>
      <svg class="pt-arc-bottom" viewBox="0 0 1200 80" preserveAspectRatio="none">
        <path d="M0,0 L0,80 C400,0 800,0 1200,80 L1200,0 Z" fill="#B36935"/>
      </svg>
    </div>

    <!-- Layer 3: mocha dark (depan) -->
    <div class="pt-layer pt-l3" aria-hidden="true">
      <svg class="pt-arc" viewBox="0 0 1200 180" preserveAspectRatio="none">
        <path d="M0,180 C400,100 800,100 1200,180 Z" fill="#6A412A"/>
      </svg>
      <div class="pt-body"></div>
      <svg class="pt-arc-bottom" viewBox="0 0 1200 80" preserveAspectRatio="none">
        <path d="M0,0 L0,80 C400,0 800,0 1200,80 L1200,0 Z" fill="#6A412A"/>
      </svg>
    </div>

    <!-- Lenis + Page Animation Orchestrator -->
    <script>
      import { initSmoothScroll, refreshSmoothScroll, destroySmoothScroll } from '../lib/animations/scroll-smoother';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { cleanupAnimations } from '../lib/animations/gsap-presets';

      gsap.registerPlugin(ScrollTrigger);

      function initGlobalSmoothScroll() {
        initSmoothScroll({ duration: 1.5, wheelMultiplier: 1, touchMultiplier: 1.5 });
        requestAnimationFrame(() => ScrollTrigger.refresh());
      }

      document.addEventListener('DOMContentLoaded', initGlobalSmoothScroll);

      /* ─── PAGE ANIMATION ORCHESTRATOR ─────────────────────────────────
       *
       * Arsitektur baru — sinkronisasi deterministik antara layer transisi
       * dan hero entry animation:
       *
       * FASE OUT  (halaman lama):
       *   animation:out:start → cleanup ScrollTrigger/tween konten lama
       *   animation:out:await → layer naik menutup layar (resolve saat selesai)
       *
       * FASE IN  (halaman baru):
       *   animation:in:await  → DOM sudah ter-swap, tunggu 1 rAF agar browser
       *                         paint konten baru, lalu resolve
       *   swup:page:view      → reinit Lenis + ScrollTrigger
       *   layer turun         → BERSAMAAN dispatch 'kulineria:page:ready'
       *   kulineria:page:ready → hero entry animations mulai (sinkron!)
       *
       * Tidak ada setTimeout arbitrary, tidak ada __pageAnimate queue.
       * ────────────────────────────────────────────────────────────────── */


      // swup:page:view tidak lagi dipakai untuk reinit Lenis —
      // reinit dilakukan di animation:in:start (script kedua) agar sinkron
      // dengan dispatch kulineria:page:ready.
      // Dibiarkan kosong tapi tetap ada sebagai safety hook jika diperlukan.
      document.addEventListener('swup:page:view', () => {});
    </script>

    <!-- Arc + Wave: 3-layer via Swup hooks + GSAP -->
    <script>
      import { gsap } from 'gsap';
      import { cleanupAnimations } from '../lib/animations/gsap-presets';
      import { initSmoothScroll, refreshSmoothScroll, destroySmoothScroll } from '../lib/animations/scroll-smoother';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initGlobalSmoothScroll() {
        initSmoothScroll({ duration: 1.5, wheelMultiplier: 1, touchMultiplier: 1.5 });
        requestAnimationFrame(() => ScrollTrigger.refresh());
      }

      const BUFFER = 150;

      const l1 = document.querySelector('.pt-l1')!;
      const l2 = document.querySelector('.pt-l2')!;
      const l3 = document.querySelector('.pt-l3')!;

      function getVH() {
        return (window.visualViewport?.height ?? window.innerHeight) + BUFFER;
      }

      gsap.set([l1, l2, l3], { y: getVH() });

      function dispatchPageReady() {
        (window as any).__kulineriaPageReady = true;
        document.dispatchEvent(new CustomEvent('kulineria:page:ready'));
      }

      function setupSwupHooks() {
        const swup = (window as any).swup;
        if (!swup) return;

        // ── FASE OUT ────────────────────────────────────────────────────
        swup.hooks.on('animation:out:start', () => {
          (window as any).__kulineriaPageReady = false;
          cleanupAnimations();
        });

        swup.hooks.replace('animation:out:await', () =>
          new Promise<void>((resolve) => {
            const vh = getVH();
            const coverY = -200; // Pastikan pt-body (solid) menutupi layar (arc = 180)

            gsap.set([l1, l2, l3], { y: vh });

            // Layer naik dari bawah ke tengah (menutupi layar)
            const tl = gsap.timeline({ onComplete: resolve });
            tl.to(l1, { y: coverY, duration: 0.6, ease: 'power2.in' }, 0);
            tl.to(l2, { y: coverY, duration: 0.6, ease: 'power2.in' }, 0.1);
            tl.to(l3, { y: coverY, duration: 0.6, ease: 'power2.in' }, 0.2);
          })
        );

        // ── FASE IN ─────────────────────────────────────────────────────
        swup.hooks.replace('animation:in:await', () =>
          new Promise<void>((resolve) => {
            const vh = getVH();
            const endY = -(vh + 500); // Pastikan layer benar-benar keluar layar di atas

            // Layer lanjut naik dari tengah ke atas (membuka layar)
            const tl = gsap.timeline({ onComplete: resolve });
            tl.to(l1, { y: endY, duration: 0.6, ease: 'power2.out' }, 0);
            tl.to(l2, { y: endY, duration: 0.6, ease: 'power2.out' }, 0.05);
            tl.to(l3, { y: endY, duration: 0.6, ease: 'power2.out' }, 0.1);
          })
        );

        swup.hooks.on('animation:in:start', () => {
          // Saat ini, layar masih TERUTUP PENUH oleh l3 di posisi coverY.
          // DOM baru sudah diswap. Lakukan re-init Lenis secara sinkron
          // agar siap digunakan ScrollTrigger.
          destroySmoothScroll();
          
          // Reset posisi scroll browser ke atas sebelum smooth scroll di-reinit!
          window.scrollTo(0, 0);
          
          initGlobalSmoothScroll();
          refreshSmoothScroll();

          // Dispatch event agar animasi hero komponen menyiapkan state awalnya
          // (misal: opacity 0) SEBELUM layar mulai dibuka oleh fase IN.
          dispatchPageReady();
        });

      }

      if ((window as any).swup) {
        setupSwupHooks();
      } else {
        document.addEventListener('swup:enable', setupSwupHooks, { once: true });
      }
    </script>


<style is:global>
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .skip-link:focus {
    position: absolute;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    top: 1rem;
    left: 1rem;
    z-index: 500;
    background: var(--c-white);
    color: var(--c-text-1);
    border-radius: 0.375rem;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(106, 65, 42, 0.15);
  }

  /* ─── 3-layer arc + wave transition ─────────────────────────────────────
   *
   * Semua arc = 180px (120px transparent top + 60px filled bottom).
   * Stop positions staggered: l1=-120, l2=-60, l3=0
   * Sehingga di viewport: caramel (0-60), cinnamon (60-120), mocha (120-180).
   *
   * After 180px: mocha body fills rest of viewport (normal).
   * ─────────────────────────────────────────────────────────────────── */

  .pt-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    will-change: transform;
    overflow: hidden;
    transform: translateY(150dvh);
  }

  .pt-l1 { z-index: 9996; height: calc(100dvh + 400px); }
  .pt-l2 { z-index: 9997; height: calc(100dvh + 400px); }
  .pt-l3 { z-index: 9998; height: calc(100dvh + 400px); }

  .pt-layer .pt-arc {
    width: 100%;
    flex-shrink: 0;
    display: block;
    height: 180px;
  }

  .pt-layer .pt-arc-bottom {
    width: 100%;
    flex-shrink: 0;
    display: block;
    height: 80px;
  }

  .pt-layer .pt-body {
    flex: 1;
  }

  /* Warna solid per layer */
  .pt-l1 .pt-body { background: #E7C49A; }
  .pt-l2 .pt-body { background: #B36935; }
  .pt-l3 .pt-body { background: #6A412A; }

  /* ─── Lenis ─────────────────────────────────────────────────────────── */
  html:not(.lenis) { overflow: auto; }
  html:not(.lenis) body { overflow-x: hidden; overflow-y: auto; }
</style>
</body>
</html>
