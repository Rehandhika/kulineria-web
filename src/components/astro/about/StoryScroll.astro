<section class="story-scroll" id="cerita">
  <div class="story-scroll-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="story-scroll-inner">

      <div class="story-scene">
        <p class="story-line story-line--heading">Di balik setiap hidangan terdapat cerita.</p>
        <p class="story-line story-line--body">Cerita tentang masyarakat yang menciptakannya, tradisi yang menjaganya, serta nilai budaya yang diwariskan dari generasi ke generasi.</p>
      </div>

      <div class="story-scene">
        <p class="story-line story-line--heading">Namun, tidak semua warisan kuliner terdokumentasikan dengan baik.</p>
        <p class="story-line story-line--body">Seiring perkembangan zaman, banyak resep dan cerita di baliknya yang mulai jarang dikenal oleh generasi muda.</p>
      </div>

      <div class="story-scene">
        <p class="story-line story-line--heading">Kulineria hadir sebagai ruang untuk melestarikan kekayaan kuliner Nusantara.</p>
        <p class="story-line story-line--body">Menghubungkan masyarakat dengan ragam hidangan Indonesia melalui informasi, cerita, dan nilai budaya yang menyertainya.</p>
      </div>

      <div class="story-scene">
        <p class="story-line story-line--heading">Karena kuliner bukan hanya tentang rasa.</p>
        <p class="story-line story-line--body">Kuliner adalah bagian dari identitas, sejarah, dan warisan budaya yang membentuk Indonesia.</p>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initStoryScroll() {
    const container = document.querySelector('.story-scroll');
    const scenes = document.querySelectorAll('.story-scene');
    const bg = document.querySelector('.story-scroll-bg');
    if (!scenes.length || !container) return;

    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.set(scenes, { opacity: 0, y: 30 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: '+=400%', // 4 scenes
          pin: true,
          scrub: 1,
        },
      });

      // Glow accent menyala lembut saat scroll
      tl.to(bg, { opacity: 1, duration: 0.5 }, 0);

      scenes.forEach((scene, i) => {
        const startTime = i * 2.5;
        // Fade in
        tl.to(scene, { opacity: 1, y: 0, duration: 1, ease: 'power2.out' }, startTime);
        // Hold
        tl.to(scene, { opacity: 1, duration: 0.5 }, startTime + 1);
        // Fade out
        tl.to(scene, { opacity: 0, y: -30, duration: 1, ease: 'power2.in' }, startTime + 1.5);
      });
    });

    mm.add('(prefers-reduced-motion: reduce)', () => {
      // Tampilkan semua scene sebagai stack vertikal yang terbaca
      gsap.set(scenes, { opacity: 1, y: 0, position: 'relative', marginBottom: '3rem' });
      gsap.set(bg, { opacity: 1 });
    });
  }

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initStoryScroll);
</script>

<style>
  .story-scroll {
    position: relative;
    /* Selalu gelap — menyatu dari hero, teks cream selalu terbaca */
    background: linear-gradient(180deg, #1C1109 0%, #2A1810 50%, #1C1109 100%);
    overflow: hidden;
  }

  .story-scroll-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% 50%, rgba(194, 65, 12, 0.12) 0%, transparent 70%);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .story-scroll .container {
    position: relative;
    z-index: 1;
  }

  .story-scroll-inner {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Reduced-motion: scene jadi stack vertikal, bukan 100vh terkunci */
  @media (prefers-reduced-motion: reduce) {
    .story-scroll-inner {
      height: auto;
      flex-direction: column;
      padding-block: clamp(64px, 12vw, 140px);
    }
    .story-scene {
      position: relative !important;
    }
  }

  .story-scene {
    position: absolute;
    width: 100%;
    text-align: center;
    padding: 0 var(--sp-4);
    will-change: transform, opacity;
    opacity: 0;
  }

  .story-line {
    font-family: var(--ff-display);
    font-size: clamp(1.6rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.4;
    color: rgba(255, 248, 240, 0.7);
    margin-bottom: var(--sp-2);
    letter-spacing: -0.01em;
  }

  .story-line .highlight {
    color: var(--c-accent-soft, #F5C4A8);
    font-style: italic;
    font-weight: inherit;
  }

  .story-line:last-child {
    margin-bottom: 0;
  }

  /* Heading line: the bold statement of each scene. */
  .story-line--heading {
    color: var(--c-accent-soft, #F5C4A8);
    font-style: italic;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--sp-5);
  }

  /* Body line: the explanatory paragraph under each heading. */
  .story-line--body {
    font-family: var(--ff-body);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    font-weight: 400;
    font-style: normal;
    line-height: 1.7;
    color: rgba(255, 248, 240, 0.72);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: 0;
  }

  @media (max-width: 767px) {
    .story-line {
      font-size: clamp(1.2rem, 5vw, 1.6rem);
      line-height: 1.5;
    }
    .story-line--heading {
      font-size: clamp(1.3rem, 5.5vw, 1.7rem);
      margin-bottom: var(--sp-4);
    }
    .story-line--body {
      font-size: 0.92rem;
      line-height: 1.65;
    }
  }
</style>
