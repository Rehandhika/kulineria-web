---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Beranda', key: 'home' },
  { href: '/jelajahi', label: 'Jelajahi', key: 'jelajahi' },
  { href: '/kuis', label: 'Kuis', key: 'kuis' },
  { href: '/tentang', label: 'Tentang', key: 'tentang' },
];
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header class="top-nav" id="top-nav" role="banner">
  <div class="top-nav-bar">
    <div class="top-nav-inner">
      <a href="/" class="top-nav-logo" aria-label="Kulineria Home">
        <span class="top-nav-logo-text">Kulineria</span>
      </a>

      <div class="top-nav-actions">
        <button
          class="top-nav-menu-toggle"
          aria-label="Buka menu"
          aria-expanded="false"
          aria-controls="top-nav-overlay"
          aria-haspopup="menu"
          data-menu-toggle
        >
          <span class="menu-toggle-label" data-menu-label>MENU</span>
          <span class="menu-toggle-icon" aria-hidden="true">
            <svg class="icon-hamburger" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="13" x2="20" y2="13" />
              <line x1="4" y1="19" x2="20" y2="19" />
            </svg>
            <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              <line x1="6" y1="6" x2="18" y2="18" />
              <line x1="18" y1="6" x2="6" y2="18" />
            </svg>
          </span>
        </button>

        <!-- Floating menu overlay (anchored to actions group so its right edge aligns with the toggle's right edge) -->
        <div
          class="menu-overlay"
          id="top-nav-overlay"
          data-menu-overlay
          role="dialog"
          aria-modal="true"
          aria-label="Menu navigasi"
          inert
        >
          <nav class="overlay-nav" aria-label="Menu utama">
            {navItems.map((item, idx) => (
              <a
                href={item.href}
                class:list={['overlay-link', { active: isActive(item.href) }]}
                style={`--idx: ${idx}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-overlay-link
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Page dim / wash -->
  <div class="page-dim" data-page-dim aria-hidden="true"></div>
</header>

<script>
import { gsap } from 'gsap';

function initNav() {
  const header = document.getElementById('top-nav');
  const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
  const dim = document.querySelector<HTMLElement>('[data-page-dim]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-menu-label]');
  const body = document.body;
  if (!header || !overlay || !dim || !toggle || !toggleLabel) return;

  let state: 'open' | 'closed' = 'closed';
  let openTl: gsap.core.Timeline | null = null;
  let closeTl: gsap.core.Timeline | null = null;
  let prevOverflow = '';

  const reduceMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

  function setToggleVisuals(open: boolean) {
    toggle!.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle!.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    toggleLabel!.textContent = open ? 'CLOSE' : 'MENU';
    toggle!.classList.toggle('is-open', open);
  }

  function openMenu() {
    if (state === 'open') return;
    state = 'open';

    if (closeTl) { closeTl.kill(); closeTl = null; }

    overlay!.removeAttribute('inert');
    dim!.classList.add('is-visible');
    overlay!.classList.add('is-open');
    setToggleVisuals(true);

    prevOverflow = body.style.overflow;
    body.style.overflow = 'hidden';

    if (reduceMotion()) {
      gsap.set(overlay, { opacity: 1, scale: 1, y: 0, clearProps: 'transform' });
      gsap.set(overlay!.querySelectorAll('.overlay-link'), { opacity: 1, y: 0 });
      requestAnimationFrame(() => {
        const first = overlay!.querySelector<HTMLElement>('.overlay-link');
        first?.focus();
      });
      return;
    }

    const desktop = isDesktop();
    openTl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      onComplete: () => {
        const first = overlay!.querySelector<HTMLElement>('.overlay-link');
        first?.focus();
      },
    });

    gsap.set(dim, { opacity: 0 });
    openTl.to(dim, { opacity: 1, duration: 0.25, ease: 'power2.out' }, 0);

    if (desktop) {
      openTl.fromTo(
        overlay,
        { opacity: 0, scale: 0.92, y: 0, transformOrigin: 'top right' },
        { opacity: 1, scale: 1, duration: 0.35 },
        0
      );
    } else {
      openTl.fromTo(
        overlay,
        { opacity: 0, y: -16 },
        { opacity: 1, y: 0, duration: 0.35 },
        0
      );
    }

    openTl.fromTo(
      overlay!.querySelectorAll('.overlay-link'),
      { opacity: 0, y: 12 },
      { opacity: 1, y: 0, duration: 0.32, stagger: 0.05 },
      0.12
    );
  }

  function closeMenu(opts: { restoreFocus?: boolean } = {}) {
    if (state === 'closed') return;
    state = 'closed';

    if (openTl) { openTl.kill(); openTl = null; }

    setToggleVisuals(false);

    const finalize = () => {
      overlay!.classList.remove('is-open');
      overlay!.setAttribute('inert', '');
      dim!.classList.remove('is-visible');
      body.style.overflow = prevOverflow || '';
      if (opts.restoreFocus !== false) toggle!.focus();
    };

    if (reduceMotion()) {
      gsap.set(overlay, { opacity: 0 });
      gsap.set(dim, { opacity: 0 });
      finalize();
      return;
    }

    closeTl = gsap.timeline({ onComplete: finalize });
    closeTl.to(overlay, { opacity: 0, duration: 0.2, ease: 'power2.in' }, 0);
    closeTl.to(dim, { opacity: 0, duration: 0.2, ease: 'power2.in' }, 0);
  }

  // ── Update active link berdasarkan URL saat ini ──────────────────────
  function updateActiveLinks() {
    const path = window.location.pathname;
    overlay!.querySelectorAll<HTMLAnchorElement>('.overlay-link').forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      const active = href === '/' ? path === '/' : path.startsWith(href);
      link.classList.toggle('active', active);
      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  // Jalankan sekali saat init
  updateActiveLinks();

  toggle.addEventListener('click', () => {
    state === 'open' ? closeMenu() : openMenu();
  });

  dim.addEventListener('click', () => closeMenu());

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && state === 'open') closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || state !== 'open') return;
    const focusables = [
      ...Array.from(overlay!.querySelectorAll<HTMLElement>('.overlay-link')),
      toggle!,
    ];
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    } else if (active && !focusables.includes(active)) {
      e.preventDefault();
      first.focus();
    }
  });

  overlay.querySelectorAll<HTMLAnchorElement>('.overlay-link').forEach((link) => {
    link.addEventListener('click', () => closeMenu({ restoreFocus: false }));
  });

  // ── Swup: tutup menu + update active saat navigasi selesai ──────────
  // 'swup:page:view' = konten baru sudah visible, URL sudah berubah
  document.addEventListener('swup:page:view', () => {
    closeMenu({ restoreFocus: false });
    body.style.overflow = '';
    updateActiveLinks();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') body.style.overflow = '';
  });

  function onScroll() {
    const scrolled = window.scrollY > 30;
    header!.classList.toggle('is-scrolled', scrolled);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

// Jalankan sekali saat DOMContentLoaded — Swup tidak mengganti <header>
// sehingga initNav tidak perlu dipanggil ulang setiap navigasi.
// Event listener tidak menumpuk karena hanya dipanggil sekali.
document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(initNav));
</script>

<style>
  .top-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top, 0);
    font-family: var(--ff-ui-system);
    color: var(--c-brand-cream);
  }

  /* === BAR === */
  /* Default: transparent over hero so the hero stays untouched. */
  .top-nav-bar {
    position: relative;
    z-index: 2;
    background: transparent;
    transition: background 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
  }
  /* Scrolled: cream solid surface + soft shadow */
  .top-nav.is-scrolled .top-nav-bar {
    background: var(--c-cream-bar);
    box-shadow: 0 4px 16px rgba(60, 42, 30, 0.10);
    color: var(--c-ink);
  }

  .top-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    height: var(--nav-mobile-h);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }
  @media (min-width: 1024px) {
    .top-nav-inner {
      height: var(--nav-h);
      padding: 0 var(--sp-10);
    }
  }

  /* === LOGO === */
  .top-nav-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.18s var(--ease-bounce);
  }
  .top-nav-logo:hover { transform: scale(1.04); }
  .top-nav-logo:active { transform: scale(0.98); }

  .top-nav-logo-text {
    font-family: var(--ff-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    line-height: 1;
    letter-spacing: 0;
    color: var(--c-brand-cream);
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 50;
    transition: color 0.3s ease;
  }
  /* On scrolled cream bar, the logo turns warm cinnamon for contrast */
  .top-nav.is-scrolled .top-nav-logo-text {
    color: var(--c-brand-cinnamon-dark);
  }

  /* === ACTIONS GROUP (anchor for the floating menu) === */
  .top-nav-actions {
    position: relative; /* anchor for .menu-overlay so its right edge aligns with the toggle */
    display: inline-flex;
    align-items: center;
  }

  /* === MENU TOGGLE PILL === */
  .top-nav-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    min-width: 44px;
    padding: 0 16px;
    border-radius: var(--r-full);
    background: rgba(255, 248, 240, 0.10);
    color: var(--c-brand-cream);
    border: 1.5px solid rgba(255, 248, 240, 0.55);
    font-family: var(--ff-ui-system);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease,
                transform 0.15s var(--ease-bounce);
  }
  .top-nav-menu-toggle:hover {
    background: rgba(255, 248, 240, 0.20);
    border-color: rgba(255, 248, 240, 0.85);
    transform: translateY(-1px);
  }
  .top-nav-menu-toggle:active {
    transform: translateY(2px);
  }
  /* On cream bar, toggle becomes ink-on-cream */
  .top-nav.is-scrolled .top-nav-menu-toggle {
    background: var(--c-cream-bar);
    color: var(--c-ink);
    border-color: var(--duo-stroke-color);
  }
  .top-nav.is-scrolled .top-nav-menu-toggle:hover {
    background: var(--c-cream-bar-2);
    border-color: var(--duo-stroke-color);
  }
  /* When OPEN: morph into accent pill (warm cinnamon) */
  .top-nav-menu-toggle.is-open {
    background: var(--c-nav-accent);
    color: var(--c-brand-cream);
    border-color: var(--c-nav-accent-dark);
  }
  .top-nav-menu-toggle.is-open:hover {
    background: var(--c-nav-accent-hover);
  }
  @media (min-width: 1024px) {
    .top-nav-menu-toggle {
      height: 42px;
      padding: 0 20px;
      font-size: 14px;
    }
  }

  .menu-toggle-label {
    line-height: 1;
  }
  .menu-toggle-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    position: relative;
    color: currentColor;
  }
  .menu-toggle-icon svg {
    position: absolute;
    inset: 0;
    transition: opacity 0.18s ease, transform 0.18s var(--ease-bounce);
  }
  .icon-close { opacity: 0; transform: rotate(-90deg); }
  .top-nav-menu-toggle.is-open .icon-hamburger {
    opacity: 0;
    transform: rotate(90deg);
  }
  .top-nav-menu-toggle.is-open .icon-close {
    opacity: 1;
    transform: rotate(0);
  }

  /* === PAGE DIM === */
  .page-dim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--c-page-dim);
    backdrop-filter: blur(10px) saturate(110%);
    -webkit-backdrop-filter: blur(10px) saturate(110%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .page-dim.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* === FLOATING MENU CARD ===
     Positioned absolutely inside .top-nav-actions so its right edge
     always aligns exactly with the right edge of the MENU toggle. */
  .menu-overlay {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;          /* sejajar dengan sisi kanan tombol MENU */
    left: auto;
    z-index: var(--z-overlay);
    width: 320px;
    max-width: min(86vw, 380px);
    padding: 24px 28px;
    background: var(--c-overlay-surface);
    color: var(--c-overlay-link);
    border-radius: 24px;
    border: 1px solid rgba(255, 248, 240, 0.08);
    box-shadow:
      0 6px 0 var(--c-overlay-surface-dark),
      0 22px 50px rgba(20, 12, 6, 0.35);
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 0.3s;
  }
  .menu-overlay.is-open {
    pointer-events: auto;
    visibility: visible;
    transition: visibility 0s linear 0s;
  }
  @media (min-width: 1024px) {
    .menu-overlay {
      top: calc(100% + 14px);
      width: 340px;
      padding: 28px 34px;
      border-radius: 28px;
    }
  }
  /* On very narrow phones the actions group can sit close to the right edge,
     give the floating card a small viewport-edge guard so it never clips. */
  @media (max-width: 380px) {
    .menu-overlay {
      width: calc(100vw - 32px);
      max-width: calc(100vw - 32px);
    }
  }

  /* === OVERLAY LINKS === */
  .overlay-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .overlay-link {
    display: inline-block;
    color: var(--c-overlay-link);
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4.8vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: 0;
    text-decoration: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 50;
    transition: color 0.18s ease, transform 0.18s var(--ease-bounce);
  }
  .overlay-link:hover {
    color: var(--c-brand-caramel);
    transform: translateX(3px);
  }
  .overlay-link.active {
    color: var(--c-brand-caramel);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .top-nav-bar,
    .top-nav-menu-toggle,
    .top-nav-logo,
    .top-nav-logo-text,
    .menu-overlay,
    .overlay-link,
    .page-dim,
    .menu-toggle-icon svg {
      transition-duration: 1ms !important;
    }
  }
</style>
