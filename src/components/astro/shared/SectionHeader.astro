---
interface Props {
  overline?: string;
  title: string;
  subtitle?: string;
  level?: 'h1' | 'h2' | 'h3';
  color?: 'green' | 'blue' | 'yellow' | 'red' | 'purple' | 'orange';
}
const { overline, title, subtitle, level = 'h2', color = 'green' } = Astro.props;
const Tag = level;
const emojiMap: Record<string, string> = {
  green: '🟢', blue: '🔵', yellow: '🟡', red: '🔴', purple: '🟣', orange: '🟠',
};
---

<div class="duo-section-header">
  {overline && (
    <div class="duo-section-overline">
      <span class:list={[`duo-badge`, `duo-badge-${color}`]}>{emojiMap[color]} {overline}</span>
    </div>
  )}
  <Tag class="duo-section-title">{title}</Tag>
  {subtitle && <p class="duo-section-subtitle">{subtitle}</p>}
</div>
