---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchHero from '../components/astro/search/SearchHero.astro';
import SearchProvider from '../components/react/search/SearchProvider';
import Footer from '../components/astro/shared/Footer.astro';
import { getAllFoods } from '../lib/data/loaders';
const allFoods = getAllFoods();
---

<BaseLayout title="Jelajahi" description="Cari dan temukan hidangan Nusantara berdasarkan wilayah, rasa, dan jenis">
  <SearchHero />

  <main class="container jelajahi-main">
    <SearchProvider client:load initialFoods={JSON.stringify(allFoods.slice(0, 12))} />
  </main>

  <style>
    /* Extra bottom padding so FAB doesn't overlap last card row */
    .jelajahi-main {
      padding-top: var(--sp-8);
      padding-bottom: 120px;
    }
    @media (min-width: 768px) {
      .jelajahi-main { padding-top: var(--sp-12); }
    }
  </style>

  <Footer />
</BaseLayout>
