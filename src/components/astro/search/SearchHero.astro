---
import SearchBar from '../../react/search/SearchBar';
---

<section class="search-hero" id="search-hero">
  <div class="search-hero-bg" aria-hidden="true"></div>

  <div class="search-hero-inner">
    <span class="search-hero-label">Jelajahi Nusantara</span>

    <h1 class="search-hero-title" id="search-hero-title">
      Cari &amp; Temukan Kuliner Nusantara
    </h1>

    <div class="search-hero-bar">
      <SearchBar client:load />
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initSearchHero() {
    const hero = document.getElementById('search-hero');
    if (!hero) return;

    gsap.from(hero.querySelector('.search-hero-label'), { y: -12, opacity: 0, duration: 0.8, ease: 'power3.out' });
    gsap.from(hero.querySelector('.search-hero-title'), { y: 32, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.2 });
    gsap.from(hero.querySelector('.search-hero-bar'), { y: 20, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.35, scale: 0.95 });
  }

  document.addEventListener('astro:page-load', () => requestAnimationFrame(initSearchHero));
</script>

<style>
  .search-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-8)) var(--page-px) var(--sp-8);
  }
  @media (min-width: 768px) {
    .search-hero { padding: calc(var(--nav-h) + var(--sp-12)) var(--page-px) var(--sp-12); }
  }

  .search-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--c-brand-mocha-dark) 0%,
      var(--c-brand-mocha) 35%,
      #6B4A2E 65%,
      var(--c-brand-caramel-dark) 100%
    );
  }

  .search-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 780px;
  }

  .search-hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-brand-caramel);
    margin-bottom: var(--sp-6);
    opacity: 0.85;
  }

  .search-hero-title {
    font-family: var(--ff-display);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--sp-5);
    font-size: clamp(2.4rem, 10vw, 5.5rem);
    background: var(--grad-warm);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .search-hero-bar {
    max-width: 640px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .search-hero-label { font-size: var(--fs-xs); }
  }
</style>
