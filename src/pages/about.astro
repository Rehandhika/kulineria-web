---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';
import AboutHero from '../components/astro/about/AboutHero.astro';
import StoryScroll from '../components/astro/about/StoryScroll.astro';
import TeamSection from '../components/astro/about/TeamSection.astro';
---

<BaseLayout title="Tentang" description="Tentang Kulineria — Atlas Kuliner Nusantara">
  <div class="about-page">
    <AboutHero />

    <StoryScroll />

    <TeamSection />

    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .about-page {
    background: var(--c-bg);
  }
</style>
