---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizProvider from '../../components/react/quiz/QuizProvider';
import Footer from '../../components/astro/shared/Footer.astro';
---

<BaseLayout title="Quiz" description="Test your Indonesian culinary knowledge">
  <div class="quiz-page-wrapper">
    <QuizProvider client:only="react" />
  </div>
  <Footer />
</BaseLayout>

<style is:global>
  .quiz-page-wrapper {
    min-height: 100vh;
    padding-top: calc(var(--nav-mobile-h) + var(--sp-4));
    padding-bottom: var(--sp-20);
  }

  @media (min-width: 1024px) {
    .quiz-page-wrapper {
      padding-top: calc(var(--nav-h) + var(--sp-8));
      padding-bottom: var(--sp-20);
    }
  }
</style>
