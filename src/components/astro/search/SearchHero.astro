---
import SearchBar from '../../react/search/SearchBar';
---

<section class="search-hero" id="search-hero">
  <div class="search-hero-bg" aria-hidden="true"></div>

  <div class="search-hero-inner">
    <span class="search-hero-label">Jelajahi Nusantara</span>

    <h1 class="search-hero-title" id="search-hero-title">
      Cari &amp; Temukan Kuliner Nusantara
    </h1>

    <div class="search-hero-bar">
      <SearchBar client:load />
    </div>
  </div>

  <!-- NARA wave — peeking bottom right -->
  <div class="search-hero-nara" aria-hidden="true">
    <img
      src="/img/nara/NARA 5.png"
      alt=""
      class="search-hero-nara-img"
      width="140"
      height="140"
      draggable="false"
      onerror="this.parentElement.style.display='none'"
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initSearchHero() {
    const hero = document.getElementById('search-hero');
    if (!hero || hero.dataset.animated) return;
    hero.dataset.animated = 'true';

    const label = hero.querySelector('.search-hero-label');
    const title = hero.querySelector('.search-hero-title');
    const bar = hero.querySelector('.search-hero-bar');
    const bg = hero.querySelector('.search-hero-bg');

    const tl = gsap.timeline({ defaults: { ease: 'power4.out', overwrite: 'auto' } });

    tl.fromTo(bg, { scale: 1.08, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.5, ease: 'power2.out' }, 0)
      .fromTo(label, { y: -12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8 }, 0.15)
      .fromTo(title, { y: 40, opacity: 0, filter: 'blur(8px)' }, { y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', duration: 1.1 }, 0.25)
      .fromTo(bar, { y: 24, opacity: 0, scale: 0.92 }, {
        y: 0, opacity: 1, scale: 1, duration: 0.9, ease: 'back.out(1.7)',
      }, '-=0.3');
  }

  /* ─── SINKRONISASI DENGAN TRANSISI HALAMAN ─────────────────────────────
   *
   * DOMContentLoaded  → load awal (bukan navigasi Swup)
   * kulineria:page:ready → navigasi Swup: dispatch tepat di animation:in:start,
   *   setelah DOM swap + 1 rAF browser paint — sudah deterministik.
   * ────────────────────────────────────────────────────────────────────── */

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initSearchHero);
</script>

<style>
  .search-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-8)) var(--page-px) var(--sp-8);
  }
  @media (min-width: 768px) {
    .search-hero { padding: calc(var(--nav-h) + var(--sp-12)) var(--page-px) var(--sp-12); }
  }

  .search-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--brown-900, #3D2415) 0%,
      var(--brown-800, #5A3420) 35%,
      #6B4A2E 65%,
      var(--brown-600, #8B5535) 100%
    );
    will-change: transform, opacity;
    opacity: 0;
  }

  .search-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 780px;
  }

  .search-hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-brand-caramel);
    margin-bottom: var(--sp-6);
    opacity: 0;
  }

  .search-hero-title {
    font-family: var(--ff-display);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--sp-5);
    font-size: clamp(2.4rem, 10vw, 5.5rem);
    background: var(--grad-warm);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .search-hero-bar {
    max-width: 640px;
    margin: 0 auto;
  }

  /* NARA */
  .search-hero-nara {
    position: absolute;
    bottom: 0;
    right: clamp(16px, 5vw, 80px);
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    animation: searchNaraIn 0.7s ease 1.2s forwards;
  }
  .search-hero-nara-img {
    width: clamp(80px, 11vw, 140px);
    height: auto;
    object-fit: contain;
    display: block;
    user-select: none;
    filter: drop-shadow(0 -4px 12px rgba(0,0,0,0.3));
    animation: searchNaraFloat 3.5s ease-in-out infinite;
    animation-delay: 2s;
  }
  @keyframes searchNaraIn { to { opacity: 1; } }
  @keyframes searchNaraFloat {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }
  @media (max-width: 640px) {
    .search-hero-nara { right: 8px; }
    .search-hero-nara-img { width: 70px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-hero-nara-img { animation: none; }
    .search-hero-nara { opacity: 1; animation: none; }
  }

  @media (max-width: 767px) {
    .search-hero-label { font-size: var(--fs-xs); }
  }
</style>
