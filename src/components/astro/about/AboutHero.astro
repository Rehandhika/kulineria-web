---
const foodCount = 510;
const regionCount = 6;
---

<section class="about-hero" id="about-hero">
  <div class="about-hero-bg" aria-hidden="true"></div>

  <svg class="about-hero-noise" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="about-noise-fx">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </defs>
    <rect width="100" height="100" filter="url(#about-noise-fx)" opacity="0.04" style="mix-blend-mode: overlay"/>
  </svg>

  <div class="about-hero-inner">
    <span class="about-hero-label">Tentang Kulineria</span>
    <h1 class="about-hero-title">
      <span class="about-hero-line">
        <span class="about-hero-word">Berawal</span>
        <span class="about-hero-word">dari</span>
        <span class="about-hero-word">rasa</span>
        <span class="about-hero-word">penasaran</span>
      </span>
      <span class="about-hero-line">
        <span class="about-hero-word">akan</span>
        <span class="about-hero-word highlight">{foodCount}</span>
        <span class="about-hero-word">hidangan</span>
        <span class="about-hero-word">tradisional,</span>
      </span>
      <span class="about-hero-line">
        <span class="about-hero-word">berlanjut</span>
        <span class="about-hero-word">menjelajahi</span>
        <span class="about-hero-word highlight">{regionCount}</span>
        <span class="about-hero-word">wilayah</span>
      </span>
      <span class="about-hero-line">
        <span class="about-hero-word">penjuru</span>
        <span class="about-hero-word">Nusantara,</span>
      </span>
      <span class="about-hero-line">
        <span class="about-hero-word">hingga</span>
        <span class="about-hero-word">akhirnya</span>
        <span class="about-hero-word">bermuara</span>
        <span class="about-hero-word">pada</span>
      </span>
      <span class="about-hero-line about-hero-line-glow">
        <span class="about-hero-word">satu</span>
        <span class="about-hero-word">misi</span>
        <span class="about-hero-word">sederhana</span>
      </span>
    </h1>
    <p class="about-hero-subtitle">
      memetakan kekayaan rasa Indonesia, agar tak pernah dilupakan.
    </p>
    <div class="about-hero-actions">
      <a href="#cerita" class="about-hero-cta">
        <span>Baca Cerita</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initAboutHero() {
    const hero = document.getElementById('about-hero');
    if (!hero || hero.dataset.animated) return;
    hero.dataset.animated = 'true';

    const label = hero.querySelector('.about-hero-label');
    const words = hero.querySelectorAll('.about-hero-word');
    const subtitle = hero.querySelector('.about-hero-subtitle');
    const cta = hero.querySelector('.about-hero-cta');
    const bg = hero.querySelector('.about-hero-bg');
    const noise = hero.querySelector('.about-hero-noise');

    const tl = gsap.timeline({ defaults: { ease: 'power4.out', overwrite: 'auto' } });

    tl.fromTo(bg, { scale: 1.08, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.5, ease: 'power2.out' }, 0)
      .fromTo(noise, { opacity: 0 }, { opacity: 0.8, duration: 2.5 }, 0)
      .fromTo(label, { y: -12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, 0.15)
      .fromTo(words, { y: 60, opacity: 0, filter: 'blur(12px)' }, {
        y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', stagger: 0.06, duration: 1.2,
      }, 0.2)
      .fromTo(subtitle, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, '-=0.5')
      .fromTo(cta, { y: 24, opacity: 0, scale: 0.92 }, {
        y: 0, opacity: 1, scale: 1, duration: 0.8, ease: 'back.out(1.7)',
      }, '-=0.35');
  }

  /* ─── SINKRONISASI DENGAN TRANSISI HALAMAN ─────────────────────────────
   *
   * Menggunakan helper runOnPageReady untuk memastikan eksekusi aman
   * secara deterministik, baik untuk initial load maupun asinkron Swup.
   * ────────────────────────────────────────────────────────────────────── */

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initAboutHero);
</script>

<style>
  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-8)) var(--page-px) var(--sp-8);
  }
  @media (min-width: 768px) {
    .about-hero { padding: calc(var(--nav-h) + var(--sp-12)) var(--page-px) var(--sp-12); }
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--c-brand-mocha-dark) 0%,
      var(--c-brand-mocha) 35%,
      #6B4A2E 65%,
      var(--c-brand-caramel-dark) 100%
    );
    will-change: transform, opacity;
    opacity: 0;
  }

  .about-hero-noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .about-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
  }

  .about-hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-brand-caramel);
    margin-bottom: var(--sp-6);
    opacity: 0;
  }

  .about-hero-title {
    font-family: var(--ff-display);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--sp-5);
  }
  .about-hero-line { display: block; }
  .about-hero-title .about-hero-line {
    font-size: clamp(1.6rem, 5vw, 3rem);
    color: var(--c-brand-cream);
  }
  .about-hero-line-glow {
    font-size: clamp(2rem, 6vw, 3.8rem);
  }
  .about-hero-line-glow .about-hero-word {
    background: var(--grad-warm);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .highlight {
    color: var(--c-brand-gold);
  }
  .about-hero-line-glow .highlight {
    -webkit-text-fill-color: var(--c-brand-gold);
    color: var(--c-brand-gold);
  }

  .about-hero-word {
    display: inline-block;
    will-change: transform, opacity, filter;
    opacity: 0;
  }

  .about-hero-subtitle {
    font-family: var(--ff-body);
    font-size: clamp(var(--fs-base), 1.8vw, var(--fs-lg));
    color: rgba(255, 248, 240, 0.85);
    font-weight: 500;
    line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-8);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-style: italic;
    opacity: 0;
  }

  .about-hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 14px 36px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--c-brand-caramel);
    color: var(--c-brand-cream);
    font-family: var(--ff-body);
    font-size: var(--fs-base);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.35s var(--ease-smooth);
    cursor: pointer;
    will-change: transform;
    opacity: 0;
  }
  .about-hero-cta svg {
    transition: transform 0.3s var(--ease-smooth);
  }
  .about-hero-cta:hover {
    background: var(--c-brand-caramel);
    color: var(--c-brand-mocha-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(196, 154, 110, 0.25);
  }
  .about-hero-cta:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .about-hero-label { font-size: var(--fs-xs); }
    .about-hero-title .about-hero-line {
      font-size: clamp(1.2rem, 4.5vw, 1.8rem);
    }
    .about-hero-line-glow {
      font-size: clamp(1.5rem, 5vw, 2.2rem);
    }
  }
</style>
