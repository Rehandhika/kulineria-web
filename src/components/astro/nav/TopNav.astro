---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Beranda', key: 'home' },
  { href: '/search', label: 'Jelajahi', key: 'search' },
  { href: '/quiz', label: 'Kuis', key: 'quiz' },
  { href: '/about', label: 'Tentang', key: 'about' },
];
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}

const navIcons: Record<string, string> = {
  home: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  search: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
  quiz: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>',
  about: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="M8 7h8"/><path d="M8 11h6"/></svg>',
};
---

<header class="top-nav" id="top-nav" role="banner">
  <div class="top-nav-bar">
    <div class="top-nav-inner">
      <a href="/" class="top-nav-logo" aria-label="Kulineria Home">
        <span class="top-nav-logo-text">Kulineria</span>
      </a>

      <nav class="top-nav-links" role="navigation" aria-label="Main navigation">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={['top-nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span>{item.label}</span>
          </a>
        ))}
      </nav>

      <button class="top-nav-hamburger" aria-label="Buka menu" aria-expanded="false" data-menu-toggle>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Overlay -->
  <div class="top-nav-overlay" data-menu-overlay inert>
    <div class="overlay-bg"></div>
    <div class="overlay-scroll">
      <nav class="overlay-nav">
        {navItems.map((item, idx) => (
          <a
            href={item.href}
            class:list={['overlay-link', { active: isActive(item.href) }]}
            style={`--idx: ${idx}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="overlay-link-icon" aria-hidden="true" set:html={navIcons[item.key]}></span>
            <span class="overlay-link-label">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="overlay-footer">
        <span class="overlay-tagline">dibuat dengan ❤ dan sambal</span>
      </div>
    </div>
  </div>
</header>

<script>
import { gsap } from 'gsap';

function initNav() {
  const header = document.getElementById('top-nav');
  const overlay = document.querySelector('[data-menu-overlay]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const body = document.body;
  if (!header || !overlay || !toggle) return;

  let tl;

  function closeMenu() {
    if (tl) tl.kill();
    overlay.classList.remove('open');
    overlay.setAttribute('inert', '');
    toggle.setAttribute('aria-expanded', 'false');
    body.style.overflow = '';
  }

  function openMenu() {
    overlay.classList.add('open');
    overlay.removeAttribute('inert');
    toggle.setAttribute('aria-expanded', 'true');
    body.style.overflow = 'hidden';

    tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.set(overlay, { clearProps: 'opacity' })
      .fromTo(overlay, { opacity: 0 }, { opacity: 1, duration: 0.35 })
      .from(overlay.querySelectorAll('.overlay-link'), { y: 40, opacity: 0, filter: 'blur(6px)', stagger: 0.06, duration: 0.55 }, '-=0.2')
      .from(overlay.querySelector('.overlay-footer'), { y: 16, opacity: 0, duration: 0.4 }, '-=0.15');
  }

  toggle.addEventListener('click', () => {
    overlay.classList.contains('open') ? closeMenu() : openMenu();
  });
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeMenu(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeMenu();
  });

  // Scroll effect: hero mode vs scrolled
  function onScroll() {
    const scrolled = window.scrollY > 30;
    header.classList.toggle('top-nav-scrolled', scrolled);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

document.addEventListener('astro:page-load', () => requestAnimationFrame(initNav));
</script>

<style>
  .top-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top, 0);
    font-family: var(--ff-body);
    color: rgba(255, 248, 240, 0.85);
  }

  .top-nav-bar {
    position: relative;
    z-index: 2;
    transition: background 0.35s ease, box-shadow 0.35s ease, color 0.35s ease;
    background: transparent;
  }
  .top-nav-bar::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-brand-caramel), transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .top-nav-scrolled .top-nav-bar {
    background: rgba(250, 244, 236, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 8px rgba(60, 42, 30, 0.06);
    color: var(--c-text-2);
  }
  .top-nav-scrolled .top-nav-bar::after {
    opacity: 0.25;
  }

  .top-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-mobile-h);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--sp-4);
  }
  @media (min-width: 1024px) {
    .top-nav-inner { height: var(--nav-h); padding: 0 var(--sp-8); }
  }

  /* Logo */
  .top-nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }
  .top-nav-logo:hover { opacity: 0.8; }
  .top-nav-logo-text {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    letter-spacing: -0.02em;
    background: var(--grad-warm);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Desktop nav links */
  .top-nav-links {
    display: none;
    align-items: center;
    gap: var(--sp-1);
  }
  @media (min-width: 1024px) {
    .top-nav-links { display: flex; }
  }

  .top-nav-link {
    position: relative;
    padding: 6px 14px;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .top-nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-warm);
    transition: transform 0.25s var(--ease-smooth);
  }
  .top-nav-link:hover { color: #FFF8F0; }
  .top-nav-link:hover::after { transform: translateX(-50%) scaleX(1); }
  .top-nav-link.active { color: var(--c-brand-caramel); }
  .top-nav-link.active::after { transform: translateX(-50%) scaleX(1); }

  .top-nav-scrolled .top-nav-link { color: var(--c-text-2); }
  .top-nav-scrolled .top-nav-link:hover { color: var(--c-text-1); }
  .top-nav-scrolled .top-nav-link.active { color: var(--c-brand-cinnamon-dark); }
  .top-nav-scrolled .top-nav-link::after { background: var(--grad-warm); }

  /* Hamburger */
  .top-nav-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1.5px solid rgba(255, 248, 240, 0.3);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    color: inherit;
  }
  .top-nav-hamburger:hover {
    border-color: rgba(255, 248, 240, 0.6);
  }
  .top-nav-scrolled .top-nav-hamburger {
    border-color: var(--c-border);
    color: var(--c-text-2);
  }
  .top-nav-scrolled .top-nav-hamburger:hover {
    border-color: var(--c-brand-caramel);
    color: var(--c-brand-caramel-dark);
  }
  @media (min-width: 1024px) {
    .top-nav-hamburger { display: none; }
  }

  .hamburger-line {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.25s ease;
    transform-origin: center;
  }
  .top-nav-hamburger[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .top-nav-hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .top-nav-hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ---- OVERLAY ---- */
  .top-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0s 0.4s;
    overflow: hidden;
    background: linear-gradient(155deg, var(--c-brand-mocha-dark) 0%, var(--c-brand-mocha) 50%, #6B4A2E 100%);
    color: rgba(255, 248, 240, 0.9);
  }
  .top-nav-overlay.open {
    visibility: visible;
    opacity: 1;
    transition: visibility 0s 0s;
  }

  .overlay-scroll {
    position: relative;
    z-index: 2;
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-mobile-h) + env(safe-area-inset-top, 0) + var(--sp-8)) var(--sp-6) var(--sp-8);
    text-align: center;
  }

  .overlay-nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    width: 100%;
    max-width: 320px;
  }

  .overlay-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 20px;
    border-radius: var(--r-xl);
    color: rgba(255, 248, 240, 0.7);
    font-weight: 700;
    font-size: var(--fs-lg);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
    opacity: 0;
  }
  .open .overlay-link {
    opacity: 1;
  }
  .overlay-link:hover {
    color: #FFF8F0;
    background: rgba(255, 255, 255, 0.06);
  }
  .overlay-link.active {
    color: var(--c-brand-caramel);
    background: rgba(196, 154, 110, 0.1);
  }
  .overlay-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
    color: inherit;
  }
  .overlay-link.active .overlay-link-icon {
    background: rgba(196, 154, 110, 0.2);
    color: var(--c-brand-caramel);
  }
  .overlay-link-label {
    font-family: var(--ff-display);
  }

  .overlay-footer {
    margin-top: var(--sp-10);
    opacity: 0;
  }
  .open .overlay-footer {
    opacity: 1;
  }
  .overlay-tagline {
    font-size: var(--fs-sm);
    color: rgba(255, 248, 240, 0.4);
  }
</style>
