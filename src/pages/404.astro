---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';

const statusCode = 404;
---

<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan">
  <section class="not-found-page">
    <div class="not-found-content">
      <!-- NARA mascot — sad expression (NARA 4.png) -->
      <div class="not-found-nara">
        <img
          src="/img/nara/NARA 4.png"
          alt="Nara sedih"
          class="nara-img"
          width="160"
          height="160"
          onerror="this.style.display='none'"
        />
        <div class="nara-dialog">Aduh, halaman ini hilang...</div>
      </div>

      <span class="status-code">{statusCode}</span>
      <h1>Halaman Tidak Ditemukan</h1>
      <p>Halaman yang kamu cari tidak ada atau sudah dipindahkan. Yuk cari hidangan lain!</p>

      <form class="search-redirect" action="/jelajahi" method="GET">
        <input type="text" name="q" placeholder="Cari hidangan..." aria-label="Cari hidangan" />
        <button type="submit">Cari</button>
      </form>

      <div class="quick-links">
        <a href="/" class="quick-link">Beranda</a>
        <a href="/jelajahi" class="quick-link">Jelajahi</a>
        <a href="/kuis" class="quick-link">Kuis</a>
        <a href="/tentang" class="quick-link">Tentang</a>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .not-found-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-20) var(--sp-4);
    position: relative;
    overflow: hidden;
    background: var(--c-bg);
  }

  .not-found-content {
    text-align: center;
    max-width: 480px;
    position: relative;
    z-index: 1;
  }

  /* ── NARA ── */
  .not-found-nara {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-8);
  }

  .nara-img {
    width: 160px;
    height: 160px;
    object-fit: contain;
    animation: naraFloat 3s ease-in-out infinite;
    user-select: none;
    -webkit-user-drag: none;
  }

  @keyframes naraFloat {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  .nara-dialog {
    background: var(--c-surface);
    border: 1.5px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 8px 18px;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-text-1);
    box-shadow: var(--sh-2);
    position: relative;
  }
  .nara-dialog::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-bottom-color: var(--c-border);
  }
  .nara-dialog::after {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-bottom-color: var(--c-surface);
  }

  /* ── Content ── */
  .status-code {
    display: block;
    font-family: var(--ff-display);
    font-size: var(--fs-4xl);
    font-weight: 700;
    color: var(--c-accent);
    margin-bottom: var(--sp-2);
  }

  .not-found-content h1 {
    font-family: var(--ff-display);
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  .not-found-content p {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    margin-bottom: var(--sp-8);
    line-height: var(--lh-relaxed);
  }

  /* ── Search ── */
  .search-redirect {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-8);
  }

  .search-redirect input {
    flex: 1;
    padding: var(--sp-3) var(--sp-4);
    border: 1.5px solid var(--c-border);
    border-radius: var(--r-full);
    font-size: var(--fs-base);
    font-family: var(--ff-body);
    background: var(--c-surface);
    color: var(--c-text-1);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-redirect input:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-alpha);
  }

  .search-redirect button {
    padding: var(--sp-3) var(--sp-6);
    background: var(--c-accent);
    color: #fff;
    border: none;
    border-radius: var(--r-full);
    font-size: var(--fs-base);
    font-weight: 600;
    font-family: var(--ff-body);
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    box-shadow: var(--sh-btn);
  }

  .search-redirect button:hover {
    background: var(--c-accent-hover);
    transform: translateY(-1px);
  }

  /* ── Quick links ── */
  .quick-links {
    display: flex;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .quick-link {
    padding: var(--sp-2) var(--sp-4);
    background: var(--c-surface);
    border: 1.5px solid var(--c-border);
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    color: var(--c-text-1);
    font-weight: 600;
    font-family: var(--ff-body);
    transition: border-color 0.15s, color 0.15s, transform 0.15s var(--ease-bounce);
  }

  .quick-link:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .search-redirect { flex-direction: column; }
    .search-redirect button { width: 100%; }
    .nara-img { width: 120px; height: 120px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nara-img { animation: none; }
  }
</style>