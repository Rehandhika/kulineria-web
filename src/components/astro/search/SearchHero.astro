---
import SearchBar from '../../react/search/SearchBar';
---

<section class="search-hero" id="search-hero">
  <div class="search-hero-bg-wrapper" aria-hidden="true">
    <div class="search-hero-bg"></div>
  </div>

  <!-- Motif Ornamen Nusantara background overlay -->
  <div class="search-hero-motif" aria-hidden="true">
    <img src="/img/motif/png ornamen nusantara.png" class="motif-float-2" alt="" />
  </div>

  <!-- Floating clouds within Hero (Aligned exactly with Quiz Hero!) -->
  <div class="search-hero-cloud search-motif-hero-left" aria-hidden="true">
    <img src="/img/motif/png batik mega mendung.png" class="motif-float-1" alt="" />
  </div>
  <div class="search-hero-cloud search-motif-hero-right" aria-hidden="true">
    <img src="/img/motif/png batik mega mendung.png" class="motif-float-2" alt="" />
  </div>
  <!-- Seamless visual bottom organic wave divider filled with page background color -->
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,0 C240,60 480,0 720,40 C960,80 1200,10 1440,40 L1440,120 L0,120 Z"
        fill="var(--c-bg)" opacity="0.18"/>
      <path d="M0,20 C180,70 360,10 540,40 C720,70 900,10 1080,40 C1260,70 1380,30 1440,20 L1440,120 L0,120 Z"
        fill="var(--c-bg)" opacity="0.35"/>
      <path d="M0,40 C200,90 400,20 600,60 C800,100 1000,20 1200,60 C1320,80 1380,70 1440,60 L1440,120 L0,120 Z"
        fill="var(--c-bg)"/>
    </svg>
  </div>

  <div class="search-hero-inner">
    <!-- Hero body: fully centered vertical flow structure -->
    <div class="search-hero-body">
      <!-- Mascot NARA - Centered top, grounded on the baseline -->
      <div class="search-hero-nara" aria-hidden="true">
        <img
          src="/img/nara/NARA 4.png"
          alt="Nara menyambut Anda"
          class="search-hero-nara-img"
          draggable="false"
          onerror="this.parentElement.style.display='none'"
        />
      </div>

      <!-- Content area: groups title and search bar -->
      <div class="search-hero-content">
        <!-- Title: elegant and neat large text -->
        <h1 class="search-hero-title">Jelajahi Kuliner Nusantara</h1>

        <!-- Search Bar -->
        <div class="search-hero-bar">
          <SearchBar client:load />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { runOnPageReady } from '../../../lib/animations/gsap-presets';

  function initSearchHero() {
    const hero = document.getElementById('search-hero');
    if (!hero || hero.dataset.animated) return;
    hero.dataset.animated = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bg = hero.querySelector('.search-hero-bg');
    const motif = hero.querySelector('.search-hero-motif');
    const leftCloud = hero.querySelector('.search-motif-hero-left');
    const rightCloud = hero.querySelector('.search-motif-hero-right');
    const title = hero.querySelector('.search-hero-title');
    const bar = hero.querySelector('.search-hero-bar');
    const nara = hero.querySelector('.search-hero-nara-img');

    if (reduced) {
      if (bg) gsap.set(bg, { opacity: 1 });
      if (motif) gsap.set(motif, { opacity: 0.03 });
      if (leftCloud) gsap.set(leftCloud, { opacity: 0.15, rotation: -15 });
      if (rightCloud) gsap.set(rightCloud, { opacity: 0.12, rotation: 15, scaleX: -1 });
      if (title) gsap.set(title, { opacity: 1 });
      if (bar) gsap.set(bar, { opacity: 1 });
      if (nara) gsap.set(nara, { opacity: 1 });
      return;
    }

    const tl = gsap.timeline({ defaults: { overwrite: 'auto' } });

    tl.fromTo(bg, { scale: 1.08, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.6, ease: 'power2.out' }, 0)
      .fromTo(motif, { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 0.03, duration: 1.4, ease: 'power2.out' }, 0)
      .fromTo(leftCloud, { opacity: 0, scale: 0.8, x: -20, rotation: -20 }, { opacity: 0.15, scale: 1, x: 0, rotation: -15, duration: 1.5, ease: 'power2.out' }, 0.1)
      .fromTo(rightCloud, { opacity: 0, scaleX: -0.8, scaleY: 0.8, x: 20, rotation: 20 }, { opacity: 0.12, scaleX: -1, scaleY: 1, x: 0, rotation: 15, duration: 1.5, ease: 'power2.out' }, 0.15)
      .fromTo(nara, { opacity: 0, scale: 0.82, y: -15 }, { opacity: 1, scale: 1, y: 0, duration: 0.8, ease: 'back.out(1.5)' }, 0.1)
      .fromTo(title, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, 0.25)
      .fromTo(bar, { y: 14, opacity: 0, scale: 0.96 }, { y: 0, opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(1.5)' }, '-=0.25');
  }

  runOnPageReady(initSearchHero);
</script>

<style>
  /* 
    Set overflow: visible & z-index: 15 so that the absolutely positioned 
    suggestions dropdown never gets clipped by the hero or rendered under other sections.
  */
  .search-hero {
    position: relative;
    z-index: 15;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Compact top padding to prevent fixed navbar collision, and minimal bottom spacing clearing the wave */
    padding: calc(var(--nav-mobile-h) + var(--sp-4)) 0 65px;
  }
  @media (min-width: 768px) {
    .search-hero { 
      padding: calc(var(--nav-h) + var(--sp-6)) 0 95px; 
    }
  }

  /* Background wrapper to clip scale animation overflow and prevent seam leakage */
  .search-hero-bg-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  /* Dark gradient background */
  .search-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--brown-900, #3D2415) 0%,
      var(--brown-800, #5A3420) 35%,
      #6B4A2E 65%,
      var(--brown-600, #8B5535) 100%
    );
    will-change: transform, opacity;
    opacity: 0;
  }

  /* Floating clouds within Hero */
  .search-hero-cloud {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    opacity: 0;
  }
  .search-hero-cloud img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.4) sepia(0.35) saturate(0.6) contrast(1.1);
  }

  .search-motif-hero-left {
    width: 180px;
    top: 10px;
    left: 10px;
  }

  .search-motif-hero-right {
    width: 220px;
    top: 40px;
    right: 10px;
  }

  @media (max-width: 768px) {
    .search-motif-hero-left {
      width: 120px;
      left: 0px;
      top: 10px;
    }
    .search-motif-hero-right {
      width: 140px;
      right: 0px;
      top: 30px;
    }
  }

  /* Motif overlay on dark bg */
  .search-hero-motif {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(180px, 32vw, 400px);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }
  .search-hero-motif img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.4) sepia(0.35) saturate(0.5) contrast(1.1);
  }

  /* Staggered high-performance floating animations (fully composited static layers) */
  @keyframes searchHeroFloatMotif1 {
    0%, 100% { transform: translateY(0) translateX(0) rotate(0deg); }
    50%       { transform: translateY(-8px) translateX(4px) rotate(2deg); }
  }

  @keyframes searchHeroFloatMotif2 {
    0%, 100% { transform: translateY(0) translateX(0) rotate(-8deg); }
    50%       { transform: translateY(-8px) translateX(4px) rotate(-6deg); }
  }

  .motif-float-1 {
    animation: searchHeroFloatMotif1 8s ease-in-out infinite;
    will-change: transform;
  }

  .motif-float-2 {
    animation: searchHeroFloatMotif2 10s ease-in-out infinite;
    animation-delay: -3s;
    will-change: transform;
  }

  /* Seamless visual bottom organic wave divider */
  .hero-wave {
    position: absolute;
    bottom: -1px; /* Prevents visual rendering seam gap line */
    left: 0;
    right: 0;
    height: 48px;
    z-index: 2;
    pointer-events: none;
    line-height: 0;
    overflow: hidden;
  }
  .hero-wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (min-width: 768px) {
    .hero-wave {
      height: 72px;
    }
  }

  /* Inner layout: wrapper that forces vertical flow and centers content */
  .search-hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center; /* Centered content layout */
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--sp-5); /* Mobile padding matches navbar */
  }
  @media (min-width: 768px) {
    .search-hero-inner {
      max-width: var(--container-max);
      padding: 0 var(--sp-6); /* Intermediate tablet padding */
    }
  }
  @media (min-width: 1024px) {
    .search-hero-inner {
      padding: 0 var(--sp-10); /* Desktop padding matches navbar */
    }
  }

  /* Hero body: fully centered vertical structure */
  .search-hero-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 600px; /* Nicely capped container for vertical alignment */
    gap: 0;
  }

  /* Content area: groups search bar and title */
  .search-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Mascot NARA - Centered top, grounded on the baseline */
  .search-hero-nara {
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    margin-bottom: var(--sp-3); /* Distance separating mascot and title on mobile */
  }
  @media (min-width: 768px) {
    .search-hero-nara {
      margin-bottom: var(--sp-4); /* Spacing on desktop */
    }
  }

  .search-hero-nara-img {
    width: 228px;
    height: auto;
    object-fit: contain;
    display: block;
    user-select: none;
    filter: drop-shadow(0 6px 16px rgba(0,0,0,0.3));
  }
  @media (min-width: 768px) {
    .search-hero-nara-img {
      width: 308px;
    }
  }

  /* Focused single title editorial styling */
  .search-hero-title {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 5.5vw, 3rem); /* Elegant, premium large title scale */
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #FFF8F1; /* Solid premium off-white */
    margin-bottom: var(--sp-4); /* Spacing to search bar on mobile */
    font-optical-sizing: auto;
    font-variation-settings: 'opsz' 144, 'SOFT' 50;
    text-align: center; /* Always centered */
  }
  @media (min-width: 768px) {
    .search-hero-title {
      margin-bottom: var(--sp-5); /* Spacing on desktop */
    }
  }

  /* Centered Search Bar wrapper with overflow clearance */
  .search-hero-bar {
    width: 100%;
    max-width: 100%;
    position: relative;
    z-index: 10;
  }
  @media (min-width: 768px) {
    .search-hero-bar {
      max-width: 460px; /* Shrunk slightly for tighter layout */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-hero-bg,
    .search-hero-cloud,
    .search-hero-motif,
    .search-hero-title, .search-hero-bar,
    .search-hero-nara-img { animation: none !important; }
  }
</style>
