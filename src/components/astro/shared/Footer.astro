---
const year = new Date().getFullYear();
const { id } = Astro.props;
---

<footer class="footer" id={id}>
  <!-- Wave separator -->
  <div class="footer-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,50 C200,90 400,10 600,50 C800,90 1000,10 1200,50 C1320,70 1380,60 1440,50 L1440,100 L0,100 Z"
        fill="var(--c-brand-mocha-dark)" opacity="0.18"/>
      <path d="M0,30 C240,80 480,0 720,40 C960,80 1200,10 1440,40 L1440,100 L0,100 Z"
        fill="var(--c-brand-mocha-dark)" opacity="0.35"/>
      <path d="M0,10 C180,60 360,0 540,30 C720,60 900,0 1080,30 C1260,60 1380,20 1440,10 L1440,100 L0,100 Z"
        fill="var(--c-brand-mocha-dark)"/>
    </svg>
  </div>

  <div class="footer-body">
    <div class="footer-container">

      <!-- Brand + Nav in one row -->
      <div class="footer-main">

        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label="Kulineria — Beranda">Kulineria</a>
          <p class="footer-tagline">Atlas Kuliner Nusantara —<br/>jelajahi ragam cita rasa Indonesia.</p>
        </div>

        <nav class="footer-nav" aria-label="Navigasi footer">
          <span class="footer-nav-label">Jelajahi</span>
          <a href="/jelajahi" class="footer-nav-link">Semua Hidangan</a>
          <a href="/kuis" class="footer-nav-link">Kuis Kuliner</a>
          <a href="/tentang" class="footer-nav-link">Tentang Kami</a>
        </nav>

      </div>

      <!-- Bottom bar -->
      <div class="footer-bottom">
        <p class="footer-copy">
          &copy; {year} Kulineria
        </p>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--sp-16);
  }

  /* ── Wave ── */
  .footer-wave {
    height: 60px;
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
  }
  .footer-wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (min-width: 768px) {
    .footer-wave { height: 80px; }
  }

  /* ── Body ── */
  .footer-body {
    background: var(--c-brand-mocha-dark);
    padding: var(--sp-8) 0 var(--sp-6);
  }

  .footer-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  @media (min-width: 1024px) {
    .footer-container { padding: 0 var(--sp-10); }
  }

  /* ── Main row: brand + nav ── */
  .footer-main {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  @media (min-width: 560px) {
    .footer-main {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--sp-8);
    }
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .footer-logo {
    font-family: var(--ff-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    letter-spacing: var(--ls-tight);
    color: var(--c-brand-cream);
    text-decoration: none;
    line-height: 1;
    font-variation-settings: 'opsz' 144, 'SOFT' 50;
    display: inline-block;
    transition: color 0.18s var(--ease-smooth), transform 0.18s var(--ease-bounce);
  }
  .footer-logo:hover {
    color: var(--c-brand-caramel);
    transform: translateX(3px);
  }

  .footer-tagline {
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: rgba(255, 248, 240, 0.55);
    line-height: var(--lh-relaxed);
    max-width: 260px;
    margin: 0;
  }

  /* ── Nav ── */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
  }

  .footer-nav-label {
    font-family: var(--ff-body);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-brand-caramel);
    margin-bottom: var(--sp-2);
  }

  .footer-nav-link {
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: rgba(255, 248, 240, 0.70);
    text-decoration: none;
    padding: 3px 0;
    display: inline-block;
    transition: color 0.15s var(--ease-smooth), transform 0.15s var(--ease-bounce);
  }
  .footer-nav-link:hover {
    color: var(--c-brand-cream);
    transform: translateX(4px);
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    padding-top: var(--sp-4);
    border-top: 1px solid rgba(255, 248, 240, 0.10);
  }

  .footer-copy {
    font-family: var(--ff-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: rgba(255, 248, 240, 0.40);
    margin: 0;
  }

  .footer-heart {
    color: var(--c-brand-terracotta);
    display: inline-block;
    animation: heartbeat 1.6s ease-in-out infinite;
  }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    40%       { transform: scale(1.25); }
    60%       { transform: scale(1.1); }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .footer-logo,
    .footer-nav-link { transition-duration: 1ms !important; }
    .footer-heart    { animation: none; }
  }
</style>
