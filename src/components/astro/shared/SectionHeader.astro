---
/**
 * SectionHeader - Reusable section header with overline and title
 */
interface Props {
  overline?: string;
  title: string;
  level?: 'h1' | 'h2' | 'h3';
}

const { overline, title, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class="section-header">
  {overline && <p class="overline">{overline}</p>}
  <Tag class="title">{title}</Tag>
</div>

<style>
  .section-header {
    margin-bottom: var(--sp-10);
  }

  .overline {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-3);
    margin-bottom: var(--sp-2);
  }

  .title {
    font-family: var(--ff-display);
    font-size: var(--fs-3xl);
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-1);
    line-height: var(--lh-snug);
  }
</style>
