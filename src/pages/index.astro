---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';
import HeroSection from '../components/astro/home/HeroSection.astro';
import InteractiveMap from '../components/react/home/InteractiveMap';
import RegionBanner from '../components/react/home/RegionBanner';
import FeaturedFoodsGrid from '../components/react/home/FeaturedFoodsGrid';
import SectionHeader from '../components/astro/shared/SectionHeader.astro';
import QuizCTA from '../components/astro/home/QuizCTA.astro';
import StoryCTA from '../components/astro/home/StoryCTA.astro';
---

<BaseLayout title="Beranda" description="Discover the rich flavors of Indonesian cuisine through an interactive exploration of regional specialties">
  <HeroSection />

  <!-- ZONA TERANG: Map + Featured mengalir sebagai satu kesatuan -->
  <div class="home-light-zone">

    <!-- Batik latar — repeat HD texture menyatukan map & featured -->
    <div class="light-zone-batik" aria-hidden="true"></div>

    <!-- INTERACTIVE MAP -->
    <section class="map-section" id="map-section">
      <div class="container map-section-container">
        <SectionHeader
          title="Jelajahi Nusantara"
          subtitle="Klik pulau pada peta dan temukan hidangan khasnya."
        />
        <InteractiveMap client:visible />
        <RegionBanner client:idle />
      </div>
    </section>

    <!-- FEATURED FOODS -->
    <FeaturedFoodsGrid client:visible />
  </div>

  <!-- QUIZ CTA — band gelap dengan jembatan gradien di kedua sisi -->
  <QuizCTA />

  <!-- STORY / TENTANG CTA — terang, mengalir ke footer -->
  <StoryCTA />

  <Footer bg="surface" />
</BaseLayout>

<style is:global>
  @import '../styles/section-transitions.css';

  /* ── Zona terang: Map + Featured satu kesatuan ── */
  .home-light-zone {
    position: relative;
    background: var(--c-bg);
  }

  /* Batik texture di balik map & featured — repeat HD */
  .light-zone-batik {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.035;
    filter: sepia(0.25) saturate(0.2) brightness(1.05);
    background-image: url('/img/motif/png batik.png');
    background-repeat: repeat;
    background-size: 220px;
  }

  /* Map section — hanya padding atas; Featured menyediakan padding bawah zona */
  .map-section {
    position: relative;
    padding-top: clamp(56px, 8vw, 128px);
    padding-bottom: clamp(32px, 4vw, 64px);
    background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 8L72 40L40 72L8 40Z' fill='none' stroke='%23C2410C' stroke-width='0.5' opacity='0.05'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 80px 80px;
  }

  .map-section-container {
    width: 100%;
  }

  .interactive-map {
    width: 100%;
    will-change: transform, opacity;
  }

  .map-container {
    position: relative;
    background: #2A1508;
    border-radius: var(--r-2xl);
    border: 1px solid rgba(61, 36, 21, 0.5);
    overflow: hidden;
    width: 100%;
    cursor: pointer;
    box-shadow: var(--sh-4);
    aspect-ratio: 21 / 10;
  }

  @media (min-width: 1024px) {
    .map-container { aspect-ratio: 24 / 10; }
  }

  .map-content-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* ── Ocean Background — clean dark, no color blobs ── */
  .map-ocean-bg {
    position: absolute;
    inset: 0;
    background: #2A1508;
    z-index: 0;
  }

  .map-region-path {
    position: absolute;
    pointer-events: auto;
    padding: 0;
    border: none;
    background: none;
    outline: none;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                filter 0.4s ease, opacity 0.4s ease;
    transform: scale(1);
    filter: none;
  }

  .map-region-path.is-hovered {
    transform: scale(1.03);
    filter: drop-shadow(0 0 16px var(--region-pulse-color)) brightness(1.2) saturate(1.1);
  }

  .map-region-path.is-active-pulse {
    animation: map-island-breathe 2.5s ease-in-out infinite alternate;
  }

  @keyframes map-island-breathe {
    0% {
      transform: scale(1.03);
      filter: drop-shadow(0 0 12px var(--region-pulse-color)) brightness(1.2) saturate(1.1);
    }
    100% {
      transform: scale(1.06);
      filter: drop-shadow(0 0 24px var(--region-pulse-color)) brightness(1.28) saturate(1.25);
    }
  }

  .map-region-path:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .map-region-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .map-tooltip {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--c-accent);
    color: #fff;
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 3px 0 rgba(0,0,0,0.15);
    z-index: 50;
    animation: fadeIn 0.15s ease;
  }
</style>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

function initScrollReveals() {
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 640;

  if (reduced) {
    gsap.set('.map-section .duo-section-header', { opacity: 1, y: 0 });
    gsap.set('.interactive-map', { opacity: 1, y: 0, scale: 1 });
    gsap.set('#featured .featured-header', { opacity: 1, y: 0 });
    return;
  }

  // ── HERO PARALLAX (desktop only) ──
  const hero = document.getElementById('hero-section');
  if (hero && !isMobile) {
    const heroBg = hero.querySelector('.hero-bg');
    if (heroBg) {
      gsap.to(heroBg, {
        y: '15%',
        scale: 1.06,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 },
      });
    }

    gsap.to('.hero-text', {
      opacity: 0.7,
      y: -20,
      ease: 'power2.out',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.5 },
    });
  }

  // ── MAP SECTION STAGGERED REVEAL ──
  const mapHeader = document.querySelector('.map-section .duo-section-header') as HTMLElement | null;
  const mapEl = document.querySelector('.interactive-map') as HTMLElement | null;
  const oceanBg = document.querySelector('.map-ocean-bg') as HTMLElement | null;
  const mapTrigger = isMobile ? 'top 90%' : 'top 80%';

  if (mapHeader && !mapHeader.dataset.revealed) {
    mapHeader.dataset.revealed = 'true';
    gsap.fromTo(mapHeader,
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out',
        scrollTrigger: { trigger: mapHeader, start: mapTrigger, toggleActions: 'play none none none' }
      }
    );
  }

  if (oceanBg && !oceanBg.dataset.revealed) {
    oceanBg.dataset.revealed = 'true';
    gsap.fromTo(oceanBg,
      { opacity: 0 },
      { opacity: 1, duration: 1.4, ease: 'power2.out',
        scrollTrigger: { trigger: oceanBg, start: mapTrigger, toggleActions: 'play none none none' }
      }
    );
  }

  if (mapEl && !mapEl.dataset.revealed) {
    mapEl.dataset.revealed = 'true';
    gsap.fromTo(mapEl,
      { opacity: 0, y: 56, scale: 0.96 },
      { opacity: 1, y: 0, scale: 1, duration: 1.4, ease: 'power3.out',
        scrollTrigger: { trigger: mapEl, start: isMobile ? 'top 85%' : 'top 75%', toggleActions: 'play none none none' }
      }
    );
  }

  // ── FEATURED FOODS HEADER REVEAL ──
  const featuredHeader = document.querySelector('#featured .featured-header') as HTMLElement | null;
  if (featuredHeader && !featuredHeader.dataset.revealed) {
    featuredHeader.dataset.revealed = 'true';
    gsap.fromTo(featuredHeader,
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out',
        scrollTrigger: { trigger: featuredHeader, start: isMobile ? 'top 90%' : 'top 85%', toggleActions: 'play none none none' }
      }
    );
  }

  ScrollTrigger.refresh();
}

import { runOnPageReady } from '../lib/animations/gsap-presets';
runOnPageReady(initScrollReveals);
</script>
