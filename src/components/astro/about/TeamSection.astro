---
import { getCollection } from 'astro:content';
import SectionHeader from '../shared/SectionHeader.astro';

const teamMembers = await getCollection('team');
const sorted = teamMembers.sort((a: any, b: any) => a.data.order - b.data.order);
---

<section class="team" id="about-team">
  <div class="container">
    <SectionHeader overline="Tim" title="Orang-orang di balik Kulineria" subtitle="Mereka yang punya semangat yang sama buat ngerawat dan nyebarin resep-resep Nusantara biar tetap dikenal" />

    <div class="team-grid">
      {
        sorted.map((member: any, i: number) => {
          // Use distinct accent colors from the new palette
          const avatarColors = ['#B5462E', '#2E7D6B', '#6A3FA0'];
          const avatarBgs   = ['#FFF0E8', '#E8F5EE', '#F0EBF8'];
          const color = avatarColors[i % avatarColors.length];
          const bg    = avatarBgs[i % avatarBgs.length];

          return (
            <div class="team-card duo-card" data-tilt>
              <div class="team-avatar-wrap" style={{ background: bg }}>
                <svg viewBox="0 0 80 80" class="team-avatar" aria-hidden="true">
                  <circle cx="40" cy="32" r="14" fill={color} />
                  <ellipse cx="40" cy="62" rx="20" ry="16" fill={color} />
                  <circle cx="34" cy="28" r="2.5" fill="var(--c-text-1)" />
                  <circle cx="46" cy="28" r="2.5" fill="var(--c-text-1)" />
                  <path d="M 36 36 Q 40 40 44 36" fill="none" stroke="var(--c-text-1)" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </div>
              <div class="team-card-body">
                <span class="team-number">0{i + 1}</span>
                <h3>{member.data.name}</h3>
                <p class="team-role">{member.data.role}</p>
                <p class="team-bio">{member.data.bio}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTeam() {
    const cards = document.querySelectorAll('.team-card');
    if (!cards.length) return;

    gsap.set(cards, { y: 40, opacity: 0, filter: 'blur(8px)' });

    ScrollTrigger.refresh();

    const tl = gsap.to(cards, {
      y: 0,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 1.2,
      stagger: 0.2,
      ease: 'power2.out',
      clearProps: 'filter,y',
      scrollTrigger: { trigger: '.team-grid', start: 'top 85%' },
    });

    // Fallback: ensure cards visible after 5s whether scroll-trigger fired or not
    setTimeout(() => {
      if (tl.progress() < 1) {
        gsap.set(cards, { y: 0, opacity: 1, clearProps: 'y' });
      }
    }, 5000);

    // Tilt effect per card
    cards.forEach((card) => {
      card.addEventListener('mousemove', (ev: Event) => {
        const e = ev as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        gsap.to(card, {
          rotateY: x * 10,
          rotateX: -y * 10,
          duration: 0.3,
          ease: 'power2.out',
          transformPerspective: 1000,
        });
        const avatar = card.querySelector('.team-avatar-wrap');
        if (avatar) {
          gsap.to(avatar, {
            y: -8,
            scale: 1.08,
            duration: 0.3,
            ease: 'power2.out',
          });
        }
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          rotateY: 0,
          rotateX: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.5)',
        });
        const avatar = card.querySelector('.team-avatar-wrap');
        if (avatar) {
          gsap.to(avatar, {
            y: 0,
            scale: 1,
            duration: 0.4,
            ease: 'elastic.out(1, 0.5)',
          });
        }
      });
    });
  }

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initTeam);
</script>

<style>
  .team {
    position: relative;
    padding: var(--sp-12) 0;
    background: var(--c-bg);
  }
  .team .container {
    position: relative;
    z-index: 1;
  }
  @media (min-width: 768px) {
    .team { padding: var(--sp-20) 0; }
  }

  .team-grid {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: var(--sp-4);
    margin: 0 calc(var(--page-px) * -1);
    padding: var(--sp-6) var(--page-px);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .team-grid::-webkit-scrollbar {
    display: none;
  }

  .team-card {
    flex: 0 0 80%;
    scroll-snap-align: center;
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
    cursor: default;
    will-change: transform;
  }

  @media (min-width: 640px) {
    .team-grid { 
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      overflow-x: visible;
      margin: 0;
      padding: 0;
      gap: var(--sp-6);
      scroll-snap-type: none;
    }
    .team-card {
      flex: none;
      scroll-snap-align: none;
      padding: var(--sp-8) var(--sp-6);
    }
  }

  @media (min-width: 1024px) {
    .team-grid { grid-template-columns: repeat(3, 1fr); gap: var(--sp-8); }
  }

  .team-avatar-wrap {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4px solid var(--c-brand-cream);
    box-shadow: 0 4px 0 rgba(60, 42, 30, 0.12);
    transition: box-shadow 0.3s var(--ease-bounce);
    will-change: transform;
  }
  .team-card:hover .team-avatar-wrap {
    box-shadow: 0 8px 0 rgba(60, 42, 30, 0.15);
  }

  .team-avatar {
    width: 60px;
    height: 60px;
  }

  .team-card-body {
    text-align: center;
    position: relative;
  }

  .team-number {
    position: absolute;
    top: -6px;
    right: -8px;
    font-family: var(--ff-display);
    font-size: var(--fs-xs);
    font-weight: 900;
    color: var(--c-accent);
    opacity: 0.25;
  }

  .team-card h3 {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 800;
    color: var(--c-text-1);
    margin-bottom: var(--sp-1);
  }

  .team-role {
    font-size: var(--fs-xs);
    color: var(--c-accent);
    font-weight: 500;
    margin-bottom: var(--sp-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .team-bio {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.7;
    font-weight: 400;
    max-width: 280px;
    margin: 0 auto;
  }
</style>
