---
/**
 * PageTransition - GSAP page transition wrapper (legacy, uses global queue)
 */
---

<script>
import { gsap } from 'gsap';

function animatePageEnter() {
  const elements = document.querySelectorAll('.page-enter');

  if (elements.length === 0) {
    gsap.fromTo('main > section',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'expo.out'
      }
    );
    return;
  }

  gsap.fromTo(elements,
    { opacity: 0, y: 30 },
    {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.08,
      ease: 'expo.out'
    }
  );
}

import { runOnPageReady } from '../../lib/animations/gsap-presets';
runOnPageReady(animatePageEnter);
</script>

<slot />
