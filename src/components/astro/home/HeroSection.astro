---
// Hero — NARA sebagai karakter inti yang terintegrasi (grounded spotlight).
// Desktop: teks kiri, NARA kanan (terpusat vertikal).
// Mobile: NARA di atas, teks di bawah.
// Tanpa CTA: satu tombol scroll halus ke section berikutnya.
---

<section class="hero" id="hero-section">
  <div class="hero-bg" aria-hidden="true"></div>

  <svg class="hero-noise-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="hero-noise-fx">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </defs>
    <rect width="100" height="100" filter="url(#hero-noise-fx)" opacity="0.04" style="mix-blend-mode: overlay"/>
  </svg>

  <!-- Decorative elegant floating motifs in main Hero -->
  <div class="hero-motif hero-motif-1" aria-hidden="true">
    <img src="/img/motif/png batik mega mendung.png" class="motif-float-1" alt="" />
  </div>
  <div class="hero-motif hero-motif-2" aria-hidden="true">
    <img src="/img/motif/png ornamen nusantara.png" class="motif-float-2" alt="" />
  </div>
  <div class="hero-motif hero-motif-3" aria-hidden="true">
    <img src="/img/motif/png awan.png" class="motif-float-3" alt="" />
  </div>
  <div class="hero-motif hero-motif-4" aria-hidden="true">
    <img src="/img/motif/png bunga.png" class="motif-float-1" alt="" />
  </div>
  <div class="hero-motif hero-motif-5" aria-hidden="true">
    <img src="/img/motif/png bunga.png" class="motif-float-3" alt="" />
  </div>

  <div class="hero-layout">

    <!-- Kolom NARA — karakter inti, grounded & terpusat -->
    <div class="hero-nara-col">
      <figure class="hero-nara-figure">
        <div class="hero-nara-glow" aria-hidden="true"></div>
        <div class="hero-nara-pedestal" aria-hidden="true"></div>

        <!-- Elegant food arch framing Nara from behind (Grounded visual composition) -->
        <div class="hero-nara-food hero-food-1" aria-hidden="true">
          <img src="/img/makanan/Rendang2.png" alt="Rendang" />
        </div>
        <div class="hero-nara-food hero-food-2" aria-hidden="true">
          <img src="/img/makanan/Sate2.png" alt="Sate" />
        </div>
        <div class="hero-nara-food hero-food-3" aria-hidden="true">
          <img src="/img/makanan/Gado22.png" alt="Gado Gado" />
        </div>
        <div class="hero-nara-food hero-food-4" aria-hidden="true">
          <img src="/img/makanan/Sup Iga.png" alt="Sup Iga" />
        </div>

        <img
          src="/img/nara/NARA 1.png"
          alt="Nara, maskot Kulineria yang menyambutmu"
          class="hero-nara-img"
          width="460"
          height="460"
          draggable="false"
          onerror="this.style.display='none'"
        />
      </figure>
    </div>

    <!-- Kolom teks -->
    <div class="hero-text">
      <span class="hero-label">Kulineria</span>

      <h1 class="hero-title">
        <span class="hero-line hero-line-single">
          <span class="hero-word">Kenali</span>
          <span class="hero-word">Kuliner</span>
          <span class="hero-word">Nusantara</span>
          <span class="hero-word">Bersama</span>
          <span class="hero-word">Nara</span>
        </span>
      </h1>

      <p class="hero-subtitle">
        Bersama Nara, temukan hidangan dari setiap sudut Indonesia. Setiap daerah punya cerita.
      </p>
    </div>

  </div>

  <!-- Tombol scroll ke section berikutnya -->
  <button class="hero-scroll" type="button" aria-label="Mulai jelajahi hidangan">
    <span class="hero-scroll-text">Mulai jelajahi</span>
    <span class="hero-scroll-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </span>
  </button>

</section>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

function initHero() {
  const hero = document.getElementById('hero-section');
  if (!hero || hero.dataset.animated) return;
  hero.dataset.animated = 'true';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 768;

  const bg       = hero.querySelector('.hero-bg');
  const noise    = hero.querySelector('.hero-noise-svg');
  const label    = hero.querySelector('.hero-label');
  const words    = hero.querySelectorAll('.hero-word');
  const sub      = hero.querySelector('.hero-subtitle');
  const nara     = hero.querySelector('.hero-nara-img');
  const glow     = hero.querySelector('.hero-nara-glow');
  const pedestal = hero.querySelector('.hero-nara-pedestal');
  const scroll   = hero.querySelector('.hero-scroll');
  const motifs   = hero.querySelectorAll('.hero-motif');
  const foods    = hero.querySelectorAll('.hero-nara-food');

  if (reduced) {
    gsap.set([bg, noise, label, words, sub, nara, glow, pedestal, scroll, ...Array.from(motifs), ...Array.from(foods)],
      { opacity: 1, y: 0, x: 0, scale: 1, filter: 'blur(0px)' });
    return;
  }

  const tl = gsap.timeline({ defaults: { ease: 'power3.out', overwrite: 'auto' } });

  // 1. Atmosfer & Floating Motifs (Choreographed to feel punchy & responsive)
  tl.fromTo(bg,    { scale: 1.10, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.6, ease: 'power2.out' }, 0)
    .fromTo(noise, { opacity: 0 }, { opacity: 0.8, duration: 2.2 }, 0)
    .fromTo(glow,  { opacity: 0, scale: 0.5 }, { opacity: 1, scale: 1, duration: 1.8, ease: 'power2.out' }, 0.1);

  if (motifs.length > 0) {
    tl.fromTo(motifs,
      { opacity: 0, scale: 0.7, y: 15 },
      { opacity: 1, scale: 1, y: 0, duration: 1.4, stagger: 0.08, ease: 'power2.out' },
      0.2
    );
  }

  // 2. NARA grounded — pedestal lalu maskot naik (staggered & tight transitions)
  if (pedestal) {
    tl.fromTo(pedestal, { opacity: 0, scaleX: 0.35 }, { opacity: 1, scaleX: 1, duration: 0.8, ease: 'power2.out' }, 0.3);
  }
  if (nara) {
    tl.fromTo(nara,
      { y: 70, opacity: 0, scale: 0.90 },
      { y: 0, opacity: 1, scale: 1, duration: 1.3, ease: 'back.out(1.1)' },
      0.4
    );
  }

  // 2b. Floating foods reveal staggering in orbit around Nara
  if (foods.length > 0) {
    tl.fromTo(foods,
      { opacity: 0, scale: 0.6, y: 30 },
      { opacity: 1, scale: 1, y: 0, duration: 1.4, stagger: 0.12, ease: 'back.out(1.3)' },
      0.7
    );
  }

  // 3. Teks — masuk dengan stagger cepat agar responsive dan tidak delay
  tl.fromTo(label, { y: -12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8 }, 0.6)
    .fromTo(words, { y: 60, opacity: 0, filter: 'blur(12px)' }, {
      y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change',
      stagger: isMobile ? 0.05 : 0.07, duration: 1.1,
    }, 0.7)
    .fromTo(sub,  { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 1.0 }, 1.0);

  // 4. Tombol scroll
  if (scroll) {
    tl.fromTo(scroll,
      { opacity: 0, y: 14 },
      { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },
      1.2
    );
  }

  // Float pelan & lembut — mulai setelah entrance selesai
  if (nara) {
    gsap.to(nara, {
      y: -12,
      duration: 5.0,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: 2.0,
    });
  }

  // Parallax — desktop only, halus
  if (!isMobile) {
    gsap.to(bg, {
      y: '10%', scale: 1.05, ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1.2 },
    });
    gsap.to('.hero-text', {
      y: -28, opacity: 0.5, ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.8 },
    });
    gsap.to('.hero-nara-figure', {
      y: -16, ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 },
    });
  }
}

function bindScrollButton() {
  const btn = document.querySelector<HTMLButtonElement>('.hero-scroll');
  if (!btn || btn.dataset.bound) return;
  btn.dataset.bound = 'true';

  btn.addEventListener('click', () => {
    const target = document.getElementById('map-section');
    if (!target) return;
    const w = window as any;
    if (w.lenis?.scrollTo) {
      w.lenis.scrollTo(target, { offset: -72, duration: 1.8 });
    } else {
      const top = target.getBoundingClientRect().top + window.scrollY - 72;
      window.scrollTo({ top, behavior: 'smooth' });
    }
  });
}

import { runOnPageReady } from '../../../lib/animations/gsap-presets';
runOnPageReady(() => {
  initHero();
  bindScrollButton();
});
</script>

<style>
  /* ── Section ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-top: calc(var(--nav-mobile-h) + var(--sp-6));
    padding-bottom: var(--sp-6);
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: var(--nav-h);
      padding-bottom: var(--sp-6);
    }
  }

  /* ── Background ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 78% 58% at 74% 52%, rgba(194, 65, 12, 0.18) 0%, transparent 56%),
      linear-gradient(148deg, #2A1508 0%, #3D2415 32%, #5A3420 66%, #7A4A2E 100%);
    will-change: transform, opacity;
    opacity: 0;
  }
  @media (max-width: 767px) {
    .hero-bg {
      background:
        radial-gradient(ellipse 90% 40% at 50% 30%, rgba(194, 65, 12, 0.18) 0%, transparent 58%),
        linear-gradient(165deg, #2A1508 0%, #3D2415 34%, #5A3420 70%, #7A4A2E 100%);
    }
  }

  .hero-noise-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* ── Main layout ── */
  .hero-layout {
    position: relative;
    z-index: 2;
    flex: 1;                    /* mengisi sisa tinggi hero */
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--page-px);
    /* Desktop: dua kolom sejajar, terpusat vertikal */
    display: flex;
    flex-direction: row;
    align-items: center;        /* vertikal center */
    gap: var(--sp-8);
  }
  @media (min-width: 640px) {
    .hero-layout { padding: 0 32px; }
  }
  @media (min-width: 1024px) {
    .hero-layout { padding: 0 48px; gap: var(--sp-12); }
  }

  /* Desktop: teks kiri (order 2 di HTML → order 1 visual), NARA kanan (order 1 di HTML → order 2 visual) */
  .hero-nara-col { order: 2; flex: 0 0 auto; }
  .hero-text     { order: 1; flex: 1; min-width: 0; }

  /* Mobile: stack — NARA di ATAS, teks di bawah */
  @media (max-width: 767px) {
    .hero-layout {
      flex-direction: column;
      text-align: center;
      gap: var(--sp-4);
      justify-content: center;
      align-items: center;
    }
    .hero-nara-col { order: 1; flex: 0 0 auto; }
    .hero-text     { order: 2; flex: 0 0 auto; }
  }

  /* ── Teks ── */
  .hero-text {
    will-change: transform, opacity;
  }

  .hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: rgba(255, 248, 240, 0.55);
    margin-bottom: var(--sp-5);
    opacity: 0;
  }
  @media (max-width: 767px) {
    .hero-label { margin-bottom: var(--sp-3); }
  }

  .hero-title {
    font-family: var(--ff-display);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.025em;
    margin-bottom: var(--sp-5);
    color: #FFF8F1;
  }
  .hero-line { display: block; }
  .hero-line-single {
    font-size: clamp(1.6rem, 3.8vw, 3rem);
    color: rgba(255, 248, 240, 0.92);
  }
  .hero-line-single .hero-word {
    background: linear-gradient(135deg, #EDD4B4 0%, #C28558 50%, #EDD4B4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .hero-word {
    display: inline-block;
    will-change: transform, opacity, filter;
    opacity: 0;
  }

  .hero-subtitle {
    font-size: clamp(var(--fs-sm), 1.6vw, var(--fs-lg));
    color: rgba(255, 248, 240, 0.65);
    font-weight: 400;
    line-height: 1.7;
    margin-bottom: 0;
    max-width: 440px;
    opacity: 0;
  }
  @media (max-width: 767px) {
    .hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  /* ── NARA kolom ── */
  .hero-nara-col {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(299px, 44vw, 552px);
    flex-shrink: 0;
  }
  @media (max-width: 767px) {
    .hero-nara-col {
      width: min(83vw, 345px);
    }
  }

  .hero-nara-figure {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    will-change: transform;
  }

  /* Glow di belakang maskot */
  .hero-nara-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 96%;
    aspect-ratio: 1;
    transform: translate(-50%, -52%);
    background: radial-gradient(circle, rgba(245, 196, 168, 0.24) 0%, rgba(194, 65, 12, 0.10) 38%, transparent 68%);
    border-radius: 50%;
    will-change: transform, opacity;
    opacity: 0;
    z-index: 0;
  }

  /* Pedestal — grounding shadow */
  .hero-nara-pedestal {
    position: absolute;
    bottom: 4%;
    left: 50%;
    width: 62%;
    height: 34px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(0,0,0,0.42) 0%, rgba(0,0,0,0.18) 45%, transparent 72%);
    border-radius: 50%;
    filter: blur(7px);
    will-change: transform, opacity;
    opacity: 0;
    z-index: 0;
  }

  .hero-nara-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    user-select: none;
    will-change: transform;
    filter: drop-shadow(0 24px 40px rgba(0,0,0,0.45));
    opacity: 0;
  }

  /* ── Tombol scroll ── */
  .hero-scroll {
    position: relative;
    z-index: 4;
    align-self: center;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    margin: 0 auto;
    padding: var(--sp-2) var(--sp-4);
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgba(255, 248, 240, 0.7);
    opacity: 0;
    transition: color 0.3s var(--ease-smooth);
    -webkit-tap-highlight-color: transparent;
  }
  .hero-scroll-text {
    font-family: var(--ff-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .hero-scroll-text { display: none; }
  }
  .hero-scroll-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--r-full);
    border: 1.5px solid rgba(255, 248, 240, 0.25);
    transition: border-color 0.3s var(--ease-smooth), background 0.3s var(--ease-smooth);
  }
  .hero-scroll-icon svg {
    animation: heroScrollBounce 3.2s ease-in-out infinite;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-scroll:hover { color: #FFF8F1; }
    .hero-scroll:hover .hero-scroll-icon {
      border-color: rgba(255, 248, 240, 0.6);
      background: rgba(255, 248, 240, 0.08);
    }
  }
  .hero-scroll:active { transform: scale(0.96); }
  .hero-scroll:focus-visible { outline: none; }
  .hero-scroll:focus-visible .hero-scroll-icon {
    border-color: var(--c-accent-soft, #F5C4A8);
    box-shadow: 0 0 0 4px rgba(245, 196, 168, 0.25);
  }

  @keyframes heroScrollBounce {
    0%, 100% { transform: translateY(-3px); }
    50%       { transform: translateY(4px); }
  }

  /* ── Elegant Decorative Motifs (Subtle Watermarks) ── */
  .hero-motif {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    opacity: 0;
  }

  /* 1. Top-Left Mega Mendung */
  .hero-motif-1 {
    top: 6%;
    left: -4%;
    width: clamp(140px, 22vw, 320px);
  }
  .hero-motif-1 img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.5) sepia(0.35) saturate(0.6) contrast(1.1);
    opacity: 0.05; /* Reduced from 0.12 to 0.05 for refined premium subtlety */
  }

  /* 2. Top-Right Nusantara Ornament */
  .hero-motif-2 {
    top: 8%;
    right: 5%;
    width: clamp(100px, 16vw, 220px);
  }
  .hero-motif-2 img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.4) sepia(0.4) saturate(0.7) contrast(1.1);
    opacity: 0.03; /* Reduced from 0.08 to 0.03 */
  }

  /* 3. Mid-Left Plain Cloud */
  .hero-motif-3 {
    top: 50%;
    left: 2%;
    width: clamp(90px, 12vw, 160px);
  }
  .hero-motif-3 img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.5) sepia(0.35) saturate(0.5) contrast(1.1);
    opacity: 0.03; /* Reduced from 0.07 to 0.03 */
  }

  /* 4. Bottom-Right Flower */
  .hero-motif-4 {
    bottom: 10%;
    right: -3%;
    width: clamp(130px, 18vw, 250px);
  }
  .hero-motif-4 img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.4) sepia(0.3) saturate(0.7) contrast(1.1);
    opacity: 0.04; /* Reduced from 0.11 to 0.04 */
  }

  /* 5. Bottom-Left Small Flower */
  .hero-motif-5 {
    bottom: 12%;
    left: -2%;
    width: clamp(80px, 10vw, 140px);
  }
  .hero-motif-5 img {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(1.4) sepia(0.3) saturate(0.6) contrast(1.1);
    opacity: 0.03; /* Reduced from 0.09 to 0.03 */
  }

  @media (max-width: 767px) {
    .hero-motif-1 { top: 3%; left: -6%; width: 110px; }
    .hero-motif-2 { top: 5%; right: -2%; width: 90px; }
    .hero-motif-3 { display: none; }
    .hero-motif-4 { bottom: 18%; right: -4%; width: 100px; }
    .hero-motif-5 { bottom: 12%; left: -3%; width: 80px; }
  }

  /* ── Grounded Food Arch behind Nara ── */
  .hero-nara-food {
    position: absolute;
    z-index: 2; /* Floats standardly in front of Nara's background */
    pointer-events: none;
    user-select: none;
    will-change: transform, opacity;
    opacity: 0; /* Animated on entrance */
  }

  .hero-nara-food img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.4)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.15));
  }

  /* Food 1: Top-Left (Rendang) */
  .hero-food-1 {
    top: 5%;
    left: -12%;
    width: clamp(75px, 16vw, 130px);
  }

  /* Food 2: Top-Right (Sate) */
  .hero-food-2 {
    top: 8%;
    right: -10%;
    width: clamp(80px, 17vw, 140px);
  }

  /* Food 3: Mid-Left (Gado Gado) */
  .hero-food-3 {
    bottom: 22%;
    left: -10%;
    width: clamp(75px, 16vw, 130px);
  }

  /* Food 4: Bottom-Right (Sup Iga) */
  .hero-food-4 {
    bottom: 12%;
    right: -12%;
    width: clamp(80px, 17vw, 140px);
  }

  @media (max-width: 767px) {
    .hero-food-1 { left: -8%; top: 4%; width: clamp(55px, 18vw, 80px); }
    .hero-food-2 { right: -6%; top: 8%; width: clamp(60px, 19vw, 85px); }
    .hero-food-3 { left: -6%; bottom: 18%; width: clamp(55px, 18vw, 80px); }
    .hero-food-4 { right: -8%; bottom: 12%; width: clamp(60px, 19vw, 85px); }
  }

  /* Staggered high-performance floating animations */
  @keyframes heroFloat {
    0% {
      transform: translateY(0) translateX(0) rotate(var(--base-rot, 0deg));
    }
    50% {
      transform: translateY(-10px) translateX(5px) rotate(calc(var(--base-rot, 0deg) + 2.5deg));
    }
    100% {
      transform: translateY(0) translateX(0) rotate(var(--base-rot, 0deg));
    }
  }

  .motif-float-1 {
    --base-rot: 0deg;
    animation: heroFloat 7s ease-in-out infinite;
  }

  .motif-float-2 {
    --base-rot: 15deg;
    animation: heroFloat 9s ease-in-out infinite;
    animation-delay: -3s;
  }

  .motif-float-3 {
    --base-rot: -10deg;
    animation: heroFloat 8s ease-in-out infinite;
    animation-delay: -5s;
  }

  @media (prefers-reduced-motion: reduce) {
