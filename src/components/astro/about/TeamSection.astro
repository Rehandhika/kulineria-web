---
import { getCollection } from 'astro:content';

const teamMembers = await getCollection('team');
const sorted = teamMembers.sort((a: any, b: any) => a.data.order - b.data.order);
---

<section class="team" id="about-team">
  <!-- Batik latar — repeat HD texture -->
  <div class="team-batik" aria-hidden="true"></div>

  <div class="container">
    <div class="team-container">
      <h2 class="team-title">Tim di Balik Kulineria</h2>

      <div class="team-grid">
        {
          sorted.map((member: any) => {
            return (
              <article class="team-card">
                <div class="team-card-top">
                  <div class="team-avatar-wrap">
                    <img
                      src={member.data.photo || "/img/nara/NARA 1.png"}
                      alt={member.data.name}
                      class:list={[
                        "team-avatar-img",
                        { "scale-112": member.data.name.toLowerCase().includes("rehandhika") }
                      ]}
                      width="140"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                </div>
                <div class="team-card-body">
                  <h3>{member.data.name}</h3>
                  <p class="team-role">{member.data.role}</p>
                  {member.data.socials?.find((s: any) => s.platform === 'instagram') && (
                    <a
                      href={member.data.socials.find((s: any) => s.platform === 'instagram').url}
                      class="team-social-icon"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Instagram"
                    >
                      <svg width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path fill="var(--brown-500)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTeam() {
    const cards = document.querySelectorAll('.team-card');
    if (!cards.length) return;

    gsap.set(cards, { y: 40, opacity: 0, filter: 'blur(8px)' });

    ScrollTrigger.refresh();

    const tl = gsap.to(cards, {
      y: 0,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 1.2,
      stagger: 0.2,
      ease: 'power2.out',
      clearProps: 'filter,y',
      scrollTrigger: { trigger: '.team-grid', start: 'top 85%' },
    });

    // Fallback: ensure cards visible after 5s whether scroll-trigger fired or not
    setTimeout(() => {
      if (tl.progress() < 1) {
        gsap.set(cards, { y: 0, opacity: 1, clearProps: 'y' });
      }
    }, 5000);

    // Tilt effect per card
    cards.forEach((card) => {
      card.addEventListener('mousemove', (ev: Event) => {
        const e = ev as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        gsap.to(card, {
          rotateY: x * 10,
          rotateX: -y * 10,
          duration: 0.3,
          ease: 'power2.out',
          transformPerspective: 1000,
        });
        const avatar = card.querySelector('.team-avatar-wrap');
        if (avatar) {
          gsap.to(avatar, {
            y: -8,
            scale: 1.08,
            duration: 0.3,
            ease: 'power2.out',
          });
        }
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          rotateY: 0,
          rotateX: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.5)',
        });
        const avatar = card.querySelector('.team-avatar-wrap');
        if (avatar) {
          gsap.to(avatar, {
            y: 0,
            scale: 1,
            duration: 0.4,
            ease: 'elastic.out(1, 0.5)',
          });
        }
      });
    });
  }

  import { runOnPageReady } from '../../../lib/animations/gsap-presets';
  runOnPageReady(initTeam);
</script>

<style>
  .team {
    position: relative;
    overflow: hidden;
    padding-top: clamp(72px, 11vw, 152px);
    padding-bottom: clamp(64px, 9vw, 128px);
    /* Make section background transparent or white to let container pop, or keep original */
    background: transparent;
  }
  .team .container {
    position: relative;
    z-index: 1;
  }

  .team-batik {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.22;
    filter: sepia(0.35) saturate(0.5) brightness(0.85);
    background-image: url('/img/motif/png batik.png');
    background-repeat: repeat;
    background-size: 220px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 80px, black calc(100% - 80px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 80px, black calc(100% - 80px), transparent 100%);
  }

  .team-container {
    background: var(--c-bg); /* Use the warm parchment background */
    border: 1px solid var(--brown-700);
    border-radius: var(--r-3xl);
    padding: var(--sp-8) var(--sp-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-8);
  }

  .team-title {
    font-family: var(--ff-display);
    font-size: var(--fs-3xl);
    font-weight: 800;
    color: var(--brown-800);
    text-align: center;
    margin: 0;
  }

  .team-grid {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: var(--sp-4);
    margin: 0 calc(var(--page-px) * -1);
    padding: var(--sp-4) var(--page-px) var(--sp-2);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    width: 100%;
    justify-content: flex-start;
  }
  .team-grid::-webkit-scrollbar {
    display: none;
  }

  .team-card {
    flex: 0 0 75%;
    scroll-snap-align: center;
    padding: var(--sp-8) var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-2xl);
    box-shadow: var(--sh-2);
    cursor: default;
    will-change: transform, opacity;
    opacity: 0;
    transition: box-shadow 0.3s var(--ease-smooth), border-color 0.3s var(--ease-smooth);
  }
  @media (hover: hover) and (pointer: fine) {
    .team-card:hover {
      box-shadow: var(--sh-card-hover);
      border-color: var(--c-border-strong);
    }
  }

  @media (min-width: 768px) {
    .team-container {
      padding: var(--sp-16) var(--sp-12);
      border-radius: 48px;
    }
    .team-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      margin: 0;
      padding: var(--sp-2) 0 0;
      gap: var(--sp-6);
      scroll-snap-type: none;
      justify-content: center;
    }
    .team-card {
      flex: none;
      scroll-snap-align: none;
      padding: var(--sp-10) var(--sp-6);
      max-width: 300px;
    }
  }

  /* ── Avatar ── */
  .team-card-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-2);
  }

  .team-avatar-wrap {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-surface);
    border: 1px solid var(--brown-300);
    overflow: hidden;
    transition: transform 0.3s var(--ease-bounce);
    will-change: transform;
  }
  .team-card:hover .team-avatar-wrap {
    transform: scale(1.06);
  }

  .team-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    transition: transform 0.3s var(--ease-bounce);
  }
  .team-avatar-img.scale-112 {
    transform: scale(1.12);
  }

  /* ── Body ── */
  .team-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (max-width: 767px) {
    .team-card-body {
      flex: 1;
      width: 100%;
    }
  }

  .team-card h3 {
    font-family: var(--ff-body);
    font-size: var(--fs-lg);
    font-weight: 800;
    color: var(--brown-800);
    line-height: 1.2;
    margin-bottom: var(--sp-1);
  }


  .team-role {
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--brown-500);
    margin-bottom: 0;
  }

  .team-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    padding: 0;
    transition: transform 0.3s var(--ease-smooth), opacity 0.3s var(--ease-smooth);
    opacity: 0.85;
    flex-shrink: 0;
  }
  .team-social-icon svg {
    display: block;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }
  @media (max-width: 767px) {
    .team-social-icon {
      margin-top: auto;
    }
  }
  @media (min-width: 768px) {
    .team-social-icon {
      margin-top: var(--sp-4);
    }
  }

  .team-social-icon:hover {
    transform: translateY(-3px) scale(1.12);
    opacity: 1;
  }
</style>
