---
---

<section class="about-hero">
  <div class="about-hero-bg">
    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1400&q=80" alt="" class="about-hero-img" loading="eager" />
    <div class="about-hero-overlay"></div>
    <div class="about-hero-pattern"></div>
  </div>
  <div class="about-hero-content">
    <span class="about-hero-badge">Tentang Kulineria</span>
    <h1 class="about-hero-title">
      <span class="word">Surat</span>
      <span class="word">Cinta</span>
      <span class="word">untuk</span>
      <span class="word gradient-text-warm">Kuliner</span>
      <span class="word gradient-text-warm">Nusantara</span>
    </h1>
    <p class="about-hero-subtitle">
      510+ hidangan, 6 wilayah, 1 kepulauan — perjalanan kuliner Nusantara
    </p>
  </div>
</section>

<style>
  .about-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-12)) var(--sp-4) var(--sp-12);
  }
  @media (min-width: 768px) {
    .about-hero {
      min-height: 80vh;
      padding: calc(var(--nav-h) + var(--sp-16)) var(--sp-4) var(--sp-16);
    }
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .about-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) brightness(0.7);
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg,
      rgba(248, 242, 234, 0.92) 0%,
      rgba(248, 242, 234, 0.85) 50%,
      rgba(255, 253, 247, 0.90) 100%
    );
  }
  .about-hero-pattern {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(122, 92, 58, 0.06) 0%, transparent 50%);
  }

  .about-hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
  }

  .about-hero-badge {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255, 253, 247, 0.9);
    backdrop-filter: blur(8px);
    border: 2px solid var(--c-brand-caramel);
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: 800;
    color: var(--c-brand-mocha-dark);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--sp-5);
  }

  .about-hero-title {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--c-text-1);
    margin-bottom: var(--sp-5);
    letter-spacing: -0.02em;
  }
  .about-hero-title .word {
    display: inline-block;
    margin-right: 0.2em;
  }

  .about-hero-subtitle {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    line-height: 1.6;
    font-weight: 600;
    max-width: 500px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .about-hero-subtitle {
      font-size: var(--fs-lg);
    }
  }
</style>
