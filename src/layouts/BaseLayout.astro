---
import TopNav from '../components/astro/nav/TopNav.astro';
import SeoMeta from '../components/astro/shared/SeoMeta.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  seoProps?: {
    type?: 'website' | 'article' | 'recipe';
    keywords?: string[];
    recipe?: {
      name: string;
      description: string;
      prepTime: number;
      cookTime: number;
      servings: number;
      category: string;
      cuisine: string;
      ingredients: string[];
      image?: string;
    };
  };
}

const { title, description = 'Kulineria - Atlas Kuliner Indonesia', seoProps = {} } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800;9..144,900&family=Google+Sans+Flex:opsz,wght@6..144,300..900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800;9..144,900&family=Google+Sans+Flex:opsz,wght@6..144,300..900&display=swap" rel="stylesheet" />
    </noscript>

    <SeoMeta title={title} description={description} type={seoProps.type} keywords={seoProps.keywords} recipe={seoProps.recipe} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <TopNav />

    <main id="main-content">
      <slot />
    </main>

    <!--
      3 layer curtain wipe.

      PENDEKATAN BENAR:
      Setiap layer adalah satu <div> tunggal yang tingginya 100vh + 120px
      (ruang ekstra untuk ombak atas 60px + ombak bawah 60px).
      Posisi awal: top = -60px (ombak atas sudah di dalam div).
      GSAP menggerakkan dengan translateY dalam pixel — bukan yPercent —
      sehingga semua bagian (body + ombak) bergerak sebagai satu unit.

      Posisi awal (tersembunyi di bawah): translateY(100vh)
      Posisi tengah (menutupi layar):     translateY(-60px)  ← ombak atas pas di tepi atas viewport
      Posisi akhir (keluar ke atas):      translateY(calc(-100vh - 120px))
    -->

    <!-- Layer 1: caramel -->
    <div class="pt-layer" id="pt-l1" aria-hidden="true">
      <svg class="pt-wave pt-wave-top" viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path d="M0,60 C150,20 300,55 450,30 C600,5 750,50 900,25 C1050,0 1150,40 1200,20 L1200,60 Z" fill="#C49A6E"/>
      </svg>
      <div class="pt-body"></div>
      <svg class="pt-wave pt-wave-bot" viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path d="M0,0 C150,40 300,5 450,30 C600,55 750,10 900,35 C1050,60 1150,20 1200,40 L1200,0 Z" fill="#C49A6E"/>
      </svg>
    </div>

    <!-- Layer 2: cinnamon -->
    <div class="pt-layer" id="pt-l2" aria-hidden="true">
      <svg class="pt-wave pt-wave-top" viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path d="M0,60 C200,15 350,50 550,22 C750,0 900,45 1050,18 C1130,5 1170,35 1200,15 L1200,60 Z" fill="#B8734A"/>
      </svg>
      <div class="pt-body"></div>
      <svg class="pt-wave pt-wave-bot" viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path d="M0,0 C200,45 350,10 550,38 C750,60 900,15 1050,42 C1130,55 1170,25 1200,45 L1200,0 Z" fill="#B8734A"/>
      </svg>
    </div>

    <!-- Layer 3: mocha dark -->
    <div class="pt-layer" id="pt-l3" aria-hidden="true">
      <svg class="pt-wave pt-wave-top" viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path d="M0,60 C100,25 280,55 480,18 C680,0 850,48 1000,20 C1100,5 1160,38 1200,22 L1200,60 Z" fill="#5A3E22"/>
      </svg>
      <div class="pt-body"></div>
      <svg class="pt-wave pt-wave-bot" viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path d="M0,0 C100,35 280,5 480,42 C680,60 850,12 1000,40 C1100,55 1160,22 1200,38 L1200,0 Z" fill="#5A3E22"/>
      </svg>
    </div>

    <!-- Lenis + Page Animation Orchestrator -->
    <script>
      import { initSmoothScroll, refreshSmoothScroll, destroySmoothScroll } from '../lib/animations/scroll-smoother';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { cleanupAnimations } from '../lib/animations/gsap-presets';

      gsap.registerPlugin(ScrollTrigger);

      function initGlobalSmoothScroll() {
        initSmoothScroll({ duration: 1.5, wheelMultiplier: 1, touchMultiplier: 1.5 });
        requestAnimationFrame(() => ScrollTrigger.refresh());
      }

      document.addEventListener('DOMContentLoaded', initGlobalSmoothScroll);

      /* ─── PAGE ANIMATION ORCHESTRATOR ───────────────────────────────
       *
       * Three-layer defense untuk memastikan animasi jalan di setiap navigasi:
       *
       * 1. Persistent listener (swup:page:view) — components daftar listener
       *    saat module pertama kali load. Listener persist, handle semua
       *    navigasi setelahnya.
       *
       * 2. Queue backup (__pageAnimate[]) — untuk race condition saat
       *    module ES async belum selesai loading ketika swup:page:view fire.
       *    Component push init function ke queue. Orchestrator process queue
       *    + polling 50ms selama 2s.
       *
       * 3. Safety timeout (4s) — di masing-masing component, force-show
       *    content jika inisialisasi gagal.
       *
       * Orchestrator juga cleanup GSAP/ScrollTrigger dari halaman
       * sebelumnya + reinit Lenis setiap navigasi.
       * ─────────────────────────────────────────────────────────────── */

      window.__pageAnimate = window.__pageAnimate || [];

      function processPageAnimations() {
        const queue = window.__pageAnimate || [];
        while (queue.length) {
          const fn = queue.shift();
          if (typeof fn === 'function') setTimeout(fn, 80);
        }
      }

      function onPageView() {
        cleanupAnimations();

        destroySmoothScroll();
        requestAnimationFrame(() => {
          initGlobalSmoothScroll();
          refreshSmoothScroll();
        });

        processPageAnimations();

        let polls = 0;
        const pollTimer = setInterval(() => {
          processPageAnimations();
          if (polls++ > 40) clearInterval(pollTimer);
        }, 50);
      }

      document.addEventListener('swup:page:view', onPageView);
    </script>

    <!-- Curtain wipe: 3-layer wave via Swup JS hooks + GSAP -->
    <script>
      import { gsap } from 'gsap';

      const WAVE_H = 60;
      // Buffer ekstra untuk mobile — address bar dinamis bisa buat innerHeight
      // lebih kecil dari 100vh CSS. 150px buffer memastikan layer selalu tersembunyi.
      const BUFFER = 150;

      const l1 = document.getElementById('pt-l1')!;
      const l2 = document.getElementById('pt-l2')!;
      const l3 = document.getElementById('pt-l3')!;

      function getY() {
        const vh = (window.visualViewport?.height ?? window.innerHeight) + BUFFER;
        return {
          hidden:  vh + WAVE_H,
          covered: 0,
          gone:    -(vh + WAVE_H * 2),
        };
      }

      gsap.set([l1, l2, l3], { y: getY().hidden });

      function setupSwupHooks() {
        const swup = (window as any).swup;
        if (!swup) return;

        swup.hooks.replace('animation:out:await', () =>
          new Promise<void>((resolve) => {
            const { hidden, covered } = getY();
            gsap.set([l1, l2, l3], { y: hidden });

            // Out: layer paling gelap nutup duluan (depth effect)
            const tl = gsap.timeline({ onComplete: resolve });
            tl.to(l3, { y: covered, duration: 0.35, ease: 'power3.in' }, 0);
            tl.to(l2, { y: covered, duration: 0.4, ease: 'power3.inOut' }, 0.08);
            tl.to(l1, { y: covered, duration: 0.45, ease: 'power3.inOut' }, 0.16);
          })
        );

        swup.hooks.replace('animation:in:await', () =>
          new Promise<void>((resolve) => {
            const { gone, hidden } = getY();

            const tl = gsap.timeline({
              onComplete: () => {
                gsap.set([l1, l2, l3], { y: hidden });
                resolve();
              },
            });
            // In: layer terang (caramel) pergi duluan, mocha nyusul
            tl.to(l1, { y: gone, duration: 0.5, ease: 'power4.inOut' }, 0);
            tl.to(l2, { y: gone, duration: 0.5, ease: 'power4.inOut' }, 0.1);
            tl.to(l3, { y: gone, duration: 0.5, ease: 'power4.inOut' }, 0.2);
          })
        );
      }

      if ((window as any).swup) {
        setupSwupHooks();
      } else {
        document.addEventListener('swup:enable', setupSwupHooks, { once: true });
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .skip-link:focus {
    position: absolute;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    top: 1rem;
    left: 1rem;
    z-index: 500;
    background: #fff;
    color: #000;
    border-radius: 0.375rem;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  /* ─── 3 Layer curtain ───────────────────────────────────────────────────
   *
   * PENDEKATAN BENAR:
   * Setiap layer adalah satu div tunggal yang tingginya 100vh + 120px.
   * Posisi: fixed, top: -60px (ombak atas sudah di dalam div).
   * GSAP menggerakkan dengan y pixel — bukan yPercent — sehingga
   * semua bagian bergerak sebagai satu unit yang konsisten.
   *
   * Struktur dalam setiap layer:
   *   .pt-wave-top  : SVG ombak atas (60px)
   *   .pt-body      : area solid (100vh)
   *   .pt-wave-bot  : SVG ombak bawah (60px)
   *
   * z-index di atas navbar (--z-nav: 200) dan semua UI lainnya.
   * ─────────────────────────────────────────────────────────────────── */

  .pt-layer {
    position: fixed;
    top: -60px;
    left: 0;
    width: 100%;
    /* 100dvh = dynamic viewport height, akurat di mobile saat address bar muncul/hilang.
       + 120px untuk ombak atas + bawah. + 150px buffer ekstra untuk keamanan mobile. */
    height: calc(100dvh + 270px);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    will-change: transform;
    overflow: hidden;
  }

  .pt-layer .pt-wave {
    width: 100%;
    height: 60px;
    flex-shrink: 0;
    display: block;
  }

  .pt-layer .pt-body {
    flex: 1;                           /* mengisi sisa ruang = 100vh */
  }

  /* Warna solid per layer */
  #pt-l1 { z-index: 9996; }
  #pt-l1 .pt-body { background: #C49A6E; }

  #pt-l2 { z-index: 9997; }
  #pt-l2 .pt-body { background: #B8734A; }

  #pt-l3 { z-index: 9998; }
  #pt-l3 .pt-body { background: #5A3E22; }

  /* ─── Lenis ─────────────────────────────────────────────────────────── */
  html:not(.lenis) { overflow: auto; }
  html:not(.lenis) body { overflow-x: hidden; overflow-y: auto; }
</style>
