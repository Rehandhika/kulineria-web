---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/astro/shared/Footer.astro';
import FooterCTA from '../../components/astro/shared/FooterCTA.astro';
import { getFoodByIdFull, getAllFoods, getRegions, isRealContent } from '../../lib/data/loaders';

import HeroCinematic from '../../components/react/food-detail/HeroCinematic';
import StorySection from '../../components/react/food-detail/StorySection';
import IngredientsGrid from '../../components/react/food-detail/IngredientsGrid';
import RecipeStepper from '../../components/react/food-detail/RecipeStepper';
import NutritionBars from '../../components/react/food-detail/NutritionBars';
import LocationMiniMap from '../../components/react/food-detail/LocationMiniMap';
import RelatedCarousel from '../../components/react/food-detail/RelatedCarousel';

export async function getStaticPaths() {
  const foods = getAllFoods();
  return foods.map(food => ({
    params: { id: food.id },
    props: { food },
  }));
}

const { food } = Astro.props;
const fullFood = getFoodByIdFull(food.id);
const regions = getRegions();
const region = regions.find(r => r.id === food.region);
const regionName = region?.name || food.region;
const showStory = fullFood ? isRealContent(fullFood) : false;

const relatedFoods = (fullFood?.related || [])
  .map(id => getAllFoods().find(f => f.id === id))
  .filter((f): f is NonNullable<typeof f> => f !== undefined)
  .slice(0, 8);
---

<BaseLayout title={food.name} description={food.description}
  seoProps={{
    type: 'recipe',
    keywords: fullFood?.tags || [food.region, ...food.taste],
    recipe: fullFood?.recipe ? {
      name: food.name,
      description: food.description,
      prepTime: fullFood.recipe.prepTime,
      cookTime: fullFood.recipe.cookTime,
      servings: fullFood.recipe.servings,
      category: food.type,
      cuisine: 'Indonesian',
      ingredients: (fullFood.ingredients || []).map(i => `${i.qty || ''} ${i.name}`.trim()),
      image: fullFood.hero?.image,
    } : undefined,
  }}
>

  <!-- SECTION 1: HERO COMPACT (QuickFacts + Breadcrumb inside) -->
  <HeroCinematic client:visible food={fullFood || food} regionName={regionName} />

  <!-- SECTION 2: RASA & GIZI -->
  {fullFood?.nutrition && (
    <section class="section rasa-gizi-section">
      <div class="container">
        <div class="rasa-gizi-card">
          <h2 class="section-title">Informasi Gizi</h2>
          <NutritionBars client:visible nutrition={fullFood.nutrition} />
        </div>
      </div>
    </section>
  )}

  <!-- SECTION 3: BAHAN & CARA MEMBUAT -->
  {(fullFood?.ingredients && fullFood.ingredients.length > 0) || (fullFood?.recipe && fullFood.recipe.steps.length > 0) ? (
    <section class="section bahan-section">
      <div class="container">
        <h2 class="section-title">Bahan &amp; Cara Membuat</h2>
        {fullFood?.ingredients && fullFood.ingredients.length > 0 && (
          <div class="bahan-subsection">
            <h3 class="subsection-title">Bahan-Bahan</h3>
            <IngredientsGrid client:visible ingredients={fullFood.ingredients} />
          </div>
        )}
        {fullFood?.recipe && fullFood.recipe.steps.length > 0 && (
          <div class="bahan-subsection">
            <h3 class="subsection-title">Langkah-Langkah</h3>
            <RecipeStepper
              client:visible
              steps={fullFood.recipe.steps}
              servings={fullFood.recipe.servings}
            />
          </div>
        )}
      </div>
    </section>
  ) : null}

  <!-- SECTION 4: CERITA (hanya jika data real) -->
  {showStory && fullFood?.story && (
    <section class="section cerita-section">
      <div class="container">
        <StorySection
          client:visible
          headline={fullFood.story.headline}
          body={fullFood.story.body}
          pullQuote={fullFood.story.pullQuote}
          image={fullFood.story.image}
        />
      </div>
    </section>
  )}

  <!-- SECTION 5: JELAJAHI (Quiz + Lokasi + Terkait) -->
  <section class="section jelajahi-section">
    <div class="container">
      <div class="jelajahi-grid">
        <div class="quiz-cta-card">
          <h2 class="quiz-cta-title">Uji Pengetahuanmu!</h2>
          <p class="quiz-cta-subtitle">Tebak nama atau asal makanan berdasarkan gambar</p>
          <a href="/quiz" class="quiz-cta-link">
            Mulai Kuis
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        {fullFood?.locations && fullFood.locations.length > 0 && (
          <LocationMiniMap
            client:idle
            locations={fullFood.locations}
            center={[fullFood.locations[0].lng, fullFood.locations[0].lat]}
          />
        )}
      </div>
    </div>
  </section>

  {relatedFoods.length > 0 && (
    <section class="section related-section-wrapper">
      <div class="container">
        <RelatedCarousel client:visible foods={relatedFoods} currentId={food.id} />
      </div>
    </section>
  )}

  <FooterCTA regionName={regionName} regionId={food.region} />

  <Footer />
</BaseLayout>

<style is:global>
  .section { padding: var(--sp-12) 0; }
  .section-title {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: var(--ls-tight);
    color: var(--c-text-1);
    margin-bottom: var(--sp-6);
  }
  .subsection-title {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    margin-bottom: var(--sp-4);
    color: var(--c-text-1);
  }
  .bahan-subsection { margin-bottom: var(--sp-8); }
  .bahan-subsection:last-child { margin-bottom: 0; }

  .hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero { min-height: 55vh; }
  }
  @media (min-width: 1024px) {
    .hero { min-height: 60vh; align-items: center; }
  }
  .hero-image { position: absolute; inset: 0; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.15) 100%);
  }
  .hero-content {
    position: relative; z-index: 1;
    width: 100%; max-width: var(--container-max); margin: 0 auto;
    padding: var(--sp-4) var(--sp-6) var(--sp-6);
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  @media (min-width: 768px) {
    .hero-content { padding: var(--sp-8) var(--sp-10) var(--sp-10); }
  }

  .hero-breadcrumb {
    font-size: var(--fs-xs); font-weight: 600;
    display: flex; align-items: center; gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .hero-breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; }
  .hero-breadcrumb a:hover { color: #fff; }
  .hero-breadcrumb-sep { color: rgba(255,255,255,0.4); }
  .hero-breadcrumb-current { color: rgba(255,255,255,0.9); font-weight: 700; }

  .hero-content-inner { max-width: 700px; }
  .hero-badge {
    display: inline-block; padding: 4px 12px;
    border-radius: var(--r-full); font-size: var(--fs-xs); font-weight: 700;
    color: #fff; text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: var(--sp-2);
  }
  .hero-title {
    font-family: var(--ff-display);
    font-size: var(--fs-hero); font-weight: 700;
    line-height: var(--lh-tight); color: #fff;
    margin-bottom: var(--sp-2);
  }
  .hero-subtitle {
    font-size: var(--fs-base); color: rgba(255,255,255,0.8);
    max-width: 550px; line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-3);
  }
  .hero-actions { display: flex; gap: var(--sp-2); }
  .btn-icon {
    width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
    border-radius: 50%; background: rgba(255,255,255,0.2); color: #fff;
    backdrop-filter: blur(8px); transition: all var(--dur-fast) var(--ease-ui);
    border: 1px solid rgba(255,255,255,0.3);
  }
  .btn-icon:hover { background: rgba(255,255,255,0.3); transform: scale(1.1); }
  .hero-skeleton { position: absolute; inset: 0; background: var(--c-surface-2); z-index: 0; }
  .hero-img-skeleton {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent 25%, rgba(255,255,255,0.15) 50%, transparent 75%);
    background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; z-index: 0;
  }

  .hero-quickfacts {
    display: flex; flex-wrap: wrap; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: rgba(0,0,0,0.4); backdrop-filter: blur(8px);
    border-radius: var(--r-lg);
    margin-top: var(--sp-2);
  }
  .hero-quickfact {
    display: inline-flex; align-items: center; gap: var(--sp-1);
    padding: 4px 12px; border-radius: var(--r-full);
    background: rgba(255,255,255,0.1);
    font-size: var(--fs-xs); font-weight: 600;
    color: rgba(255,255,255,0.9);
    border: 1.5px solid rgba(255,255,255,0.2);
  }
  .hero-qf-dot { width: 6px; height: 6px; border-radius: 50%; }
  .hero-taste-chip { background: rgba(255,255,255,0.15); }
  .hero-taste-level {
    display: inline-block; padding: 1px 6px; border-radius: var(--r-full);
    background: rgba(255,255,255,0.2); font-size: 10px; font-weight: 700;
    margin-left: 2px;
  }
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .rasa-gizi-section { background: var(--c-surface); }
  .rasa-gizi-card {
    padding: var(--sp-6);
    background: var(--c-surface);
    border-radius: var(--r-xl);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    box-shadow: var(--sh-cartoon);
  }

  .bahan-section { background: var(--c-bg); }
  .cerita-section { background: var(--c-surface); }

  .jelajahi-section { background: var(--c-bg); }
  .jelajahi-grid {
    display: grid; grid-template-columns: 1fr; gap: var(--sp-8);
  }
  @media (min-width: 1024px) {
    .jelajahi-grid { grid-template-columns: 1fr 1fr; }
  }

  .quiz-cta-card {
    padding: var(--sp-6);
    background: var(--c-surface);
    border-radius: var(--r-xl);
    border: var(--cartoon-stroke) solid var(--c-accent-soft);
    box-shadow: var(--sh-cartoon);
    display: flex; flex-direction: column; align-items: flex-start;
    gap: var(--sp-3);
  }
  .quiz-cta-title {
    font-family: var(--ff-display);
    font-size: var(--fs-xl); font-weight: 700;
  }
  .quiz-cta-subtitle { font-size: var(--fs-sm); color: var(--c-text-2); }
  .quiz-cta-link {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    padding: 10px 24px;
    background: var(--c-accent); color: #fff; font-weight: 700;
    border-radius: var(--r-full);
    transition: all var(--dur-base) var(--ease-ui);
  }
  .quiz-cta-link:hover {
    background: var(--c-accent-hover);
    transform: translateY(-2px); box-shadow: var(--sh-3);
  }

  .related-section-wrapper { background: var(--c-surface); }

  .ingredients-list {
    display: flex; flex-direction: column; gap: var(--sp-2);
  }
  .ingredient-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--c-border-soft);
  }
  .ingredient-row:last-child { border-bottom: none; }
  .ingredient-bullet {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--c-accent); flex-shrink: 0;
  }
  .ingredient-name { font-weight: 600; font-size: var(--fs-sm); }
  .ingredient-qty {
    margin-left: auto; font-size: var(--fs-xs);
    color: var(--c-text-3); font-weight: 600;
  }
  .ingredient-badge {
    padding: 2px 8px; border-radius: var(--r-full);
    background: var(--c-accent-light); color: var(--c-accent);
    font-size: var(--fs-xs); font-weight: 700;
    border: 1px solid var(--c-accent-soft);
  }

  .recipe-accordion { display: flex; flex-direction: column; gap: var(--sp-2); }
  .recipe-servings { font-size: var(--fs-sm); color: var(--c-text-2); margin-bottom: var(--sp-3); font-weight: 600; }
  .recipe-step {
    border-radius: var(--r-lg);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    background: var(--c-surface);
    overflow: hidden;
  }
  .recipe-step--open { border-color: var(--c-accent); }
  .recipe-step-header {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    width: 100%; cursor: pointer;
    background: none; border: none;
    font-size: inherit; text-align: left;
    transition: background var(--dur-fast) var(--ease-ui);
  }
  .recipe-step-header:hover { background: var(--c-accent-light); }
  .recipe-step-number {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--c-text-1); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: var(--fs-xs); font-weight: 700; flex-shrink: 0;
  }
  .recipe-step--open .recipe-step-number { background: var(--c-accent); }
  .recipe-step-title { font-weight: 700; font-size: var(--fs-sm); flex: 1; }
  .recipe-step-duration {
    font-size: var(--fs-xs); color: var(--c-text-3); font-weight: 600;
  }
  .recipe-step-arrow { font-size: 10px; color: var(--c-text-3); }
  .recipe-step-body { padding: 0 var(--sp-4) var(--sp-4); }
  .recipe-step-text { font-size: var(--fs-sm); color: var(--c-text-2); line-height: var(--lh-relaxed); }
  .recipe-step-tip {
    margin-top: var(--sp-2); font-size: var(--fs-sm); color: var(--c-accent-dark);
    font-weight: 600;
  }

  .nutrition-bars { padding: var(--sp-2) 0; }
  .nutrition-serving {
    font-size: var(--fs-sm); color: var(--c-text-3);
    margin-bottom: var(--sp-4); font-weight: 600;
  }
  .nutrition-item { margin-bottom: var(--sp-3); }
  .nutrition-header {
    display: flex; justify-content: space-between;
    margin-bottom: var(--sp-1);
  }
  .nutrition-label { font-size: var(--fs-sm); font-weight: 600; }
  .nutrition-value { font-size: var(--fs-sm); font-weight: 700; color: var(--c-text-1); }
  .nutrition-bar-track {
    height: 8px; background: var(--c-surface-2);
    border-radius: var(--r-full); overflow: hidden; border: 1px solid var(--c-border);
  }
  .nutrition-bar-fill {
    height: 100%; border-radius: var(--r-full);
    transition: width 1s var(--ease-out-expo);
  }

  .story-grid {
    display: grid; grid-template-columns: 1fr; gap: var(--sp-6);
  }
  @media (min-width: 1024px) {
    .story-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-10); }
  }
  .story-image-wrapper {
    overflow: hidden; border-radius: var(--r-xl);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    box-shadow: var(--sh-cartoon);
  }
  .story-img { width: 100%; height: auto; display: block; }
  .story-headline {
    font-family: var(--ff-display); font-size: var(--fs-xl);
    font-weight: 700; margin-bottom: var(--sp-4);
  }
  .story-text p {
    margin-bottom: var(--sp-3); line-height: var(--lh-relaxed);
    color: var(--c-text-2); font-size: var(--fs-sm);
  }
  .story-quote {
    margin: var(--sp-5) 0; padding: var(--sp-4);
    border-left: 4px solid var(--c-accent);
    background: var(--c-surface-2); border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: var(--fs-base); font-style: italic; color: var(--c-text-1);
  }

  .map-layout {
    display: grid; grid-template-columns: 1fr; gap: var(--sp-4);
  }
  @media (min-width: 1024px) {
    .map-layout { grid-template-columns: 2fr 1fr; }
  }
  .map-container {
    position: relative; height: 300px;
    border-radius: var(--r-xl); overflow: hidden;
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    box-shadow: var(--sh-cartoon);
    z-index: 1;
  }
  .leaflet-map { width: 100%; height: 100%; }
  .map-loading {
    position: absolute; inset: 0; display: flex;
    align-items: center; justify-content: center;
    background: var(--c-surface-2); font-size: var(--fs-lg); color: var(--c-text-3);
  }
  .location-list { display: flex; flex-direction: column; gap: var(--sp-3); }
  .location-card {
    display: flex; gap: var(--sp-3); padding: var(--sp-3);
    background: var(--c-surface);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    border-radius: var(--r-lg); box-shadow: var(--sh-1);
  }
  .location-icon { font-size: 20px; flex-shrink: 0; }
  .location-name { font-size: var(--fs-sm); font-weight: 700; margin-bottom: var(--sp-1); }
  .location-city { font-size: var(--fs-xs); color: var(--c-text-3); margin-bottom: var(--sp-1); }
  .location-desc { font-size: var(--fs-xs); color: var(--c-text-2); }
  .location-price {
    display: inline-block; margin-top: var(--sp-2); padding: 2px 8px;
    background: var(--c-surface-2); border-radius: var(--r-full);
    font-size: var(--fs-xs); font-weight: 700; border: 1px solid var(--c-border);
  }

  .related-carousel {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-3);
  }
  @media (min-width: 640px) {
    .related-carousel { grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  }
  @media (min-width: 1024px) {
    .related-carousel { grid-template-columns: repeat(4, 1fr); gap: var(--sp-4); }
  }
  .related-card {
    display: block; background: var(--c-surface);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    border-radius: var(--r-lg); overflow: hidden;
    transition: all var(--dur-base) var(--ease-bounce); box-shadow: var(--sh-1);
  }
  .related-card:hover {
    transform: translateY(-4px); box-shadow: var(--sh-cartoon);
  }
  .related-image { height: 130px; overflow: hidden; }
  @media (min-width: 768px) { .related-image { height: 150px; } }
  .related-image img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--dur-base) var(--ease-ui);
  }
  .related-card:hover .related-image img { transform: scale(1.05); }
  .related-info { padding: var(--sp-3); }
  .related-name { font-size: var(--fs-sm); font-weight: 700; margin-bottom: var(--sp-1); }
  .related-region { font-size: var(--fs-xs); color: var(--c-text-3); }
</style>
