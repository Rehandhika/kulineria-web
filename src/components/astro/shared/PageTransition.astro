---
/**
 * PageTransition - GSAP page transition wrapper (legacy, uses global queue)
 */
---

<script>
import { gsap } from 'gsap';

function animatePageEnter() {
  const elements = document.querySelectorAll('.page-enter');

  if (elements.length === 0) {
    gsap.fromTo('main > section',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'expo.out'
      }
    );
    return;
  }

  gsap.fromTo(elements,
    { opacity: 0, y: 30 },
    {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.08,
      ease: 'expo.out'
    }
  );
}

function triggerPageEnter() { setTimeout(animatePageEnter, 80); }

document.addEventListener('DOMContentLoaded', triggerPageEnter);
document.addEventListener('swup:page:view', triggerPageEnter);

window.__pageAnimate = window.__pageAnimate || [];
window.__pageAnimate.push(triggerPageEnter);
</script>

<slot />
