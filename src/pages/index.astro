---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';
import HeroSection from '../components/astro/home/HeroSection.astro';
import InteractiveMap from '../components/react/home/InteractiveMap';
import RegionBanner from '../components/react/home/RegionBanner';
import FeaturedFoodsGrid from '../components/react/home/FeaturedFoodsGrid';
import SectionHeader from '../components/astro/shared/SectionHeader.astro';
---

<BaseLayout title="Home" description="Discover the rich flavors of Indonesian cuisine through an interactive exploration of regional specialties">
  <HeroSection />

  <!-- INTERACTIVE MAP -->
  <section class="section-py map-section" id="map-section">
    <div class="container">
      <SectionHeader overline="🗺️ Interaktif" title="Jelajahi Nusantara" />
      <InteractiveMap client:visible />
      <RegionBanner client:idle />
    </div>
  </section>

  <FeaturedFoodsGrid client:visible />
  <Footer />
</BaseLayout>

<style is:global>
  .map-section {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-12);
  }

  @media (min-width: 768px) {
    .map-section {
      padding-top: var(--sp-16);
      padding-bottom: var(--sp-16);
    }
  }

  @media (min-width: 1024px) {
    .map-section {
      padding-top: var(--sp-20);
      padding-bottom: var(--sp-20);
    }
  }

  .interactive-map {
    width: 100%;
  }

  .map-container {
    position: relative;
    background: var(--c-surface);
    border-radius: var(--r-2xl);
    border: var(--duo-stroke) solid var(--duo-stroke-color);
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    cursor: pointer;
    box-shadow: 0 5px 0 var(--c-duo-shadow);
  }

  @media (min-width: 640px) {
    .map-container {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 768px) {
    .map-container {
      aspect-ratio: 2 / 1;
    }
  }

  .map-ocean-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #E0F2FE 0%, #DBEAFE 100%);
    background-image:
      linear-gradient(rgba(148, 196, 232, 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 196, 232, 0.3) 1px, transparent 1px);
    background-size: 8% 8%;
    z-index: 0;
  }

  .map-region-path {
    position: absolute;
    transition: transform 0.4s var(--ease-bounce),
                filter 0.4s ease, opacity 0.4s ease;
    pointer-events: auto;
  }

  .map-region-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .map-tooltip {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--c-text-1);
    color: #fff;
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 3px 0 rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 50;
    animation: fadeIn 0.15s ease;
  }

  .map-tooltip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .map-tooltip-count {
    font-weight: 600;
    opacity: 0.7;
    font-size: 0.85em;
  }
</style>
