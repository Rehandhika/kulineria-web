---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/astro/shared/Footer.astro';
import HeroManifesto from '../components/astro/about/HeroManifesto.astro';
import MissionSection from '../components/astro/about/MissionSection.astro';
import ValuesSection from '../components/astro/about/ValuesSection.astro';
import TeamSection from '../components/astro/about/TeamSection.astro';
import CTASection from '../components/astro/about/CTASection.astro';
import NaraOrigin from '../components/react/about/NaraOrigin.tsx';
import MapMoment from '../components/react/about/MapMoment.tsx';
import ScrollReveal from '../components/react/shared/ScrollReveal.tsx';
---

<BaseLayout title="About" description="About Kulineria - Indonesian Culinary Atlas">
  <main class="about-page">
    <div class="about-wrapper">
      <HeroManifesto />

      <ScrollReveal client:only="react" animation="fadeUp" delay="0.2">
        <MissionSection />
      </ScrollReveal>

      <ScrollReveal client:only="react" animation="scaleIn" delay="0.1">
        <NaraOrigin client:only="react" />
      </ScrollReveal>

      <ScrollReveal client:only="react" animation="fadeUp" delay="0.15">
        <MapMoment client:only="react" />
      </ScrollReveal>

      <ScrollReveal client:only="react" animation="fadeUp" delay="0.1">
        <ValuesSection />
      </ScrollReveal>

      <ScrollReveal client:only="react" animation="fadeUp" delay="0.1">
        <TeamSection />
      </ScrollReveal>

      <ScrollReveal client:only="react" animation="scaleIn" delay="0.15">
        <CTASection />
      </ScrollReveal>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .about-page {
    overflow: hidden;
  }

  .about-wrapper {
    width: 100%;
  }

  /* Hero Manifesto */
  .hero-manifesto {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: calc(var(--nav-mobile-h) + var(--sp-12)) var(--sp-4) var(--sp-12);
    background: linear-gradient(135deg, var(--c-cream) 0%, var(--c-bg) 50%, var(--c-surface-2) 100%);
  }

  @media (min-width: 768px) {
    .hero-manifesto {
      min-height: 100vh;
      padding: calc(var(--nav-h) + var(--sp-16)) var(--sp-4) var(--sp-16);
    }
  }

  .hero-manifesto-content {
    max-width: 100%;
    text-align: center;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .hero-manifesto-content {
      max-width: 900px;
    }
  }

  .hero-manifesto .overline {
    display: inline-block;
    padding: 6px 16px;
    background: var(--c-accent-light);
    color: var(--c-accent);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: var(--r-full);
    border: 1px solid var(--c-accent-soft);
    margin-bottom: var(--sp-4);
  }

  @media (min-width: 768px) {
    .hero-manifesto .overline {
      margin-bottom: var(--sp-6);
    }
  }

  .hero-manifesto .title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, var(--fs-hero));
    font-weight: 700;
    line-height: 1.1;
    color: var(--c-text-1);
    margin-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .hero-manifesto .title {
      margin-bottom: var(--sp-8);
    }
  }

  .hero-manifesto .word {
    display: inline-block;
    margin-right: 0.3em;
  }

  .hero-manifesto .accent {
    color: var(--c-accent);
    position: relative;
  }

  .hero-manifesto .accent::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: var(--c-accent-soft);
    border-radius: var(--r-full);
    z-index: -1;
  }

  .hero-manifesto .subtitle {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .hero-manifesto .subtitle {
      font-size: var(--fs-lg);
    }
  }

  .hero-manifesto-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, var(--c-accent-alpha) 0%, transparent 50%);
    pointer-events: none;
  }

  /* Mission Section */
  .mission-section {
    padding: var(--sp-12) var(--sp-4);
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .mission-section {
      padding: var(--sp-20) var(--sp-4);
      max-width: 1200px;
    }
  }

  .mission-step {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-bottom: var(--sp-12);
    align-items: center;
  }

  @media (min-width: 768px) {
    .mission-step {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-8);
      margin-bottom: var(--sp-20);
    }
    .mission-step.reverse {
      direction: rtl;
    }
    .mission-step.reverse > * {
      direction: ltr;
    }
  }

  .mission-text h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-3);
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .mission-text h2 {
      font-size: var(--fs-2xl);
      margin-bottom: var(--sp-4);
    }
  }

  .mission-text p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .mission-text p {
      font-size: var(--fs-base);
    }
  }

  .mission-image {
    display: flex;
    justify-content: center;
  }

  .image-placeholder {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 4 / 3;
    background: var(--c-surface-2);
    border-radius: var(--r-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-3xl);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    box-shadow: var(--sh-cartoon);
  }

  @media (min-width: 768px) {
    .image-placeholder {
      max-width: 400px;
      font-size: var(--fs-4xl);
    }
  }

  /* Nara Origin */
  .nara-origin {
    padding: var(--sp-12) var(--sp-4);
    max-width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  @media (min-width: 768px) {
    .nara-origin {
      padding: var(--sp-20) var(--sp-4);
      max-width: 800px;
    }
  }

  .nara-container {
    margin-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .nara-container {
      margin-bottom: var(--sp-8);
    }
  }

  .nara-svg {
    width: 150px;
    height: 150px;
    margin: 0 auto;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .nara-svg {
      width: 200px;
      height: 200px;
    }
  }

  .nara-speech {
    padding: var(--sp-5);
    background: var(--c-surface);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    border-radius: var(--r-xl);
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    box-shadow: var(--sh-1);
  }

  @media (min-width: 768px) {
    .nara-speech {
      padding: var(--sp-6);
      max-width: 600px;
    }
  }

  .nara-speech::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 20px;
    background: var(--c-surface);
    border-left: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    border-top: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    transform: translateX(-50%) rotate(45deg);
  }

  .nara-speech p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.7;
    font-style: italic;
  }

  @media (min-width: 768px) {
    .nara-speech p {
      font-size: var(--fs-lg);
    }
  }

  /* Map Moment */
  .map-moment {
    padding: var(--sp-12) var(--sp-4);
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .map-moment {
      padding: var(--sp-20) var(--sp-4);
      max-width: 1000px;
    }
  }

  .map-container {
    margin-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .map-container {
      margin-bottom: var(--sp-8);
    }
  }

  .map-svg {
    width: 100%;
    height: auto;
    border-radius: var(--r-xl);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    box-shadow: var(--sh-cartoon);
  }

  .map-marker {
    cursor: pointer;
    transition: transform 0.2s var(--ease-bounce);
  }

  .map-marker:hover {
    transform: scale(1.15);
  }

  .map-legend {
    text-align: center;
  }

  .map-legend h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  @media (min-width: 768px) {
    .map-legend h3 {
      font-size: var(--fs-xl);
    }
  }

  .map-legend p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .map-legend p {
      font-size: var(--fs-base);
    }
  }

  /* Values Section */
  .values-section {
    padding: var(--sp-12) var(--sp-4);
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .values-section {
      padding: var(--sp-20) var(--sp-4);
      max-width: 1200px;
    }
  }

  .values-header {
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 768px) {
    .values-header {
      margin-bottom: var(--sp-12);
    }
  }

  .values-header h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  @media (min-width: 768px) {
    .values-header h2 {
      font-size: var(--fs-2xl);
    }
  }

  .values-header p {
    font-size: var(--fs-base);
    color: var(--c-text-2);
  }

  @media (min-width: 768px) {
    .values-header p {
      font-size: var(--fs-lg);
    }
  }

  .values-scroll {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  @media (min-width: 480px) {
    .values-scroll {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (min-width: 1024px) {
    .values-scroll {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-6);
    }
  }

  .value-card {
    padding: var(--sp-6);
    background: var(--c-surface);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    border-radius: var(--r-xl);
    text-align: center;
    transition: all var(--dur-cartoon) var(--ease-bounce);
    box-shadow: var(--sh-1);
  }

  @media (min-width: 768px) {
    .value-card {
      padding: var(--sp-8);
    }
  }

  .value-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-4px);
    box-shadow: var(--sh-cartoon);
  }

  .value-icon {
    font-size: var(--fs-2xl);
    display: block;
    margin-bottom: var(--sp-3);
  }

  @media (min-width: 768px) {
    .value-icon {
      font-size: var(--fs-3xl);
      margin-bottom: var(--sp-4);
    }
  }

  .value-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  @media (min-width: 768px) {
    .value-card h3 {
      font-size: var(--fs-xl);
    }
  }

  .value-card p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .value-card p {
      font-size: var(--fs-base);
    }
  }

  /* Team Section */
  .team-section {
    padding: var(--sp-12) var(--sp-4);
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .team-section {
      padding: var(--sp-20) var(--sp-4);
      max-width: 1000px;
    }
  }

  .team-header {
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 768px) {
    .team-header {
      margin-bottom: var(--sp-12);
    }
  }

  .team-header h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  @media (min-width: 768px) {
    .team-header h2 {
      font-size: var(--fs-2xl);
    }
  }

  .team-header p {
    font-size: var(--fs-base);
    color: var(--c-text-2);
  }

  @media (min-width: 768px) {
    .team-header p {
      font-size: var(--fs-lg);
    }
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  @media (min-width: 480px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-6);
    }
  }

  .team-card {
    padding: var(--sp-6);
    background: var(--c-surface);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
    border-radius: var(--r-xl);
    text-align: center;
    transition: all var(--dur-cartoon) var(--ease-bounce);
    transform-style: preserve-3d;
    perspective: 1000px;
    box-shadow: var(--sh-1);
  }

  @media (min-width: 768px) {
    .team-card {
      padding: var(--sp-8);
    }
  }

  .team-card:hover {
    border-color: var(--c-accent);
    box-shadow: var(--sh-cartoon);
  }

  .team-photo {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--sp-3);
    background: var(--c-surface-2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-2xl);
    border: var(--cartoon-stroke) solid var(--cartoon-stroke-color);
  }

  @media (min-width: 768px) {
    .team-photo {
      width: 100px;
      height: 100px;
      margin: 0 auto var(--sp-4);
      font-size: var(--fs-3xl);
    }
  }

  .team-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-1);
  }

  @media (min-width: 768px) {
    .team-card h3 {
      font-size: var(--fs-xl);
    }
  }

  .team-role {
    font-size: var(--fs-xs);
    color: var(--c-accent);
    font-weight: 700;
    margin-bottom: var(--sp-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (min-width: 768px) {
    .team-role {
      font-size: var(--fs-sm);
    }
  }

  .team-bio {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .team-bio {
      font-size: var(--fs-base);
    }
  }

  /* CTA Section */
  .cta-section {
    padding: var(--sp-12) var(--sp-4);
    text-align: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--c-surface-2) 0%, var(--c-cream) 100%);
  }

  @media (min-width: 768px) {
    .cta-section {
      padding: var(--sp-20) var(--sp-4);
    }
  }

  .cta-content {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .cta-content {
      max-width: 600px;
    }
  }

  .cta-nara {
    margin-bottom: var(--sp-4);
  }

  @media (min-width: 768px) {
    .cta-nara {
      margin-bottom: var(--sp-6);
    }
  }

  .cta-nara-svg {
    width: 100px;
    height: 100px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .cta-nara-svg {
      width: 120px;
      height: 120px;
    }
  }

  .cta-section h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--c-text-1);
    margin-bottom: var(--sp-2);
  }

  @media (min-width: 768px) {
    .cta-section h2 {
      font-size: var(--fs-2xl);
    }
  }

  .cta-section p {
    font-size: var(--fs-base);
    color: var(--c-text-2);
    margin-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .cta-section p {
      font-size: var(--fs-lg);
      margin-bottom: var(--sp-8);
    }
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  @media (min-width: 768px) {
    .cta-actions {
      gap: var(--sp-4);
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    font-size: var(--fs-sm);
    font-weight: 600;
    border-radius: var(--r-full);
    transition: all var(--dur-base) var(--ease-ui);
    min-height: 44px;
  }

  @media (min-width: 768px) {
    .btn {
      padding: 12px 28px;
    }
  }

  .btn-primary {
    background: var(--c-text-1);
    color: #fff;
  }
  .btn-primary:hover { background: #2c2a27; transform: translateY(-1px); box-shadow: var(--sh-2); }

  .btn-secondary {
    background: transparent;
    color: var(--c-text-1);
    border: 1.5px solid var(--c-border);
  }
  .btn-secondary:hover { border-color: var(--c-text-1); background: var(--c-surface-2); }

  .cta-confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .confetti-piece {
    position: absolute;
    left: var(--x);
    top: -20px;
    width: 10px;
    height: 10px;
    background: var(--color);
    border-radius: 2px;
    animation: confetti-fall 4s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes confetti-fall {
    0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
    100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
  }
</style>
