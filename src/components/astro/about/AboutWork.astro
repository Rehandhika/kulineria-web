    <div class="work-list">
      <div class="work-item">
        <div class="work-divider">
          <span class="work-divider-line"></span>
          <span class="work-divider-label">━━ 01 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</span>
          <span class="work-divider-line"></span>
        </div>
        <div class="work-content">
          <h3 class="work-title">Mengumpulkan Resep Nusantara</h3>
          <p class="work-desc">
            Setiap daerah di Indonesia punya hidangan khas dengan cita rasa yang unik. Kulineria mengumpulkan dan menyusun resep-resep ini biar gampang dicari dan dikenal oleh siapa saja yang penasaran dengan kuliner Nusantara.
          </p>
        </div>
