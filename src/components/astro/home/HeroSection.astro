---
// Hero section — no data dependencies
---

<section class="hero" id="hero-section">
  <div class="hero-bg" aria-hidden="true"></div>

  <svg class="hero-noise-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="hero-noise-fx">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </defs>
    <rect width="100" height="100" filter="url(#hero-noise-fx)" opacity="0.04" style="mix-blend-mode: overlay"/>
  </svg>

  <!-- Decorative Floating Traditional Motifs -->
  <div class="hero-motif-container" aria-hidden="true">
    <img src="/img/motif/png awan.png" class="hero-motif hero-motif-left" alt="" />
    <img src="/img/motif/png batik mega mendung.png" class="hero-motif hero-motif-right" alt="" />
  </div>

  <div class="hero-inner">
    <span class="hero-label">Atlas Kuliner Nusantara</span>

    <h1 class="hero-title">
      <span class="hero-line hero-line-1">
        <span class="hero-word">Cita</span>
        <span class="hero-word">Rasa</span>
      </span>
      <span class="hero-line hero-line-2">
        <span class="hero-word">Nusantara</span>
      </span>
    </h1>

    <p class="hero-subtitle">
      Jelajahi hidangan khas dari seluruh Nusantara.
    </p>

    <a href="/jelajahi" class="hero-cta">
      <span>Mulai Jelajahi</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <div class="hero-scroll-indicator" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
  </div>

</section>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

function initHero() {
  const hero = document.getElementById('hero-section');
  if (!hero || hero.dataset.animated) return;
  hero.dataset.animated = 'true';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 640;

  if (reduced) {
    gsap.set(hero.querySelector('.hero-bg'), { scale: 1, opacity: 1 });
    gsap.set(hero.querySelector('.hero-noise-svg'), { opacity: 0.8 });
    gsap.set(hero.querySelector('.hero-label'), { y: 0, opacity: 1 });
    gsap.set(hero.querySelectorAll('.hero-word'), { y: 0, opacity: 1, filter: 'blur(0px)' });
    gsap.set(hero.querySelector('.hero-subtitle'), { y: 0, opacity: 1 });
    gsap.set(hero.querySelector('.hero-cta'), { y: 0, opacity: 1, scale: 1 });
    return;
  }

  const label = hero.querySelector('.hero-label');
  const words = hero.querySelectorAll('.hero-word');
  const subtitle = hero.querySelector('.hero-subtitle');
  const cta = hero.querySelector('.hero-cta');
  const bg = hero.querySelector('.hero-bg');
  const noise = hero.querySelector('.hero-noise-svg');

  const tl = gsap.timeline({ defaults: { ease: 'power4.out', overwrite: 'auto' } });

  tl.fromTo(bg, { scale: 1.08, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.5, ease: 'power2.out' }, 0)
    .fromTo(noise, { opacity: 0 }, { opacity: 0.8, duration: 2.5 }, 0)
    .fromTo(label, { y: -12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, 0.15)
    .fromTo(words, { y: 80, opacity: 0, filter: 'blur(15px)' }, {
      y: 0, opacity: 1, filter: 'blur(0px)', clearProps: 'filter,will-change', stagger: isMobile ? 0.06 : 0.1, duration: 1.3,
    }, 0.2)
    .fromTo(subtitle, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, '-=0.45')
    .fromTo(cta, { y: 24, opacity: 0, scale: 0.92 }, {
      y: 0, opacity: 1, scale: 1, duration: 0.8, ease: 'back.out(1.7)',
    }, '-=0.35');

  // Entrance staggered fade-ins for motifs
  tl.fromTo('.hero-motif-left', { x: -60, opacity: 0 }, { x: 0, opacity: 0.22, duration: 1.8, ease: 'power3.out' }, 0.4)
    .fromTo('.hero-motif-right', { x: 60, opacity: 0 }, { x: 0, opacity: 0.22, duration: 1.8, ease: 'power3.out' }, 0.4);

  // Parallax ScrollTriggers for motifs
  gsap.to('.hero-motif-left', {
    yPercent: -12,
    ease: 'none',
    scrollTrigger: {
      trigger: '#hero-section',
      start: 'top top',
      end: 'bottom top',
      scrub: true
    }
  });
  gsap.to('.hero-motif-right', {
    yPercent: 15,
    ease: 'none',
    scrollTrigger: {
      trigger: '#hero-section',
      start: 'top top',
      end: 'bottom top',
      scrub: true
    }
  });
}

/* ─── SINKRONISASI DENGAN TRANSISI HALAMAN ─────────────────────────────
 *
 * DOMContentLoaded  → load awal (bukan navigasi Swup)
 * kulineria:page:ready → navigasi Swup: dispatch tepat di animation:in:start,
 *   setelah DOM swap + 1 rAF browser paint — sudah deterministik, tidak
 *   perlu setTimeout. dataset.animated di-reset oleh Swup (DOM baru dibuat).
 * ────────────────────────────────────────────────────────────────────── */

  import { runOnPageReady, magneticButton } from '../../../lib/animations/gsap-presets';
  runOnPageReady(() => {
    initHero();
    const cta = document.querySelector('.hero-cta');
    if (cta instanceof HTMLElement) {
      magneticButton(cta);
    }
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-mobile-h) + var(--sp-8)) var(--page-px) var(--sp-8);
  }
  @media (min-width: 768px) {
    .hero { padding: calc(var(--nav-h) + var(--sp-12)) var(--page-px) var(--sp-12); }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      var(--c-brand-mocha-dark) 0%,
      var(--c-brand-mocha) 40%,
      #6B4A2E 70%,
      var(--c-brand-caramel-dark) 100%
    );
    will-change: transform, opacity;
    opacity: 0;
  }

  .hero-noise-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 780px;
  }

  .hero-label {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-brand-caramel);
    margin-bottom: var(--sp-6);
    opacity: 0;
  }

  .hero-title {
    font-family: var(--ff-display);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--sp-5);
  }
  .hero-line { display: block; }
  .hero-line-1 {
    font-size: clamp(2.8rem, 10vw, 6rem);
    margin-bottom: -0.08em;
  }
  .hero-line-2 {
    font-size: clamp(3.2rem, 12vw, 7rem);
  }
  .hero-line-2 .hero-word {
    background: var(--grad-warm);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .hero-word {
    display: inline-block;
    will-change: transform, opacity, filter;
    opacity: 0;
  }

  .hero-subtitle {
    font-family: var(--ff-body);
    font-size: clamp(var(--fs-base), 2vw, var(--fs-lg));
    color: rgba(255, 248, 240, 0.75);
    font-weight: 400;
    line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-8);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 14px 36px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--c-brand-caramel);
    color: var(--c-brand-cream);
    font-family: var(--ff-body);
    font-size: var(--fs-base);
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, color 160ms ease;
    cursor: pointer;
    will-change: transform;
    opacity: 0;
  }
  .hero-cta svg {
    transition: transform 0.3s var(--ease-smooth);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-cta:hover {
      background: var(--c-brand-caramel);
      color: var(--c-brand-mocha-dark);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(196, 154, 110, 0.25);
    }
    .hero-cta:hover svg {
      transform: translateX(4px);
    }
  }
  .hero-cta:active {
    transform: scale(0.97) !important;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: var(--sp-6);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 248, 240, 0.25);
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    animation: heroFadeIn 1s ease 2s forwards;
  }

  .hero-scroll-indicator svg {
    display: block;
    animation: heroScrollBounce 2.4s ease-in-out infinite;
  }

  @keyframes heroScrollBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @keyframes heroFadeIn {
    to { opacity: 1; }
  }

  @media (max-width: 767px) {
    .hero-label { font-size: var(--fs-xs); }
    .hero-scroll-indicator { display: none; }
  }

  /* Decorative Floating Traditional Motifs */
  .hero-motif-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }
  .hero-motif {
    position: absolute;
    opacity: 0; /* Animated to 0.12 on load */
    filter: brightness(0.95) contrast(1.1) sepia(0.65) saturate(0.3) hue-rotate(340deg);
    will-change: transform;
  }
  .hero-motif-left {
    top: 10%;
    left: -40px;
    width: clamp(140px, 20vw, 240px);
    transform: rotate(15deg);
  }
  .hero-motif-right {
    top: 15%;
    right: -50px;
    width: clamp(160px, 25vw, 280px);
    transform: rotate(-10deg);
  }
  @media (max-width: 640px) {
    .hero-motif-left {
      top: 5%;
      left: -60px;
      width: 120px;
    }
    .hero-motif-right {
      top: 8%;
      right: -70px;
      width: 140px;
    }
  }
</style>
