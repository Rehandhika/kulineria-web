---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Beranda', key: 'home' },
  { href: '/jelajahi', label: 'Jelajahi', key: 'jelajahi' },
  { href: '/kuis', label: 'Kuis', key: 'kuis' },
  { href: '/tentang', label: 'Tentang', key: 'tentang' },
];
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
const icons: Record<string, string> = {
  home: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  jelajahi: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
  kuis: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>',
  tentang: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="M8 7h8"/><path d="M8 11h6"/></svg>',
};
---

<nav class="bottom-nav" role="navigation" aria-label="Mobile navigation">
  <div class="bottom-nav-inner">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={['bottom-nav-item', { active: isActive(item.href) }]}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        <span class="bottom-nav-icon" aria-hidden="true" set:html={icons[item.key]}></span>
        <span class="bottom-nav-label">{item.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: block;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  @media (min-width: 1024px) { .bottom-nav { display: none; } }

  .bottom-nav-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    height: var(--nav-mobile-h);
    min-height: 56px;
    background: var(--c-cream-bar);
    border-top: 1px solid var(--c-border-soft);
    box-shadow: 0 -4px 16px rgba(60, 42, 30, 0.08);
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex: 1;
    min-width: 64px;
    min-height: 48px;
    color: var(--c-ink-mute);
    font-family: var(--ff-ui-system);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.12s var(--ease-bounce), transform 0.12s var(--ease-bounce);
    position: relative;
    padding-top: 4px;
  }

  .bottom-nav-icon {
    display: flex;
    transition: transform 0.12s var(--ease-bounce);
  }

  .bottom-nav-item.active {
    color: var(--c-nav-accent);
  }
  .bottom-nav-item.active .bottom-nav-icon {
    transform: scale(1.15);
  }
  .bottom-nav-item.active::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 3px;
    background: var(--c-nav-accent);
    border-radius: 0 0 var(--r-full) var(--r-full);
  }

  @media (hover: hover) and (pointer: fine) {
    .bottom-nav-item:hover {
      color: var(--c-ink);
    }
  }
  .bottom-nav-item:active .bottom-nav-icon {
    transform: scale(0.9);
  }
</style>
