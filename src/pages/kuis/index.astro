---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizProvider from '../../components/react/quiz/QuizProvider';
import Footer from '../../components/astro/shared/Footer.astro';
---

<BaseLayout title="Quiz" description="Test your Indonesian culinary knowledge">
  <div class="quiz-page-wrapper">
    <QuizProvider client:only="react" />
  </div>
  <Footer id="quiz-footer" />
</BaseLayout>

<style is:global>
  /* Clean structural page wrapper sitting on natural parchment background */
  .quiz-page-wrapper {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 0;
  }
</style>
