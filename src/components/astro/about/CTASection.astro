---
---

<section class="cta-section">
  <div class="cta-content">
    <div class="cta-nara">
      <svg viewBox="0 0 100 100" class="cta-nara-svg">
        <circle cx="50" cy="50" r="45" fill="var(--c-accent)" opacity="0.1" />
        <circle cx="50" cy="50" r="25" fill="var(--c-surface-1)" stroke="var(--c-accent)" stroke-width="2" />
        <path d="M 30 30 Q 35 25 40 30 M 60 30 Q 65 25 70 30" fill="none" stroke="var(--c-text-1)" stroke-width="2" stroke-linecap="round" />
        <path d="M 30 40 Q 50 58 70 40" fill="none" stroke="var(--c-text-1)" stroke-width="2" stroke-linecap="round" />
        <circle cx="30" cy="40" r="3" fill="var(--c-accent)" opacity="0.3" />
        <circle cx="70" cy="40" r="3" fill="var(--c-accent)" opacity="0.3" />
      </svg>
    </div>
    <h2>Siap Menjelajah?</h2>
    <p>Temukan ragam cita rasa Nusantara atau uji pengetahuan kuliner kamu</p>
    <div class="cta-actions">
      <a href="/search" class="btn btn-primary">Mulai Jelajahi</a>
      <a href="/quiz" class="btn btn-secondary">Ikuti Kuis</a>
    </div>
  </div>
  <div class="cta-confetti">
    <span class="confetti-piece" style="--delay: 0s; --x: 10%; --color: var(--c-accent);"></span>
    <span class="confetti-piece" style="--delay: 0.5s; --x: 25%; --color: var(--c-warning);"></span>
    <span class="confetti-piece" style="--delay: 1s; --x: 40%; --color: var(--c-success);"></span>
    <span class="confetti-piece" style="--delay: 1.5s; --x: 55%; --color: var(--c-accent);"></span>
    <span class="confetti-piece" style="--delay: 2s; --x: 70%; --color: var(--c-warning);"></span>
    <span class="confetti-piece" style="--delay: 2.5s; --x: 85%; --color: var(--c-success);"></span>
  </div>
</section>